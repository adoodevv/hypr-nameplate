# Notifications (mako) - Tokyo Night
font=JetBrainsMono Nerd Font 11
background-color=#1a1b26ee
text-color=#a9b1d6
border-color=#7aa2f7
border-size=2
border-radius=0
padding=12
margin=12
width=380
height=140
anchor=top-right
default-timeout=5000
max-visible=4

[urgency=critical]
border-color=#f7768e
default-timeout=0

# Volume / brightness level indicator (bin/osd)
[app-name=nameplate-osd]
default-timeout=1500
width=260
padding=8
text-color=#c0caf5
progress-color=over #7aa2f73a
border-color=#7aa2f7

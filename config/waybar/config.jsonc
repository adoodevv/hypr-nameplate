// Top bar (waybar). Restart after edits: pkill waybar; waybar &
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "modules-left": [
    "custom/logo",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "group/datetime"
  ],
  "modules-right": [
    "tray",
    "bluetooth",
    "network",
    "custom/sound",
    "battery",
    "custom/power"
  ],
  "custom/logo": {
    "format": "@NAME@",
    "tooltip-format": "App launcher (Super + Space)",
    "on-click": "pkill fuzzel || fuzzel"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    }
  },
  "clock": {
    "format": "{:%a %d %b   %H:%M}",
    "interval": 1,
    "on-click": "~/.config/nameplate/bin/panel calendar",
    "tooltip": false
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/.config/nameplate/bin/panel bluetooth",
    "on-click-right": "XDG_CURRENT_DESKTOP=GNOME gnome-control-center bluetooth"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Not connected. Click to pick a network",
    "interval": 5,
    "on-click": "~/.config/nameplate/bin/panel wifi",
    "on-click-right": "alacritty --class nameplate-float --title Network -e ~/.config/nameplate/bin/wifi edit",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-linked": "󰤫",
    "format-disabled": "󰖪",
    "tooltip-format-disabled": "Wi-Fi is off. Click to turn it on"
  },
  "battery": {
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "states": {
      "warning": 25,
      "critical": 10
    },
    "interval": 30,
    "tooltip-format": "{capacity}%  ·  {timeTo}",
    "on-click": "~/.config/nameplate/bin/panel power"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu (Super + Escape)",
    "on-click": "~/.config/nameplate/bin/power-menu"
  },
  "custom/media": {
    "exec": "~/.config/nameplate/bin/media-status",
    "return-type": "json",
    "format": "{}",
    "escape": true,
    "max-length": 4,
    "on-click": "~/.config/nameplate/bin/panel calendar",
    "on-click-right": "playerctl play-pause"
  },
  "custom/sound": {
    "exec": "~/.config/nameplate/bin/sound-status",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "format": "{}",
    "on-click": "~/.config/nameplate/bin/panel sound",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; pkill -RTMIN+9 waybar",
    "on-click-middle": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+; pkill -RTMIN+9 waybar",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; pkill -RTMIN+9 waybar"
  },
  "group/datetime": {
    "orientation": "inherit",
    "modules": [
      "clock",
      "custom/media"
    ]
  }
}

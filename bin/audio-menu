#!/bin/bash
# Audio dropdown (click the volume icon in the bar): choose the output, mute, open the mixer.
# Scrolling on the icon still changes the volume.
pkill -x fuzzel && exit 0   # clicking the icon again closes the menu
bin="$HOME/.config/nameplate/bin"

I_SPK='󰓃'; I_HP='󰋋'; I_MUTE='󰖁'; I_VOL='󰕾'
I_CHECK='󰄬'; I_MIX='󰙪'

default=$(pactl get-default-sink 2>/dev/null)
vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -1)
muted=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')

menu=()
declare -A sink_of sink_desc
# "name<TAB>description" for every output
while IFS=$'\t' read -r name desc; do
  [[ -z $name ]] && continue
  icon="$I_SPK"; [[ ${desc,,} == *headphone* || ${desc,,} == *headset* || ${name,,} == *bluez* ]] && icon="$I_HP"
  mark=" "; [[ $name == "$default" ]] && mark="$I_CHECK"
  line="$icon  $desc  $mark"
  menu+=("$line")
  sink_of["$line"]="$name"
  sink_desc["$name"]="$desc"
done < <(pactl list sinks 2>/dev/null | awk '
  /^\tName: /        { name=substr($0, index($0, ":")+2) }
  /^\tDescription: / { print name "\t" substr($0, index($0, ":")+2) }')

if [[ $muted == yes ]]; then
  extras=("$I_VOL  Unmute  (volume ${vol:-?})")
else
  extras=("$I_MUTE  Mute  (volume ${vol:-?})")
fi
extras+=("$I_MIX  Open mixer")

choice=$(printf '%s\n' "${menu[@]}" "${extras[@]}" | "$bin/dropdown" "audio")
[[ -z $choice ]] && exit 0

case "$choice" in
  *"  Mute  ("*|*"  Unmute  ("*) pactl set-sink-mute @DEFAULT_SINK@ toggle; exit 0 ;;
  *"  Open mixer") exec pavucontrol ;;
esac

sink="${sink_of[$choice]:-}"
[[ -z $sink || $sink == "$default" ]] && exit 0
pactl set-default-sink "$sink"
# Move whatever is already playing to the new output too
pactl list short sink-inputs 2>/dev/null | cut -f1 | while read -r id; do
  pactl move-sink-input "$id" "$sink" 2>/dev/null
done
desc="${sink_desc[$sink]}"
notify-send -a "Audio" "Output: $desc"

#!/bin/bash
# Volume and brightness as one bar item (Waybar custom module, JSON output).
# Refreshed every few seconds, and at once by the volume/brightness keys (signal 9).
raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
vol=$(awk '{ printf "%d", $2 * 100 + 0.5 }' <<<"$raw")
if [[ $raw == *MUTED* ]]; then
  vicon='󰝟'; vtext="Volume: muted (${vol}%)"; cls=muted
elif [[ -z $raw ]]; then
  vicon='󰕾'; vtext="Volume: unavailable"; cls=""
else
  if (( vol >= 66 )); then vicon='󰕾'; elif (( vol >= 33 )); then vicon='󰖀'; else vicon='󰕿'; fi
  vtext="Volume: ${vol}%"; cls=""
fi
bright=$(brightnessctl -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; exit }')
if [[ -n $bright ]]; then
  text="$vicon  󰃠"; tip="$vtext\nBrightness: ${bright}%\nClick for sliders, scroll for volume"
else
  text="$vicon"; tip="$vtext\nClick for sliders, scroll for volume"
fi
printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "$tip" "$cls"

#!/usr/bin/python3
"""Weather for the bar (after the clock), from wttr.in: free, no account needed.

    weather                 the bar item (JSON); fetches at most every 15 minutes
    weather refresh         fetch now
    weather data            the cached forecast as JSON (for the weather panel)
    weather location CITY   use a city instead of guessing from your internet address
    weather location        back to automatic

wttr.in guesses where you are from your internet address unless you set a city.
"""
import json
import os
import sys
import time
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".cache", "nameplate", "weather.json")
LOCATION = os.path.join(HOME, ".config", "nameplate", "weather-location")
OPEN_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "nameplate-panel-open")
FRESH = 15 * 60          # seconds before fetching again
KEEP = 3 * 3600          # show an old reading this long if the internet is down

# wttr.in (WorldWeatherOnline) condition codes -> (day icon, night icon).
# Omarchy's set: the Nerd Font weather icons (nf-weather).
ICONS = {113: ("\ue30d", "\ue32b"), 116: ("\ue302", "\ue32e"),
         143: ("\ue313", "\ue346"), 248: ("\ue313", "\ue346"), 260: ("\ue313", "\ue346")}
for codes, day, night in (((176, 263, 353), "\ue308", "\ue333"),
                          ((179, 227, 230, 323, 326, 368), "\ue30a", "\ue327")):
    for code in codes:
        ICONS[code] = (day, night)
for codes, glyph in (((119, 122), "\ue33d"),
                     ((182, 185, 281, 284, 311, 314, 317, 320, 350, 362, 365, 374, 377), "\ue3ad"),
                     ((200, 386, 389, 392, 395), "\ue31d"),
                     ((266, 293, 296, 299, 302, 305, 308, 356, 359), "\ue318"),
                     ((329, 332, 335, 338, 371), "\ue31a")):
    for code in codes:
        ICONS[code] = (glyph, glyph)
CLOUDY = "\ue33d"


def icon(code, hour=None):
    if hour is None:
        hour = time.localtime().tm_hour
    day, night = ICONS.get(int(code or 0), (CLOUDY, CLOUDY))
    return night if hour < 6 or hour >= 18 else day


def location():
    try:
        with open(LOCATION) as f:
            return f.read().strip()
    except OSError:
        return ""


def cached():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def fetch():
    url = "https://wttr.in/%s?format=j1" % urllib.parse.quote(location())
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8 (hypr-nameplate)"})
    with urllib.request.urlopen(req, timeout=15) as r:
        data = json.load(r)
    if not data.get("current_condition"):
        raise ValueError("no current conditions")
    entry = {"fetched": time.time(), "location": location(), "data": data}
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entry, f)
    os.replace(tmp, CACHE)
    return entry


def get(force=False):
    entry = cached()
    stale = (not entry or force or time.time() - entry.get("fetched", 0) > FRESH
             or entry.get("location", "") != location())
    if stale:
        try:
            entry = fetch()
        except Exception:          # offline: keep showing the last reading for a while
            if entry and time.time() - entry.get("fetched", 0) > KEEP:
                entry = None
    return entry


def bar(entry):
    if not entry:
        print("")                  # nothing to show: the item hides
        return
    now = entry["data"]["current_condition"][0]
    classes = []
    try:
        with open(OPEN_FILE) as f:
            if f.read().split()[:1] == ["weather"]:
                classes.append("open")
    except OSError:
        pass
    # Like Omarchy: just the icon in the bar; the temperature is in the panel
    print(json.dumps({"text": icon(now.get("weatherCode")),
                      "tooltip": now.get("weatherDesc", [{}])[0].get("value", ""),
                      "class": classes}, ensure_ascii=False))


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "":
        bar(get())
    elif cmd == "refresh":
        bar(get(force=True))
    elif cmd == "data":
        print(json.dumps(get(force="--refresh" in args) or {}))
    elif cmd == "location":
        city = " ".join(args[1:]).strip()
        os.makedirs(os.path.dirname(LOCATION), exist_ok=True)
        if city:
            with open(LOCATION, "w") as f:
                f.write(city + "\n")
        else:
            try:
                os.remove(LOCATION)
            except OSError:
                pass
        get(force=True)
        os.system("pkill -RTMIN+16 -x waybar")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()

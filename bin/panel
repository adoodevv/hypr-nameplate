#!/usr/bin/python3
"""hypr-nameplate panels: small popups that open under the top bar.

    panel calendar | media | sound | wifi | bluetooth | display

Clicking anywhere outside a panel, or pressing Escape, closes it. Clicking the same
bar icon again closes it too; clicking a different icon switches panels.

Uses the system Python on purpose (/usr/bin/python3): it has the GTK bindings, while a
conda or virtualenv python3 earlier in PATH usually does not.
"""
import datetime
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell  # noqa: E402
except (ValueError, ImportError):
    GtkLayerShell = None

RUN = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
PIDFILE = os.path.join(RUN, "nameplate-panel.pid")
BIN = os.path.expanduser("~/.config/nameplate/bin")
PANELS = ("calendar", "media", "sound", "wifi", "bluetooth", "display", "power", "wallpapers",
          "clipboard", "emoji", "menu", "themes")


def g(code):
    return chr(code)



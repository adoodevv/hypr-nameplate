    "😱": "scared shock scream", "😴": "sleep tired", "🙏": "please thanks pray thank you", "👏": "clap applause well done",
    "🙌": "praise celebrate hooray", "👍": "yes ok good like approve", "👎": "no bad dislike", "👌": "ok perfect",
    "💪": "strong muscle flex", "🎉": "party celebrate congrats tada", "🥳": "party celebrate birthday",
    "🔥": "fire lit hot", "✨": "sparkle magic new", "💯": "hundred perfect score", "✅": "done check yes tick",
    "❌": "no wrong cross x", "⚡": "fast lightning power", "🚀": "launch ship fast rocket", "💡": "idea tip bulb",
    "🤖": "robot bot ai", "💻": "laptop computer code", "🐛": "bug", "🎂": "birthday cake", "🙄": "eye roll whatever",
    "😬": "awkward grimace yikes", "🤝": "deal handshake agree", "👋": "hi hello bye wave", "🤗": "hug",
    "😇": "angel innocent", "🤯": "mind blown wow", "😮": "wow surprised", "🥺": "please pleading puppy",
}


def emoji_list():
    """Every single-character emoji the Noto Color Emoji font can draw, with names."""
    import unicodedata
    charset = out("fc-match", "-f", "%{charset}", "Noto Color Emoji", timeout=5)
    have = set()
    for part in charset.split():
        lo, _, hi = part.partition("-")
        try:
            have.update(range(int(lo, 16), int(hi or lo, 16) + 1))
        except ValueError:
            pass
    ranges = [(0x1F600, 0x1F64F), (0x1F910, 0x1F9FF), (0x1F44A, 0x1F4FF), (0x1F300, 0x1F449),
              (0x1F500, 0x1F5FF), (0x1F680, 0x1F6FF), (0x1FA70, 0x1FAFF), (0x2600, 0x27BF),
              (0x2B00, 0x2BFF)]
    result = []
    for lo, hi in ranges:
        for cp in range(lo, hi + 1):
            if have and cp not in have:
                continue
            try:
                name = unicodedata.name(chr(cp)).lower()
            except ValueError:
                continue
            if unicodedata.category(chr(cp)) != "So":
                continue
            ch = chr(cp) + ("\ufe0f" if cp < 0x1F000 else "")   # ask for the colour version
            result.append((ch, name))
    words = {k.replace("\ufe0f", ""): v for k, v in EMOJI_WORDS.items()}
    return [(ch, f"{name} {words.get(ch.replace(chr(0xFE0F), ''), '')}".strip()) for ch, name in result]


class EmojiPanel(Panel):
    """Emoji picker (SUPER + CTRL + E). Click one to copy it."""
    width = 440
    anchor = "middle"
    RECENT = os.path.expanduser("~/.cache/nameplate/emoji-recent")
    SHOW = 280

    def __init__(self, app):
        super().__init__(app)
        self.box.pack_start(label("Emoji", "np-title"), False, False, 0)
        self.search = Gtk.SearchEntry()
        self.search.get_style_context().add_class("np-search")
        self.search.set_placeholder_text("Search, e.g. heart, fire, laugh")
        self.search.connect("search-changed", lambda *_: self.fill())
        self.search.connect("activate", lambda *_: self.pick_first())
        self.box.pack_start(self.search, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(320)
        self.flow = Gtk.FlowBox()
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_max_children_per_line(10)
        self.flow.set_min_children_per_line(10)
        self.flow.set_homogeneous(True)
        scroll.add(self.flow)
        self.box.pack_start(scroll, True, True, 0)
        self.hint = label("Click to copy, then paste with Ctrl+V", "np-dim", xalign=0.5)
        self.box.pack_start(self.hint, False, False, 0)
        self.all = emoji_list()
        try:
            with open(self.RECENT, encoding="utf-8") as f:
                self.recent = [l.rstrip("\n") for l in f if l.strip()][:20]
        except OSError:
            self.recent = []
        self.matches = []
        self.fill()

    def shown(self):
        self.search.grab_focus()

    def fill(self):
        for c in self.flow.get_children():
            self.flow.remove(c)
        query = self.search.get_text().lower().strip()
        if query:
            words = query.split()
            # each search word must start a word in the name: "love" finds love, not "glove"
            self.matches = [ch for ch, name in self.all
                            if all(any(nw.startswith(w) for nw in name.split()) for w in words)]
        else:
            names = {ch for ch, _ in self.all}
            self.matches = [ch for ch in self.recent if ch in names] + \
                [ch for ch, _ in self.all if ch not in self.recent]
        names = dict(self.all)
        for ch in self.matches[:self.SHOW]:
            b = Gtk.Button(label=ch)
            b.get_style_context().add_class("np-emoji")
            b.set_tooltip_text(names.get(ch, ""))
            b.connect("clicked", lambda _b, c=ch: self.pick(c))
            self.flow.add(b)
        self.flow.show_all()
        if not self.matches:
            self.hint.set_text("No matches.")
        else:
            self.hint.set_text("Click to copy, then paste with Ctrl+V")

    def pick_first(self):
        if self.matches:
            self.pick(self.matches[0])

    def pick(self, ch):
        try:
            subprocess.run(["wl-copy"], input=ch.encode(), timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            return
        recent = [ch] + [c for c in self.recent if c != ch]
        os.makedirs(os.path.dirname(self.RECENT), exist_ok=True)
        with open(self.RECENT, "w", encoding="utf-8") as f:
            f.write("\n".join(recent[:20]) + "\n")
        spawn("notify-send", "-a", "Emoji", "-t", "1500", f"Copied {ch}  Paste with Ctrl+V")
        self.close()

class ThemePanel(Panel):
    """Colour themes (SUPER + CTRL + SHIFT + SPACE), Omarchy's palettes. Click one to switch."""
    width = 640
    anchor = "middle"
    CARD_W, CARD_H = 146, 86

    def __init__(self, app):
        super().__init__(app)
        self.providers = []
        head = hbox()
        head.pack_start(label("Themes", "np-title"), True, True, 0)
        self.box.pack_start(head, False, False, 0)
        listing = out(f"{BIN}/theme", "list", timeout=10).splitlines()
        self.names = [n.lstrip("* ").strip() for n in listing if n.strip()]   # "* " marks the current one
        self.now = next((n.lstrip("* ").strip() for n in listing if n.startswith("*")), None)
        if not self.names:
            self.box.pack_start(label("No themes found. Run the installer again.", "np-dim"), False, False, 6)
            return
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(4)
        flow.set_min_children_per_line(4)
        flow.set_homogeneous(True)
        flow.set_row_spacing(6)
        flow.set_column_spacing(6)
        themes = os.path.expanduser("~/.config/nameplate/themes")
        for name in self.names:
            b = Gtk.Button()
            b.get_style_context().add_class("np-thumb")
            if name == self.now:
                b.get_style_context().add_class("np-current")
            path = os.path.join(themes, name + ".toml")
            if not os.path.exists(path):
                path = os.path.join(os.path.dirname(themes), "user-themes", name + ".toml")
            b.add(self.card(name, self.palette(path)))
            b.connect("clicked", lambda *_, n=name: self.choose(n))
            flow.add(b)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(min(470, 96 * math.ceil(len(self.names) / 4)))
        scroll.add(flow)
        self.box.pack_start(scroll, True, True, 0)
        self.status = label("Click to apply. Wallpapers change too if you downloaded Omarchy's collection.",
                            "np-dim", xalign=0.5)
        self.box.pack_start(self.status, False, False, 0)

    @staticmethod
    def palette(path):
        c = {}
        try:
            with open(path) as f:
                for line in f:
                    m = re.match(r'\s*(\w+)\s*=\s*"(#[0-9a-fA-F]{6})"', line)
                    if m:
                        c[m.group(1)] = m.group(2)
        except OSError:
            pass
        return c

    @staticmethod
    def pretty(name):
        special = {"rose-pine": "Rosé Pine", "retro-82": "Retro 82"}
        return special.get(name, name.replace("-", " ").title())

    DOTS = ("red", "yellow", "green", "cyan", "blue", "magenta")

    def cleanup(self):
        for css in self.providers:      # the process stays running, so don't let them pile up
            Gtk.StyleContext.remove_provider_for_screen(Gdk.Screen.get_default(), css)

    def card(self, name, c):
        """A small preview in the theme's own colours: its name and six colour dots."""
        wid = "np-theme-" + re.sub(r"\W", "-", name)
        rules = ["#%s { background-color: %s; border-top: 4px solid %s; padding: 10px 10px 8px 10px; }"
                 % (wid, c.get("background", "#808080"), c.get("accent", "#808080")),
                 "#%s label { color: %s; font-weight: bold; }" % (wid, c.get("foreground", "#808080"))]
        rules += ["#%s label.np-dot%d { color: %s; font-size: 15pt; font-weight: normal; }"
                  % (wid, i, c.get(key, "#808080")) for i, key in enumerate(self.DOTS)]
        css = Gtk.CssProvider()
        css.load_from_data("\n".join(rules).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        self.providers.append(css)
        box = vbox(10)
        box.set_name(wid)
        box.set_size_request(self.CARD_W, self.CARD_H)
        box.pack_start(label(self.pretty(name), ellipsize=True, width=16), False, False, 0)
        dots = hbox(4)
        for i in range(len(self.DOTS)):
            dots.pack_start(label(g(0xF0765), "np-dot%d" % i), False, False, 0)   # filled circle
        box.pack_end(dots, False, False, 0)
        return box

    def choose(self, name):
        self.status.set_text("Applying %s..." % self.pretty(name))

        def done(_result):
            self.close()                      # reopen, so the panel itself wears the new colours
            if DAEMON:
                install_css()
            open_panel("themes")
        in_background(lambda: run(f"{BIN}/theme", "set", name, timeout=30), done)

# ----------------------------------------------------------------- weather --

def weather_module():
    """bin/weather, loaded as a module (icons, cache) so there's one copy of the logic."""
    import importlib.machinery
    import importlib.util
    path = os.path.join(BIN, "weather")
    loader = importlib.machinery.SourceFileLoader("nameplate_weather", path)
    spec = importlib.util.spec_from_loader("nameplate_weather", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class WeatherPanel(Panel):
    """Click the weather after the clock: now, the next hours, the next days, and the place."""
    width = 380
    anchor = "center"

    def __init__(self, app):
        super().__init__(app)
        self.wx = weather_module()
        head = hbox()
        self.place = label("Weather", "np-title", ellipsize=True, width=34)
        head.pack_start(self.place, True, True, 0)
        head.pack_end(icon_button(I["refresh"], lambda: self.load(force=True), tooltip="Refresh"),
                      False, False, 0)
        self.box.pack_start(head, False, False, 0)
        self.body = vbox(8)
        self.box.pack_start(self.body, False, False, 0)

        self.box.pack_start(Gtk.Separator(), False, False, 2)
        where = hbox(6)
        self.city = Gtk.Entry()
        self.city.set_placeholder_text("Your city (blank: automatic). Press Enter")
        self.city.set_text(self.wx.location())
        self.city.connect("activate", lambda *_: self.set_city())
        where.pack_start(self.city, True, True, 0)
        self.box.pack_start(where, False, False, 0)

        entry = self.wx.cached()
        if entry:
            self.show(entry)
        else:
            self.body.pack_start(label("Getting the weather…", "np-dim"), False, False, 6)
        self.load(force=False)

    def load(self, force):
        in_background(lambda: self.wx.get(force=force), self.show)

    def set_city(self):
        city = self.city.get_text().strip()
        clear(self.body)
        self.body.pack_start(label("Getting the weather for %s…" % (city or "where you are"), "np-dim"),
                             False, False, 6)
        self.body.show_all()

        def work():
            run(os.path.join(BIN, "weather"), "location", *([city] if city else []), timeout=30)
            return self.wx.cached()
        in_background(work, self.show)

    def show(self, entry):
        clear(self.body)
        if not entry:
            self.body.pack_start(label("Couldn't get the weather. Check your internet connection.",
                                       "np-dim"), False, False, 6)
            self.body.show_all()
            return
        d = entry["data"]
        now = d["current_condition"][0]
        try:
            area = d["nearest_area"][0]
            self.place.set_text("%s, %s" % (area["areaName"][0]["value"], area["country"][0]["value"]))
        except (KeyError, IndexError):
            self.place.set_text("Weather")

        top = hbox(14)
        top.pack_start(label(self.wx.icon(now.get("weatherCode")), "np-huge"), False, False, 0)
        top.pack_start(label("%s°" % now.get("temp_C", "?"), "np-huge"), False, False, 0)
        desc = vbox(2)
        desc.pack_start(label(now.get("weatherDesc", [{}])[0].get("value", "")), False, False, 0)
        desc.pack_start(label("Feels like %s°" % now.get("FeelsLikeC", "?"), "np-dim"), False, False, 0)
        top.pack_start(desc, False, False, 0)
        self.body.pack_start(top, False, False, 0)
        self.body.pack_start(label("%s %s%%   %s %s km/h %s" % (
            g(0xF058E), now.get("humidity", "?"), g(0xF059D), now.get("windspeedKmph", "?"),
            now.get("winddir16Point", "")), "np-dim"), False, False, 0)

        # The next eight 3-hour slots, today running into tomorrow
        days = d.get("weather", [])
        hour_now = time.localtime().tm_hour
        slots = []
        for i, day in enumerate(days[:2]):
            for h in day.get("hourly", []):
                hour = int(h.get("time", "0")) // 100
                if i > 0 or hour + 3 > hour_now:
                    slots.append((hour, h))
        if slots:
            self.body.pack_start(label("Next hours", "np-title"), False, False, 2)
            grid = Gtk.Grid()
            grid.set_column_homogeneous(True)
            grid.set_row_spacing(2)
            for col, (hour, h) in enumerate(slots[:8]):
                rain = int(h.get("chanceofrain", 0) or 0)
                for r, (text, cls) in enumerate((("%02d:00" % hour, "np-dim"),
                                                  (self.wx.icon(h.get("weatherCode"), hour), "np-big"),
                                                  ("%s°" % h.get("tempC", "?"), None),
                                                  ("%d%%" % rain if rain >= 20 else "", "np-dim"))):
                    grid.attach(label(text, *([cls] if cls else []), xalign=0.5), col, r, 1, 1)
            self.body.pack_start(grid, False, False, 0)

        if len(days) > 1:
            self.body.pack_start(label("Next days", "np-title"), False, False, 2)
            for day in days[1:3]:
                try:
                    name = datetime.date.fromisoformat(day["date"]).strftime("%A")
                except (KeyError, ValueError):
                    name = day.get("date", "")
                noon = next((h for h in day.get("hourly", []) if h.get("time") == "1200"), {})
                line = hbox(10)
                line.pack_start(label(self.wx.icon(noon.get("weatherCode"), 12), "np-icon"), False, False, 0)
                line.pack_start(label(name), True, True, 0)
                line.pack_end(label("%s° / %s°" % (day.get("mintempC", "?"), day.get("maxtempC", "?"))),
                              False, False, 0)
                self.body.pack_start(line, False, False, 0)
        age = int((time.time() - entry.get("fetched", time.time())) // 60)
        self.body.pack_start(label("Updated just now" if age < 1 else "Updated %d min ago" % age,
                                   "np-dim"), False, False, 0)
        self.body.show_all()
        spawn("pkill", "-RTMIN+16", "-x", "waybar")     # the bar shows the same reading

# ------------------------------------------------------------------ agents --

def short_number(n):
    if n >= 1_000_000:
        return "%.1fM" % (n / 1_000_000)
    if n >= 1000:
        return "%dk" % round(n / 1000)
    return str(n)


def ago(moment):
    minutes = int((time.time() - moment) // 60)
    if minutes < 1:
        return "now"
    if minutes < 60:
        return "%d min" % minutes
    if minutes < 48 * 60:
        return "%d h" % (minutes // 60)
    return "%d days" % (minutes // 1440)


class AgentsPanel(Panel):
    """AI coding agents (the robot in the bar): today's use, the week, recent sessions."""
    width = 360
    BLOCKS = " ▁▂▃▄▅▆▇█"

    def __init__(self, app):
        super().__init__(app)
        head = hbox()
        head.pack_start(label("AI agents", "np-title"), True, True, 0)
        head.pack_end(icon_button(I["refresh"], self.load, tooltip="Refresh"), False, False, 0)
        self.box.pack_start(head, False, False, 0)
        self.body = vbox(6)
        self.box.pack_start(self.body, False, False, 0)
        self.body.pack_start(label("Reading your history…", "np-dim"), False, False, 6)
        note = label("From the history on this computer. For plan limits, type /usage "
                     "inside the app.", "np-dim")
        note.set_line_wrap(True)
        note.set_max_width_chars(44)
        self.box.pack_start(note, False, False, 4)
        self.load()

    def load(self):
        def work():
            rc, text = run(os.path.join(BIN, "agents"), "stats", timeout=120)
            try:
                return json.loads(text) if rc == 0 else None
            except ValueError:
                return None
        in_background(work, self.show)

    def show(self, agents):
        clear(self.body)
        if agents is None:
            self.body.pack_start(label("Couldn't read the agents' history.", "np-dim"), False, False, 6)
        elif not agents:
            self.body.pack_start(label("No AI coding agents found (Claude Code, Grok, Muse or opencode).", "np-dim"), False, False, 6)
        for key, a in (agents or {}).items():
            if self.body.get_children():
                self.body.pack_start(Gtk.Separator(), False, False, 4)
            top = hbox()
            top.pack_start(label(a["name"], "np-big"), True, True, 0)
            if a.get("command"):
                top.pack_end(icon_button(g(0xF018D), lambda c=a["command"]: self.start(c, ""),
                                         tooltip="New session in your home folder"), False, False, 0)
            self.body.pack_start(top, False, False, 0)
            t = a["today"]
            self.body.pack_start(label("Today: %s tokens · %d prompt%s · %d session%s" % (
                short_number(t["tokens"]), t["prompts"], "" if t["prompts"] == 1 else "s",
                t["sessions"], "" if t["sessions"] == 1 else "s")), False, False, 0)

            week = a["week"]
            peak = max([d["tokens"] for d in week] + [1])
            bars = "".join(self.BLOCKS[min(8, math.ceil(8 * d["tokens"] / peak))] if d["tokens"] else "·"
                           for d in week)
            letters = "".join(datetime.date.fromisoformat(d["date"]).strftime("%a")[0] for d in week)
            spark = hbox(10)
            col = vbox(0)
            col.pack_start(label("  ".join(bars), "np-spark"), False, False, 0)
            col.pack_start(label("  ".join(letters), "np-dim"), False, False, 0)
            spark.pack_start(col, False, False, 0)
            info = vbox(0)
            info.pack_start(label("%s tokens this week" % short_number(sum(d["tokens"] for d in week)),
                                  "np-dim"), False, False, 0)
            if a.get("top_model"):
                info.pack_start(label("mostly %s" % a["top_model"], "np-dim", ellipsize=True, width=22),
                                False, False, 0)
            spark.pack_start(info, False, False, 0)
            self.body.pack_start(spark, False, False, 2)

            for s in a.get("recent", [])[:3]:
                folder = os.path.basename(s.get("cwd", "").rstrip("/")) or "~"
                title = s.get("title") or folder
                b = row(g(0xF018D), title, ago(s["last"]),
                        on_click=lambda k=key, s=s: self.resume(k, a.get("command"), s))
                b.set_tooltip_text("%s\n%s tokens" % (s.get("cwd") or "", short_number(s.get("tokens", 0))))
                self.body.pack_start(b, False, False, 0)
        self.body.show_all()

    @staticmethod
    def terminal(cwd, command):
        """Run the agent in a terminal, in the session's folder. bash -i so ~/.bashrc
        sets up PATH (npm, ~/.local/bin) the way your own terminal has it."""
        cwd = cwd if cwd and os.path.isdir(cwd) else os.path.expanduser("~")
        spawn("alacritty", "--working-directory", cwd, "-e", "bash", "-ic", command)

    def start(self, command, cwd):
        self.terminal(cwd, command)
        self.close()

    def resume(self, key, command, s):
        if not command:
            return
        if key == "claude":
            self.terminal(s.get("cwd"), "claude --resume %s || exec bash" % shlex_quote(s["id"]))
        else:                         # the others: a new session in that project's folder
            self.terminal(s.get("cwd"), command + " || exec bash")
        self.close()


def shlex_quote(text):
    import shlex
    return shlex.quote(text)


# -------------------------------------------------------------- main menu --

def info_rows():
    """About: a few facts about this machine, read on the spot."""
    def first(path, key=None):
        try:
            with open(path) as f:
                for line in f:
                    if key is None:
                        return line.strip()
                    if line.startswith(key):
                        return line.split("=" if "=" in line else ":", 1)[1].strip().strip('"')
        except OSError:
            pass
        return ""

    mem_kb = first("/proc/meminfo", "MemTotal").split()
    try:
        up = int(float(first("/proc/uptime").split()[0]))
    except (IndexError, ValueError):
        up = 0
    du = shutil.disk_usage("/")
    hypr = out("hyprctl", "version", timeout=3).splitlines()
    hypr = re.sub(r"^Hyprland\s*", "", hypr[0]).split(" built")[0] if hypr else ""
    facts = [
        ("System", first("/etc/os-release", "PRETTY_NAME")),
        ("Computer", first("/sys/class/dmi/id/product_name")),
        ("Processor", re.sub(r"\s+", " ", first("/proc/cpuinfo", "model name"))
            .replace("(R)", "").replace("(TM)", "").replace(" CPU", "")),
        ("Memory", "%.0f GB" % (int(mem_kb[0]) / 1048576) if mem_kb else ""),
        ("Disk", "%.0f of %.0f GB free" % (du.free / 1e9, du.total / 1e9)),
        ("Kernel", os.uname().release),
        ("Hyprland", hypr),
        ("Up for", "%dh %02dm" % (up // 3600, up % 3600 // 60)),
    ]
    return [{"icon": "", "label": k, "right": v, "info": True} for k, v in facts if v]


def edit(path):
    """Open a config file in the first editor found."""
    for editor in ("code", "gnome-text-editor", "gedit"):
        if shutil.which(editor):
            return [editor, path]
    return ["alacritty", "-e", os.environ.get("EDITOR", "nano"), path]


def in_terminal(title, command):
    """Run a command in a floating terminal and wait for a key before closing."""
    script = command + '; echo; read -n 1 -s -r -p "Done. Press any key to close."'
    return ["alacritty", "--class", "nameplate-float", "--title", title, "-e", "bash", "-c", script]


def font_items():
    """Appearance -> Font: installed Nerd Fonts, terminal size, and fonts to download."""
    font = BIN + "/font"
    now = out(font, timeout=10)
    family, _, size = now.partition(", terminal size ")
    items = [{"icon": g(0xF0B34), "label": name, "right": "current" if name == family else "",
              "run": [font, "set", name]} for name in out(font, "list", timeout=20).splitlines() if name]
    items.append({"icon": g(0xF0B34), "label": "Terminal size", "right": size, "sub": [
        {"icon": g(0xF0B34), "label": str(n) + ("  (Omarchy)" if n == 9 else ""),
         "right": "current" if size.strip() in (str(n), "%d.0" % n) else "", "run": [font, "size", str(n)]}
        for n in (8, 9, 10, 11, 12, 13)]})
    more = [line.split("\t") for line in out(font, "more", timeout=20).splitlines() if "\t" in line]
    if more:
        items.append({"icon": g(0xF01DA), "label": "Get more fonts", "sub": [
            {"icon": g(0xF01DA), "label": name, "run": in_terminal("Fonts", "%s install %s" % (font, archive))}
            for archive, name in more]})
    return items


class MenuPanel(Panel):
    """Everything in one place (SUPER + ALT + SPACE): type to search, Enter to pick,
    arrows to move, Escape or Backspace to go back."""
    width = 340
    anchor = "middle"
    MAX_RESULTS = 12

    def __init__(self, app, route=None):
        super().__init__(app)
        self.stack = []            # [(title, items)]
        self.buttons = []          # [(button, item)] currently shown
        self.selected = 0
        head = hbox(6)
        self.back = Gtk.Button(label=g(0xF0141))
        self.back.get_style_context().add_class("np-back")
        self.back.connect("clicked", lambda *_: self.go_back())
        self.back.set_no_show_all(True)
        head.pack_start(self.back, False, False, 0)
        self.title = label("", "np-title")
        head.pack_start(self.title, True, True, 0)
        self.box.pack_start(head, False, False, 0)
        self.search = Gtk.SearchEntry()
        self.search.get_style_context().add_class("np-search")
        self.search.set_placeholder_text("Search")
        self.search.connect("search-changed", lambda *_: self.fill())
        self.search.connect("activate", lambda *_: self.activate())
        self.box.pack_start(self.search, False, False, 0)
        self.list = vbox(0)
        self.box.pack_start(self.list, False, False, 0)

        try:
            with open(os.path.expanduser("~/.config/nameplate/name")) as f:
                name = f.read().strip()
        except OSError:
            name = ""
        self.root = self.tree()
        self.stack.append((name or "Menu", self.root))
        for item in self.root:           # e.g. "panel menu system" opens System directly
            if route and item["label"].lower() == route.lower() and "sub" in item:
                self.stack.append((item["label"], self.items_of(item)))
        self.fill()

    def shown(self):
        self.search.grab_focus()
        self.back.set_visible(len(self.stack) > 1)
        GLib.idle_add(self.keep_size)

    def keep_size(self):
        """Hold the first height, so the menu doesn't jump around while you search."""
        self.list.set_size_request(-1, self.list.get_allocated_height())
        return False

    # ---- what's in the menu ----

    def tree(self):
        B = BIN + "/"
        panel = lambda kind: {"panel": kind}
        run_ = lambda *cmd: {"run": list(cmd)}
        recording = subprocess.run(["pgrep", "-x", "wf-recorder"], capture_output=True).returncode == 0
        dnd = "do-not-disturb" in out("makoctl", "mode", timeout=3).split()
        running = lambda name: subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0
        awake = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and not running("hypridle")
        night = running("hyprsunset")
        cfg = os.path.expanduser("~/.config")
        configs = [("Hyprland (keys, windows, startup)", "hypr/hyprland.lua"),
                   ("Lock screen", "hypr/hyprlock.conf"), ("Idle and screen off", "hypr/hypridle.conf"),
                   ("Bar", "waybar/config.jsonc"), ("Bar style", "waybar/style.css"),
                   ("Notifications", "mako/config"), ("Launcher", "fuzzel/fuzzel.ini"),
                   ("Terminal", "alacritty/alacritty.toml"), ("Prompt", "starship.toml")]
        updates = [{"icon": g(0xF03D3), "label": "Ubuntu packages",
                    "run": in_terminal("Update", "sudo apt update && sudo apt full-upgrade")}]
        if shutil.which("snap"):
            updates.append({"icon": g(0xF01A7), "label": "Snaps",
                            "run": in_terminal("Update", "sudo snap refresh")})
        if shutil.which("flatpak"):
            updates.append({"icon": g(0xF01A7), "label": "Flatpaks",
                            "run": in_terminal("Update", "flatpak update")})
        if shutil.which("fwupdmgr"):
            updates.append({"icon": g(0xF061A), "label": "Firmware",
                            "run": in_terminal("Update", "fwupdmgr refresh; fwupdmgr update")})
        record = ([{"icon": g(0xF04DB), "label": "Stop recording", **run_(B + "screenrecord")}] if recording else [
            {"icon": g(0xF019E), "label": "Region", **run_(B + "screenrecord")},
            {"icon": g(0xF0293), "label": "Full screen", **run_(B + "screenrecord", "full")},
            {"icon": g(0xF036C), "label": "Full screen with microphone", **run_(B + "screenrecord", "full", "mic")}])
        return [
            {"icon": g(0xF003B), "label": "Apps", **run_("fuzzel")},
            {"icon": g(0xF03D8), "label": "Appearance", "sub": [
                {"icon": g(0xF03D8), "label": "Theme", **panel("themes")},
                {"icon": g(0xF0B34), "label": "Font", "sub": font_items},
                {"icon": I["image"], "label": "Background", **panel("wallpapers")},
                {"icon": I["next"], "label": "Next background", "stay": True, **run_(B + "wallpaper", "next")},
                {"icon": g(0xF0209), "label": "Show or hide the bar", **run_("pkill", "-SIGUSR1", "waybar")},
                {"icon": I["refresh"], "label": "Restart the bar",
                 **run_("sh", "-c", "pkill -x waybar; sleep 0.5; exec waybar")},
            ]},
            {"icon": g(0xF0241), "label": "Trigger", "sub": [
                {"icon": g(0xF0100), "label": "Screenshot", "sub": [
                    {"icon": g(0xF019E), "label": "Region", **run_(B + "screenshot", "region")},
                    {"icon": g(0xF0293), "label": "Full screen", **run_(B + "screenshot", "full")}]},
                {"icon": g(0xF044A), "label": "Stop recording" if recording else "Screen recording",
                 **({"run": record[0]["run"]} if recording else {"sub": record})},
                {"icon": I["clip"], "label": "Clipboard history", **panel("clipboard")},
                {"icon": g(0xF06A9), "label": "AI agents", **panel("agents")},
                {"icon": g(0xF01F5), "label": "Emoji", **panel("emoji")},
                {"icon": g(0xF009B), "label": "Do not disturb", "right": "on" if dnd else "off",
                 **run_(B + "dnd")},
                {"icon": g(0xF0176), "label": "Stay awake", "right": "on" if awake else "off",
                 **run_(B + "stay-awake")},
                {"icon": g(0xF050E), "label": "Night light", "right": "on" if night else "off",
                 **run_(B + "nightlight")},
            ]},
            {"icon": I["cog"], "label": "Setup", "sub": [
                {"icon": I["wifi"][-1], "label": "Wi-Fi", **panel("wifi")},
                {"icon": I["bt"], "label": "Bluetooth", **panel("bluetooth")},
                {"icon": I["vol"][-1], "label": "Sound and brightness", **panel("sound")},
                {"icon": I["monitor"], "label": "Displays", **panel("display")},
                {"icon": I["balance"], "label": "Power profile", **panel("power")},
                {"icon": g(0xF030C), "label": "Keybindings", **run_(B + "keys")},
                {"icon": g(0xF0219), "label": "Config files", "sub": [
                    {"icon": g(0xF0219), "label": text, "run": edit(os.path.join(cfg, rel))}
                    for text, rel in configs if os.path.exists(os.path.join(cfg, rel))]},
                {"icon": g(0xF062E), "label": "GNOME Settings",
                 **run_("env", "XDG_CURRENT_DESKTOP=GNOME", "gnome-control-center")},
            ]},
            {"icon": g(0xF06B0), "label": "Update", "sub": updates},
            {"icon": g(0xF05DA), "label": "Learn", "sub": [
                {"icon": g(0xF030C), "label": "Keybindings", **run_(B + "keys")},
                {"icon": g(0xF059F), "label": "Hyprland wiki", **run_("xdg-open", "https://wiki.hypr.land")},
                {"icon": g(0xF02A4), "label": "hypr-nameplate on GitHub",
                 **run_("xdg-open", "https://github.com/adoodevv/hypr-nameplate")},
            ]},
            {"icon": g(0xF02FD), "label": "About", "sub": info_rows},
            {"icon": g(0xF0425), "label": "System", "sub": [
                {"icon": I["lock"], "label": "Lock", **run_("loginctl", "lock-session")},
                {"icon": I["monitor"], "label": "Screensaver", **run_(B + "launch-screensaver")},
                {"icon": g(0xF04B2), "label": "Suspend", **run_("systemctl", "suspend")},
                {"icon": g(0xF0343), "label": "Log out", **run_("hyprctl", "dispatch", "hl.dsp.exit()")},
                {"icon": g(0xF0709), "label": "Restart", **run_("systemctl", "reboot")},
                {"icon": g(0xF0425), "label": "Shut down", **run_("systemctl", "poweroff")},
            ]},
        ]

    @staticmethod
    def items_of(item):
        sub = item["sub"]
        return sub() if callable(sub) else sub

    def everything(self, items=None, path=""):
        """Every item reachable from the top, with where it lives, for searching."""
        for item in self.root if items is None else items:
            if "sub" in item and not callable(item["sub"]):
                yield from self.everything(item["sub"], item["label"] if not path else path + " › " + item["label"])
            if not item.get("info"):
                yield item, path

    # ---- drawing ----

    def fill(self):
        clear(self.list)
        self.buttons = []
        query = self.search.get_text().strip().lower()
        title, items = self.stack[-1]
        self.title.set_text(title)
        if query:
            def words(item, path):   # "wifi" finds Wi-Fi, "shutdown" finds Shut down
                text = (path + " " + item["label"]).lower().replace("-", "")
                return text.split() + [item["label"].lower().replace(" ", "").replace("-", "")]
            wanted = query.replace("-", "").split()
            shown = [(item, path) for item, path in self.everything()
                     if all(any(w.startswith(q) for w in words(item, path)) for q in wanted)]
            shown = shown[:self.MAX_RESULTS]
        else:
            shown = [(item, item.get("right", "")) for item in items]
        for item, right in shown:
            if item.get("info"):           # About: a plain line, not a button
                line = hbox(10)
                line.set_margin_start(8)
                line.set_margin_end(8)
                line.set_margin_top(4)
                line.set_margin_bottom(4)
                line.pack_start(label(item["label"], "np-dim"), False, False, 5)
                line.pack_end(label(right, ellipsize=True, width=30, xalign=1.0), True, True, 5)
                self.list.pack_start(line, False, False, 0)
                continue
            if query:
                right = right.split(" › ")[-1]          # just where it lives, e.g. "Config files"
            more = "sub" in item
            b = row(item["icon"], item["label"], right=right + (("  " if right else "") + g(0xF0142) if more else ""),
                    on_click=lambda it=item: self.choose(it))
            self.buttons.append((b, item))
            b.connect("enter-notify-event", lambda w, *_: self.select_button(w))
            self.list.pack_start(b, False, False, 0)
        if not shown:
            self.list.pack_start(label("No matches." if query else "Nothing here.", "np-dim"), False, False, 6)
        self.list.show_all()
        self.select(0)

    def select_button(self, button):
        for i, (b, _) in enumerate(self.buttons):
            if b is button:
                self.select(i)
        return False

    def select(self, i):
        if not self.buttons:
            return
        self.selected = max(0, min(i, len(self.buttons) - 1))
        for n, (b, _) in enumerate(self.buttons):
            ctx = b.get_style_context()
            (ctx.add_class if n == self.selected else ctx.remove_class)("np-selected")

    # ---- doing ----

    def activate(self):
        if self.buttons:
            self.choose(self.buttons[self.selected][1])

    def choose(self, item):
        if "sub" in item:
            self.stack.append((item["label"], self.items_of(item)))
            self.search.set_text("")
            self.back.set_visible(True)
            self.fill()
            self.search.grab_focus()
        elif "panel" in item:
            self.close()                         # frees the panel slot first
            open_panel(item["panel"])
        elif "run" in item:
            if item.get("stay"):
                spawn(*item["run"])
                return
            self.close()
            # a moment for the menu to disappear, so screenshots and the lock don't catch it
            spawn("sh", "-c", 'sleep 0.25; exec "$@"', "sh", *item["run"])

    def go_back(self):
        if len(self.stack) > 1:
            self.stack.pop()
            self.search.set_text("")
            self.back.set_visible(len(self.stack) > 1)
            self.fill()
            self.search.grab_focus()
            return True
        return False

    def on_key(self, event):
        key = event.keyval
        if key == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text("")
                return True
            return self.go_back()            # at the top, Escape closes as usual
        if key == Gdk.KEY_BackSpace and not self.search.get_text():
            self.go_back()
            return True
        if key in (Gdk.KEY_Down, Gdk.KEY_Tab, Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab) and self.buttons:
            step = 1 if key in (Gdk.KEY_Down, Gdk.KEY_Tab) else -1
            self.select((self.selected + step) % len(self.buttons))   # wraps around
            return True
        if key == Gdk.KEY_Right and self.buttons and "sub" in self.buttons[self.selected][1] \
                and not self.search.get_text():
            self.activate()
            return True
        if key == Gdk.KEY_Left and not self.search.get_text():
            return self.go_back()
        return False


KINDS = {"calendar": CalendarPanel, "media": MediaPanel, "sound": SoundPanel,
         "wifi": WifiPanel, "bluetooth": BluetoothPanel, "display": DisplayPanel,
         "power": PowerPanel, "wallpapers": WallpaperPanel,
         "clipboard": ClipboardPanel, "emoji": EmojiPanel, "menu": MenuPanel,
         "themes": ThemePanel, "weather": WeatherPanel,
         "agents": AgentsPanel}


# --------------------------------------------------------------------- app --

class App:
    """One open panel: its window, plus the invisible click-catcher around it."""

    def __init__(self, kind, route=None, mark_x=None):
        global CURRENT
        CURRENT = self
        self.closed = False
        self.windows = []
        self.panel = None
        if STYLE is None:
            install_css()
        layered = GtkLayerShell is not None and GtkLayerShell.is_supported()
        monitor = self.monitor_at(mark_x)      # open on the screen whose bar was clicked

        if layered:
            self.windows.append(self.backdrop(monitor))

        panel = KINDS[kind](self, route) if route else KINDS[kind](self)
        self.panel = panel
        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.get_style_context().add_class("np-popup")
        win.set_title(f"nameplate {kind}")
        frame = Gtk.Box()
        frame.set_border_width(12)
        panel.box.set_size_request(panel.width, -1)
        frame.add(panel.box)
        win.add(frame)
        win.connect("key-press-event", self.on_key)
        win.connect("destroy", lambda *_: self.quit())
        if layered:
            GtkLayerShell.init_for_window(win)
            GtkLayerShell.set_namespace(win, "nameplate-panel")
            GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
            if monitor is not None:
                GtkLayerShell.set_monitor(win, monitor)
            if panel.anchor != "middle":     # "middle": centred on the screen
                GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.TOP, True)
                GtkLayerShell.set_margin(win, GtkLayerShell.Edge.TOP, 6)
            if panel.anchor == "right":
                GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
                GtkLayerShell.set_margin(win, GtkLayerShell.Edge.RIGHT, 10)
            GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        else:
            # Not on a layer-shell desktop (e.g. GNOME): a plain window that closes when it loses focus
            win.set_decorated(False)
            win.set_position(Gtk.WindowPosition.MOUSE)
            win.connect("focus-out-event", lambda *_: self.quit())
        self.windows.append(win)
        for w in self.windows:
            w.show_all()
        win.set_focus(None)    # no control starts focused (avoids the theme's focus ring)
        panel.shown()      # lets a panel hide parts that show_all() just made visible

    @staticmethod
    def monitor_at(x):
        """The screen the bar click was on (x is the pointer's position across all screens)."""
        if x is None:
            return None
        display = Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            m = display.get_monitor(i)
            g = m.get_geometry()
            if g.x <= x < g.x + g.width:
                return m
        return None

    def backdrop(self, monitor):
        """Invisible layer over everything except the bar: any click on it closes the panel."""
        w = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        w.get_style_context().add_class("np-backdrop")
        visual = w.get_screen().get_rgba_visual()
        if visual:
            w.set_visual(visual)
        GtkLayerShell.init_for_window(w)
        GtkLayerShell.set_namespace(w, "nameplate-backdrop")
        GtkLayerShell.set_layer(w, GtkLayerShell.Layer.TOP)
        if monitor is not None:
            GtkLayerShell.set_monitor(w, monitor)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(w, edge, True)
        GtkLayerShell.set_exclusive_zone(w, 0)   # stays clear of the bar, so bar icons remain clickable
        GtkLayerShell.set_keyboard_mode(w, GtkLayerShell.KeyboardMode.NONE)
        w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.TOUCH_MASK)
        w.connect("button-press-event", lambda *_: self.quit())
        w.connect("touch-event", lambda *_: self.quit())
        return w

    def on_key(self, _w, event):
        hook = getattr(self.panel, "on_key", None)
        if hook and hook(event):
            return True
        if event.keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        return False

    def quit(self):
        if self.closed:
            return
        self.closed = True
        try:
            if self.panel:
                self.panel.cleanup()
        except Exception:
            traceback.print_exc()
        for w in self.windows:
            w.destroy()
        self.windows = []
        if DAEMON:
            DAEMON.closed(self)
            return
        try:
            with open(PIDFILE) as f:
                if f.read().split()[0] == str(os.getpid()):
                    os.remove(PIDFILE)
        except (OSError, IndexError):
            pass
        Gtk.main_quit()


class Daemon:
    """panel daemon: stays running after login and shows panels on request (bin/panel's
    client() sends them over a socket), so a bar click doesn't wait for Python and GTK."""

    def __init__(self):
        self.app = None
        self.kind = None
        if send("ping"):                       # one is already running
            sys.exit(0)
        try:
            os.unlink(SOCK)
        except OSError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(SOCK)
        os.chmod(SOCK, 0o600)
        self.sock.listen(8)
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self.accept)
        install_css()
        self.tell_bar(None, None)         # nothing open (clears a line left by a crash)

    def accept(self, *_):
        try:
            conn, _ = self.sock.accept()
            with conn:
                conn.settimeout(1)
                message = conn.recv(4096).decode(errors="replace")
        except OSError:
            return True
        parts = message.split("\t")
        try:
            if parts[0] == "open" and len(parts) >= 2 and parts[1] in KINDS:
                x = int(float(parts[3])) if len(parts) > 3 and parts[3].strip() else None
                if self.app and not self.app.closed and self.kind == parts[1]:
                    self.app.quit()             # the same bar item again: close it
                else:
                    self.open(parts[1], parts[2] if len(parts) > 2 and parts[2] else None, x)
            elif parts[0] == "reload":
                install_css()
            elif parts[0] == "close" and self.app:
                self.app.quit()
        except Exception:
            traceback.print_exc()
        return True

    def open(self, kind, route=None, mark_x=None):
        if self.app and not self.app.closed:
            self.app.quit()
        try:
            self.app = App(kind, route, mark_x)
            self.kind = kind
            self.tell_bar(kind, route)
        except Exception:
            traceback.print_exc()
            if CURRENT and not CURRENT.closed:
                CURRENT.quit()

    def closed(self, app):
        if app is self.app:
            self.app, self.kind = None, None
            GLib.idle_add(self.bar_if_idle)     # unless another panel opens straight away

    def bar_if_idle(self):
        if self.app is None:
            self.tell_bar(None, None)
        return False

    @staticmethod
    def tell_bar(kind, route):
        """Which panel is open, so its bar item draws the accent line (bin/bar-status)."""
        try:
            with open(OPEN_FILE, "w") as f:
                f.write(f"{kind} {route or ''}".strip() + "\n" if kind else "")
        except OSError:
            return
        for sig in (12, 9, 16):         # the panel items, the sound item, the weather
            subprocess.Popen(["pkill", f"-RTMIN+{sig}", "-x", "waybar"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def stop(self):
        try:
            os.unlink(SOCK)
        except OSError:
            pass
        Gtk.main_quit()


def take_over(kind):
    """Without the background process: one panel at a time, by pid file."""
    try:
        with open(PIDFILE) as f:
            pid, current = f.read().split()[:2]
        pid = int(pid)
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            alive_ = b"panel" in f.read()
    except (OSError, ValueError):
        alive_, current = False, None
    if alive_:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        if current == kind:
            return False
    with open(PIDFILE, "w") as f:
        f.write(f"{os.getpid()} {kind}\n")
    return True


def main():
    global DAEMON
    args = [a for a in sys.argv[1:] if a != "--bar"]
    kind = args[0] if args else ""
    if kind == "daemon":
        DAEMON = Daemon()
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, DAEMON.stop)
        Gtk.main()
        return
    if kind not in KINDS:
        sys.exit("usage: panel " + " | ".join(PANELS) + " | daemon | reload")
    if not take_over(kind):
        return
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    App(kind, args[1] if len(args) > 1 else None)
    Gtk.main()


if __name__ == "__main__":
    main()

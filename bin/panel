#!/usr/bin/python3
"""hypr-nameplate panels: small popups that open under the top bar.

    panel calendar | media | sound | wifi | bluetooth | display | power | menu | ...
    panel KIND --bar    opened by clicking the bar (the panel opens on that screen)
    panel daemon        keep running in the background (started at login), so panels
                        open instantly instead of starting Python and GTK on every click
    panel reload        pick up a new theme or font

Clicking anywhere outside a panel, or pressing Escape, closes it. Clicking the same
bar icon again closes it too; clicking a different icon switches panels.

Uses the system Python on purpose (/usr/bin/python3): it has the GTK bindings, while a
conda or virtualenv python3 earlier in PATH usually does not.
"""
import os
import socket
import subprocess
import sys
import tempfile

RUN = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
SOCK = os.path.join(RUN, "nameplate-panel.sock")


def send(message):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            s.connect(SOCK)
            s.sendall(message.encode())
        return True
    except OSError:
        return False


def client():
    """The quick path: hand the request to the background panel process and exit,
    before loading GTK. Falls through (returns) to run the panel here if there's none."""
    args = [a for a in sys.argv[1:] if a != "--bar"]
    if not args or args[0] == "daemon":
        return
    if args[0] == "reload":
        send("reload")
        sys.exit(0)
    x = ""
    if "--bar" in sys.argv:          # where the click was, to mark the bar item
        try:
            x = subprocess.run(["hyprctl", "cursorpos"], capture_output=True, text=True,
                               timeout=1).stdout.split(",")[0].strip()
        except (OSError, subprocess.TimeoutExpired):
            pass
    message = "\t".join(["open", args[0], args[1] if len(args) > 1 else "", x])
    if send(message):
        sys.exit(0)
    # No background process yet (first click after an update, or it crashed): start one
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "daemon"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    import time
    for _ in range(60):
        time.sleep(0.05)
        if send(message):
            sys.exit(0)


if __name__ == "__main__":
    client()


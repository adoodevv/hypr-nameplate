def theme_colors():
    """The current theme's colours (written by bin/theme), Tokyo Night if there are none."""
    colors = {"mode": "dark", "background": "#1a1b26", "selection": "#292e42", "muted": "#414868",
              "dark_foreground": "#565f89", "accent": "#7aa2f7", "foreground": "#a9b1d6",
              "bright_foreground": "#c0caf5", "red": "#f7768e"}
    try:
        with open(os.path.expanduser("~/.config/nameplate/colors.toml")) as f:
            for line in f:
                m = re.match(r'\s*(\w+)\s*=\s*"([^"]*)"', line)
                if m:
                    colors[m.group(1)] = m.group(2)
    except OSError:
        pass
    return colors


STYLE = None


def install_css():
    """Load (or reload, after a theme or font change) the panels' look."""
    global STYLE
    screen = Gdk.Screen.get_default()
    if STYLE:
        Gtk.StyleContext.remove_provider_for_screen(screen, STYLE)
    STYLE = Gtk.CssProvider()
    css, light = themed_css()
    STYLE.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(screen, STYLE, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", not light)


def themed_css():
    c = theme_colors()
    names = {"bg": "background", "selection": "selection", "muted": "muted", "fg_dim": "dark_foreground",
             "accent": "accent", "fg": "foreground", "fg_bright": "bright_foreground", "red": "red"}
    head = "".join("@define-color %s %s;\n" % (k, c[v]) for k, v in names.items())
    font = read(os.path.expanduser("~/.config/nameplate/font")) or "JetBrainsMono Nerd Font"
    css = CSS.replace('"JetBrainsMono Nerd Font"', '"%s"' % font.replace('"', ""))
    return (head + css).encode(), c["mode"] == "light"



# ----------------------------------------------------------------- helpers --

def run(*args, timeout=25, env=None):
    """Run a command, return (exit code, combined output)."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                           env={**os.environ, **(env or {})})
        return p.returncode, (p.stdout + p.stderr).strip()
    except FileNotFoundError:
        return 127, f"{args[0]} is not installed"
    except OSError as e:
        return 126, str(e)
    except subprocess.TimeoutExpired:
        return 124, "timed out"


def out(*args, **kw):
    rc, text = run(*args, **kw)
    return text if rc == 0 else ""


def spawn(*args, env=None):
    subprocess.Popen(args, start_new_session=True, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, env={**os.environ, **(env or {})})


CURRENT = None     # the App on screen
DAEMON = None      # set when running in the background (panel daemon)


def alive(app):
    return app is not None and app is CURRENT and not app.closed


def in_background(work, done=None):
    """Run work() in a thread, then done(result) on the GTK main thread, unless the
    panel that asked has been closed in the meantime."""
    app = CURRENT

    def target():
        try:
            result = work()
        except Exception:
            traceback.print_exc()
            return
        if done:
            GLib.idle_add(lambda: (alive(app) and done(result), False)[1])
    threading.Thread(target=target, daemon=True).start()


def timer(ms, fn):
    """GLib.timeout_add that stops by itself once its panel is closed."""
    app = CURRENT
    return GLib.timeout_add(ms, lambda: bool(alive(app) and fn()))


def open_panel(kind, route=None):
    """Switch to another panel (from the menu, or to redraw one)."""
    if DAEMON:
        GLib.idle_add(lambda: (DAEMON.open(kind, route), False)[1])
    else:
        spawn(os.path.join(BIN, "panel"), kind, *([route] if route else []))


def label(text="", *classes, xalign=0.0, ellipsize=False, width=None):
    w = Gtk.Label(label=text, xalign=xalign)
    for c in classes:
        w.get_style_context().add_class(c)
    if ellipsize:
        from gi.repository import Pango
        w.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        w.set_max_width_chars(width)
        w.set_width_chars(min(width, 10))
    return w


def hbox(spacing=8):
    return Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)


def vbox(spacing=4):
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)


def row(icon, text, right="", on_click=None, active=False, dim=False):
    """A full-width clickable row: icon, text, optional right-hand text."""
    b = Gtk.Button()
    box = hbox(10)
    box.pack_start(label(icon, "np-icon"), False, False, 0)
    box.pack_start(label(text, ellipsize=True, width=26), True, True, 0)
    if right:
        box.pack_end(label(right, "np-dim"), False, False, 0)
    b.add(box)
    if active:
        b.get_style_context().add_class("np-active")
    if dim:
        b.get_style_context().add_class("np-dim")
    if on_click:
        b.connect("clicked", lambda *_: on_click())
    return b


def icon_button(icon, on_click, *classes, tooltip=None):
    b = Gtk.Button(label=icon)
    for c in ("np-round",) + classes:
        b.get_style_context().add_class(c)
    if tooltip:
        b.set_tooltip_text(tooltip)
    b.connect("clicked", lambda *_: on_click())
    return b


def clear(box):
    for child in box.get_children():
        box.remove(child)


# ------------------------------------------------------------------ panels --

class Panel:
    """Base: builds content into self.box; refresh() may be called periodically."""
    width = 300
    anchor = "right"          # "right" or "center"

    def __init__(self, app):
        self.app = app
        self.box = vbox(6)

    def close(self):
        self.app.quit()

    def shown(self):
        pass

    def live(self, ms, fn):
        """Call fn every ms while the panel is open (to keep it up to date)."""
        timer(ms, lambda: (fn(), True)[1])

    def cleanup(self):
        """Called when the panel closes."""


class CalendarPanel(Panel):
    """Calendar, with the media player underneath while something is playing."""
    width = 300
    anchor = "center"

    def __init__(self, app):
        super().__init__(app)
        today = datetime.date.today()
        self.box.pack_start(label(today.strftime("%A"), "np-dim", xalign=0.5), False, False, 0)
        self.box.pack_start(label(today.strftime("%-d %B %Y"), "np-big", xalign=0.5), False, False, 0)
        self.cal = Gtk.Calendar()
        self.cal.set_display_options(Gtk.CalendarDisplayOptions.SHOW_HEADING
                                     | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES)
        self.box.pack_start(self.cal, False, False, 4)
        self.box.pack_start(row(I["refresh"], "Back to today", on_click=self.today), False, False, 0)
        self.media = MediaPanel(app, compact=True)
        self.box.pack_start(self.media.box, False, False, 0)

    def shown(self):
        self.media.shown()

    def today(self):
        t = datetime.date.today()
        self.cal.select_month(t.month - 1, t.year)
        self.cal.select_day(t.day)


class MediaPanel(Panel):
    width = 320
    FMT = "{{status}}\x1f{{title}}\x1f{{artist}}\x1f{{playerName}}\x1f{{position}}\x1f{{mpris:length}}"

    def __init__(self, app, compact=False):
        super().__init__(app)
        self.compact = compact     # inside the calendar: hide entirely when nothing plays
        self.player = None
        self.dragging = False
        self.shape = None          # what the player list looked like last time

        self.empty = vbox(4)
        self.empty.pack_start(label(I["music"] + "  Nothing is playing", "np-title"), False, False, 0)
        self.empty.pack_start(label("Spotify, YouTube in Chrome and most\nmedia apps show up here while playing.",
                                    "np-dim"), False, False, 0)
        self.box.pack_start(self.empty, False, False, 0)

        self.info = vbox(6)
        if compact:
            self.info.pack_start(Gtk.Separator(), False, False, 4)
        self.title = label("", "np-title", ellipsize=True, width=34)
        self.artist = label("", ellipsize=True, width=34)
        self.source = label("", "np-dim")
        self.seek = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.seek.set_draw_value(False)
        self.seek.connect("button-press-event", lambda *_: setattr(self, "dragging", True))
        self.seek.connect("button-release-event", self.seek_done)
        self.pos_label, self.len_label = label("", "np-dim"), label("", "np-dim")
        self.times = hbox()
        self.times.pack_start(self.pos_label, False, False, 0)
        self.times.pack_end(self.len_label, False, False, 0)
        buttons = hbox(18)
        buttons.set_halign(Gtk.Align.CENTER)
        buttons.pack_start(icon_button(I["prev"], lambda: self.act("previous"), tooltip="Previous"), False, False, 0)
        self.play = icon_button(I["play"], lambda: self.act("play-pause"), "np-main", tooltip="Play / pause")
        buttons.pack_start(self.play, False, False, 0)
        buttons.pack_start(icon_button(I["next"], lambda: self.act("next"), tooltip="Next"), False, False, 0)
        self.players = vbox(0)
        for w in (self.title, self.artist, self.source, self.seek, self.times, buttons, self.players):
            self.info.pack_start(w, False, False, 0)
        self.box.pack_start(self.info, False, False, 0)

        self.refresh()
        timer(1000, lambda: (self.refresh(), True)[1])

    def shown(self):
        self.refresh()

    def ctl(self, *args):
        base = ["playerctl"] + (["-p", self.player] if self.player else [])
        return run(*base, *args, timeout=5)

    def refresh(self):
        players = [p for p in out("playerctl", "-l", timeout=5).splitlines() if p.strip()]
        if self.player not in players:
            self.player = None
        rc, text = self.ctl("metadata", "--format", self.FMT)
        playing = rc == 0 and bool(text)
        self.empty.set_visible(not playing and not self.compact)
        self.info.set_visible(playing)
        if not playing:
            return
        status, title, artist, name, pos, length = (text.split("\x1f") + [""] * 6)[:6]
        self.title.set_text(title or "Unknown title")
        self.artist.set_text(artist)
        self.artist.set_visible(bool(artist))
        self.source.set_text(name.split(".")[0].capitalize())
        self.play.set_label(I["pause"] if status == "Playing" else I["play"])
        try:
            pos_s, len_s = int(pos or 0) / 1e6, int(length or 0) / 1e6
        except ValueError:
            pos_s = len_s = 0
        has_len = len_s > 0
        self.seek.set_visible(has_len)
        self.times.set_visible(has_len)
        if has_len and not self.dragging:
            self.seek.set_range(0, len_s)
            self.seek.set_value(min(pos_s, len_s))
            self.pos_label.set_text(fmt_time(pos_s))
            self.len_label.set_text(fmt_time(len_s))

        shape = (tuple(players), name)
        if len(players) > 1 and shape != self.shape:
            clear(self.players)
            self.players.pack_start(Gtk.Separator(), False, False, 0)
            for p in players:
                self.players.pack_start(row(I["music"], p.split(".")[0].capitalize(),
                                            on_click=lambda p=p: self.pick(p),
                                            active=(p == name or p.split(".")[0] == name)), False, False, 0)
            self.players.show_all()
        elif len(players) <= 1:
            clear(self.players)
        self.shape = shape

    def seek_done(self, scale, _event):
        self.ctl("position", str(max(0, int(scale.get_value()))))
        self.dragging = False
        timer(300, lambda: (self.refresh(), False)[1])

    def act(self, what):
        self.ctl(what)
        timer(250, lambda: (self.refresh(), False)[1])

    def pick(self, player):
        self.player = player
        self.shape = None
        self.refresh()


def fmt_time(s):
    s = int(s)
    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


class SoundPanel(Panel):
    width = 320

    def __init__(self, app):
        super().__init__(app)
        self.pending = {}
        self.syncing = False        # True while the panel moves a slider itself
        self.touched = 0.0          # when you last moved a slider
        self.bright_scale = None
        self.shown_outputs = None

        self.box.pack_start(label("Sound", "np-title"), False, False, 0)
        vol, muted = self.volume()
        self.mute_btn = icon_button(self.vol_icon(vol, muted), self.toggle_mute, tooltip="Mute")
        self.vol_scale, self.vol_label = self.slider(vol, 0, 100, self.set_volume)
        line = hbox(6)
        line.pack_start(self.mute_btn, False, False, 0)
        line.pack_start(self.vol_scale, True, True, 0)
        line.pack_start(self.vol_label, False, False, 0)
        self.box.pack_start(line, False, False, 0)

        bright = None              # brightness lives in the display panel now, like Omarchy
        if bright is not None:
            self.box.pack_start(label("Brightness", "np-title"), False, False, 2)
            self.bright_scale, self.bright_label = self.slider(bright, 1, 100, self.set_brightness)
            line = hbox(6)
            line.pack_start(icon_button(I["bright"], lambda: None), False, False, 0)
            line.pack_start(self.bright_scale, True, True, 0)
            line.pack_start(self.bright_label, False, False, 0)
            self.box.pack_start(line, False, False, 0)

        self.box.pack_start(Gtk.Separator(), False, False, 0)
        self.box.pack_start(label("Output", "np-title"), False, False, 0)
        self.outputs = vbox(0)
        self.box.pack_start(self.outputs, False, False, 0)
        self.fill_outputs()
        self.box.pack_start(Gtk.Separator(), False, False, 0)
        self.box.pack_start(row(I["mixer"], "Open mixer", on_click=self.mixer), False, False, 0)
        self.live(1000, self.update)

    def update(self):
        """Follow changes made elsewhere: volume keys, headphones plugged in, other apps."""
        import time
        if self.pending or time.monotonic() - self.touched < 1.5:
            return                      # you're dragging a slider; don't fight you

        def work():
            return self.volume(), self.brightness(), self.sinks()

        def done(result):
            (vol, muted), bright, outputs = result
            if self.pending or time.monotonic() - self.touched < 1.5:
                return
            self.syncing = True
            try:
                if int(self.vol_scale.get_value()) != vol:
                    self.vol_scale.set_value(vol)
                self.mute_btn.set_label(self.vol_icon(vol, muted))
                if self.bright_scale is not None and bright is not None \
                        and int(self.bright_scale.get_value()) != bright:
                    self.bright_scale.set_value(bright)
            finally:
                self.syncing = False
            if outputs != self.shown_outputs:
                self.fill_outputs(outputs)
        in_background(work, done)

    @staticmethod
    def slider(value, lo, hi, on_change):
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
        scale.set_draw_value(False)
        scale.set_value(value)
        lab = label(f"{int(value)}%", xalign=1.0)
        lab.set_width_chars(4)

        def changed(s):
            v = int(round(s.get_value()))
            lab.set_text(f"{v}%")
            on_change(v)
        scale.connect("value-changed", changed)
        return scale, lab

    def debounce(self, key, fn):
        """Apply slider changes at most ~15 times a second."""
        if key in self.pending:
            GLib.source_remove(self.pending[key])
        self.pending[key] = timer(60, lambda: (self.pending.pop(key, None), fn(), False)[2])

    @staticmethod
    def volume():
        text = out("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@", timeout=5)
        m = re.search(r"([\d.]+)", text)
        return (round(float(m.group(1)) * 100) if m else 0), ("MUTED" in text)

    @staticmethod
    def vol_icon(vol, muted):
        if muted:
            return I["mute"]
        return I["vol"][2 if vol >= 66 else 1 if vol >= 33 else 0]

    def set_volume(self, v):
        if self.syncing:
            return
        import time
        self.touched = time.monotonic()

        def apply():
            run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v}%", timeout=5)
            run("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0", timeout=5)
            self.mute_btn.set_label(self.vol_icon(v, False))
        self.debounce("vol", apply)

    def toggle_mute(self):
        run("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle", timeout=5)
        vol, muted = self.volume()
        self.mute_btn.set_label(self.vol_icon(vol, muted))

    @staticmethod
    def brightness():
        text = out("brightnessctl", "-m", timeout=5)
        m = re.search(r",(\d+)%,", text)
        return int(m.group(1)) if m else None

    def set_brightness(self, v):
        if self.syncing:
            return
        import time
        self.touched = time.monotonic()
        self.debounce("bright", lambda: run("brightnessctl", "-q", "set", f"{max(1, v)}%", timeout=5))

    @staticmethod
    def sinks():
        default = out("pactl", "get-default-sink", timeout=5)
        sinks, name = [], None
        for line in out("pactl", "list", "sinks", timeout=5).splitlines():
            if line.startswith("\tName: "):
                name = line.split(": ", 1)[1]
            elif line.startswith("\tDescription: ") and name:
                sinks.append((name, line.split(": ", 1)[1]))
        return default, sinks

    def fill_outputs(self, outputs=None):
        outputs = outputs or self.sinks()
        self.shown_outputs = outputs
        default, sinks = outputs
        clear(self.outputs)
        if not sinks:
            self.outputs.pack_start(label("No outputs found", "np-dim"), False, False, 0)
        for name, desc in sinks:
            low = (desc + name).lower()
            icon = I["headphones"] if ("headphone" in low or "headset" in low or "bluez" in low) else I["speaker"]
            self.outputs.pack_start(row(icon, desc, I["check"] if name == default else "",
                                        on_click=lambda n=name: self.set_output(n), active=(name == default)),
                                    False, False, 0)
        self.outputs.show_all()

    def set_output(self, sink):
        run("pactl", "set-default-sink", sink, timeout=5)
        for line in out("pactl", "list", "short", "sink-inputs", timeout=5).splitlines():
            run("pactl", "move-sink-input", line.split("\t")[0], sink, timeout=5)
        self.fill_outputs()

    def mixer(self):
        spawn("pavucontrol")
        self.close()


class WifiPanel(Panel):
    width = 320

    def __init__(self, app):
        super().__init__(app)
        self.dev = next((l.split(":")[0] for l in out("nmcli", "-t", "-f", "DEVICE,TYPE", "dev").splitlines()
                         if l.endswith(":wifi")), "")
        head = hbox()
        head.pack_start(label("Wi-Fi", "np-title"), True, True, 0)
        self.switch = Gtk.Switch()
        self.switch.set_active(out("nmcli", "radio", "wifi") == "enabled")
        self.switch_handler = self.switch.connect("notify::active", self.toggle_radio)
        head.pack_end(self.switch, False, False, 0)
        self.box.pack_start(head, False, False, 0)
        self.shown_result = None
        self.polling = False

        self.status = label("", "np-dim")
        self.status.set_line_wrap(True)
        self.status.set_max_width_chars(36)
        self.box.pack_start(self.status, False, False, 0)

        self.prompt = vbox(4)       # password entry appears here when needed
        self.box.pack_start(self.prompt, False, False, 0)

        self.list = vbox(0)
        self.box.pack_start(self.list, False, False, 0)

        self.box.pack_start(Gtk.Separator(), False, False, 0)
        self.box.pack_start(row(I["refresh"], "Scan again", on_click=self.rescan), False, False, 0)
        self.box.pack_start(row(I["cog"], "Network settings", on_click=self.settings), False, False, 0)
        self.load()
        self.live(3000, self.poll)

    @staticmethod
    def top(result):
        return (result[0], result[1][:10]) if result else None

    def busy(self):
        """Mid-connection, or asking for a password: leave the list alone."""
        return bool(self.prompt.get_children()) or self.status.get_text().endswith("…")

    def poll(self):
        """Keep the panel current: the switch, what's connected, the networks around."""
        if self.polling or self.busy():
            return
        self.polling = True

        def work():
            radio = out("nmcli", "radio", "wifi") == "enabled"
            return radio, (self.scan("no") if radio else None)

        def done(result):
            self.polling = False
            radio, nets = result
            if radio != self.switch.get_active():
                with self.switch.handler_block(self.switch_handler):
                    self.switch.set_active(radio)
                if not radio:
                    self.shown_result = None
                    self.load()
                    return
            if nets is not None and self.top(nets) != self.top(self.shown_result) and not self.busy():
                self.show_networks(nets)
        in_background(work, done)

    def say(self, text, error=False):
        self.status.set_text(text)
        self.status.set_visible(bool(text))
        ctx = self.status.get_style_context()
        (ctx.add_class if error else ctx.remove_class)("np-error")

    def shown(self):
        self.status.set_visible(bool(self.status.get_text()))

    def toggle_radio(self, sw, _param):
        state = "on" if sw.get_active() else "off"
        self.say(f"Turning Wi-Fi {state}…")
        in_background(lambda: run("nmcli", "radio", "wifi", state),
                      lambda r: (self.say("" if r[0] == 0 else r[1], r[0] != 0),
                                 timer(2500, lambda: (self.load(), False)[1]) if state == "on" else self.load()))

    def load(self, rescan="auto"):
        if out("nmcli", "radio", "wifi") != "enabled":
            clear(self.list)
            self.list.pack_start(label("Wi-Fi is off. Use the switch above to turn it on.", "np-dim"), False, False, 6)
            self.list.show_all()
            return
        if not self.list.get_children():
            self.list.pack_start(label("Looking for networks…", "np-dim"), False, False, 6)
            self.list.show_all()
        in_background(lambda: self.scan(rescan), self.show_networks)

    def scan(self, rescan):
        current = ""
        for l in out("nmcli", "-t", "-e", "no", "-f", "ACTIVE,SSID", "dev", "wifi", "list", "--rescan", "no").splitlines():
            if l.startswith("yes:"):
                current = l[4:]
        nets, seen = [], set()
        lines = out("nmcli", "-t", "-e", "no", "-f", "SIGNAL,SECURITY,SSID", "dev", "wifi", "list",
                    "--rescan", rescan, timeout=40).splitlines()
        parsed = []
        for l in lines:
            parts = l.split(":", 2)
            if len(parts) == 3 and parts[2]:
                try:
                    parsed.append((int(parts[0] or 0), parts[1], parts[2]))
                except ValueError:
                    pass
        for sig, sec, ssid in sorted(parsed, key=lambda t: -t[0]):
            if ssid not in seen:
                seen.add(ssid)
                nets.append((self.level(sig), sec, ssid))
        # By bars then name, so the order doesn't shuffle with every small signal change
        nets.sort(key=lambda t: (-t[0], t[2].lower()))
        return current, nets

    @staticmethod
    def level(sig):
        return 4 if sig >= 80 else 3 if sig >= 60 else 2 if sig >= 40 else 1 if sig >= 20 else 0

    def show_networks(self, result):
        self.shown_result = result
        current, nets = result
        clear(self.list)
        if current:
            self.list.pack_start(row(I["unlink"], f"Disconnect from {current}", on_click=self.disconnect),
                                 False, False, 0)
        if not nets:
            self.list.pack_start(label("No networks found.", "np-dim"), False, False, 6)
        for level, sec, ssid in nets[:10]:    # the 10 strongest; "Scan again" refreshes
            secure = bool(sec and sec != "--")
            right = (I["check"] + " ") if ssid == current else ""
            right += I["lock"] if secure else " "
            self.list.pack_start(row(I["wifi"][level], ssid, right, active=(ssid == current),
                                     on_click=lambda s=ssid, sec=secure: self.choose(s, sec, current)),
                                 False, False, 0)
        self.list.show_all()

    def rescan(self):
        self.say("Scanning…")
        run("nmcli", "dev", "wifi", "rescan", *(["ifname", self.dev] if self.dev else []), timeout=10)
        timer(2500, lambda: (self.say(""), self.load("no"), False)[2])

    def settings(self):
        spawn("alacritty", "--class", "nameplate-float", "--title", "Network", "-e", f"{BIN}/wifi", "edit")
        self.close()

    def disconnect(self):
        active = ""
        for l in out("nmcli", "-t", "-e", "no", "-f", "NAME,TYPE", "con", "show", "--active").splitlines():
            name, _, typ = l.rpartition(":")
            if typ == "802-11-wireless":
                active = name
                break
        if active:
            self.say("Disconnecting…")
            in_background(lambda: run("nmcli", "con", "down", "id", active),
                          lambda r: (self.say("" if r[0] == 0 else r[1], r[0] != 0), self.load("no")))

    # -- connecting --------------------------------------------------------

    def saved_for(self, ssid):
        """UUID of a usable saved connection for this network, skipping copies locked to
        another network card and hotspot profiles this laptop broadcasts itself."""
        for l in out("nmcli", "-t", "-f", "UUID,TYPE", "con", "show").splitlines():
            uuid, _, typ = l.partition(":")
            if typ != "802-11-wireless":
                continue
            fields = out("nmcli", "-g", "802-11-wireless.ssid,connection.interface-name,802-11-wireless.mode",
                         "con", "show", "uuid", uuid).splitlines() + ["", "", ""]
            ssid_, ifname, mode = fields[:3]
            if ssid_ != ssid or mode == "ap" or (ifname and self.dev and ifname != self.dev):
                continue
            return uuid
        return None

    def choose(self, ssid, secure, current):
        if ssid == current:
            self.say(f"Already connected to {ssid}.")
            return
        clear(self.prompt)
        self.say(f"Connecting to {ssid}…")
        in_background(lambda: self.connect_saved(ssid), lambda r: self.after_saved(ssid, secure, r))

    def up(self, uuid, password=None):
        args = ["nmcli", "con", "up", "uuid", uuid] + (["ifname", self.dev] if self.dev else [])
        if password is None:
            return run(*args, timeout=45)
        with tempfile.NamedTemporaryFile("w", dir=RUN, delete=True) as f:
            os.chmod(f.name, 0o600)
            f.write(f"802-11-wireless-security.psk:{password}\n")
            f.flush()
            return run(*args, "passwd-file", f.name, timeout=45)

    def connect_saved(self, ssid):
        if self.dev:
            run("nmcli", "dev", "set", self.dev, "autoconnect", "yes")
        uuid = self.saved_for(ssid)
        if not uuid:
            return ("new", None, "")
        rc, text = self.up(uuid)
        if rc == 0:
            return ("ok", uuid, "")
        if "ecret" not in text:
            # The network may have dropped out of the last scan (phone hotspots sleep when
            # nobody is connected): scan again and retry once
            run("nmcli", "dev", "wifi", "rescan", *(["ifname", self.dev] if self.dev else []), timeout=10)
            GLib.usleep(4_000_000)
            rc, text = self.up(uuid)
            if rc == 0:
                return ("ok", uuid, "")
        return ("secret" if "ecret" in text else "fail", uuid, text)

    def after_saved(self, ssid, secure, result):
        state, uuid, text = result
        if state == "ok":
            return self.connected(ssid)
        if state == "new":
            if secure:
                return self.ask_password(ssid, lambda pw: self.connect_new(ssid, pw))
            return self.connect_new(ssid, None)
        if state == "secret" and secure:
            return self.ask_password(ssid, lambda pw: self.retry_saved(ssid, uuid, pw))
        self.failed(ssid, text)

    def retry_saved(self, ssid, uuid, password):
        self.say(f"Connecting to {ssid}…")
        in_background(lambda: self.up(uuid, password),
                      lambda r: self.connected(ssid) if r[0] == 0 else self.failed(ssid, r[1]))

    def connect_new(self, ssid, password):
        self.say(f"Connecting to {ssid}…")

        def uuids():
            rc, text = run("nmcli", "-t", "-f", "UUID", "con", "show")
            return set(text.splitlines()) if rc == 0 else None

        def work():
            before = uuids()
            args = ["nmcli", "dev", "wifi", "connect", ssid]
            if password is not None:
                args += ["password", password]
            if self.dev:
                args += ["ifname", self.dev]
            rc, text = run(*args, timeout=45)
            after = uuids() if rc != 0 else None
            if before and after:
                # Remove the half-made profile with the wrong password: only connections that
                # are new since a moment ago AND belong to this network, never anything else.
                for uuid in after - before:
                    if out("nmcli", "-g", "802-11-wireless.ssid", "con", "show", "uuid", uuid) == ssid:
                        run("nmcli", "con", "delete", "uuid", uuid)
            return rc, text
        in_background(work, lambda r: self.connected(ssid) if r[0] == 0 else self.failed(ssid, r[1]))

    def ask_password(self, ssid, then):
        clear(self.prompt)
        self.say(f"Password for {ssid}:")
        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        entry.set_placeholder_text("Password")
        line = hbox(6)
        line.pack_start(entry, True, True, 0)
        go = Gtk.Button(label="Connect")
        line.pack_start(go, False, False, 0)
        self.prompt.pack_start(line, False, False, 0)

        def submit(*_):
            pw = entry.get_text()
            if pw:
                clear(self.prompt)
                then(pw)
        entry.connect("activate", submit)
        go.connect("clicked", submit)
        self.prompt.show_all()
        entry.grab_focus()

    def connected(self, ssid):
        clear(self.prompt)
        self.say(f"{I['check']}  Connected to {ssid}")
        spawn("notify-send", "-a", "Wi-Fi", f"Connected to {ssid}")
        self.load("no")

    def failed(self, ssid, text):
        text = text.split("Error: ")[-1].strip()
        if "not found" in text or "No suitable device" in text:
            text = f"{ssid} isn't in range right now. If it's a phone hotspot, open the hotspot screen on the phone and try again."
        elif "ecret" in text or "802-1X" in text:
            text = "Wrong password, or the network needs a sign-in this panel can't do (use Network settings)."
        self.say(f"Couldn't connect to {ssid}. {text}", error=True)
        self.load("no")


class BluetoothPanel(Panel):
    width = 300

    def __init__(self, app):
        super().__init__(app)
        head = hbox()
        head.pack_start(label("Bluetooth", "np-title"), True, True, 0)
        self.switch = Gtk.Switch()
        self.switch.set_active(self.powered())
        self.switch_handler = self.switch.connect("notify::active", self.toggle_power)
        self.shown_state = None
        self.polling = False
        head.pack_end(self.switch, False, False, 0)
        self.box.pack_start(head, False, False, 0)
        self.status = label("", "np-dim")
        self.status.set_line_wrap(True)
        self.status.set_max_width_chars(34)
        self.box.pack_start(self.status, False, False, 0)
        self.list = vbox(0)
        self.box.pack_start(self.list, False, False, 0)
        self.box.pack_start(Gtk.Separator(), False, False, 0)
        self.box.pack_start(row(I["plus"], "Pair a new device", on_click=self.settings), False, False, 0)
        self.box.pack_start(row(I["cog"], "Bluetooth settings", on_click=self.settings), False, False, 0)
        self.load()
        self.live(3000, self.load)

    @staticmethod
    def powered():
        return "Powered: yes" in out("bluetoothctl", "show", timeout=5)

    def say(self, text, error=False):
        self.status.set_text(text)
        self.status.set_visible(bool(text))
        ctx = self.status.get_style_context()
        (ctx.add_class if error else ctx.remove_class)("np-error")

    def shown(self):
        self.status.set_visible(bool(self.status.get_text()))

    def toggle_power(self, sw, _param):
        on = sw.get_active()

        def work():
            if on:
                run("rfkill", "unblock", "bluetooth", timeout=5)
                GLib.usleep(500_000)
            return run("bluetoothctl", "power", "on" if on else "off", timeout=10)
        in_background(work, lambda r: (self.say("" if r[0] == 0 else "Couldn't change Bluetooth.", r[0] != 0),
                                       self.load()))

    def load(self):
        """Read the state in the background (bluetoothctl is slow), then redraw if it changed."""
        if self.polling:
            return
        self.polling = True

        def work():
            if not self.powered():
                return False, []
            devices = []
            for l in out("bluetoothctl", "devices", "Paired", timeout=5).splitlines():
                parts = l.split(" ", 2)
                if len(parts) == 3 and parts[0] == "Device":
                    connected = "Connected: yes" in out("bluetoothctl", "info", parts[1], timeout=5)
                    devices.append((parts[1], parts[2], connected))
            return True, devices

        def done(state):
            self.polling = False
            if state[0] != self.switch.get_active():
                with self.switch.handler_block(self.switch_handler):
                    self.switch.set_active(state[0])
            if state != self.shown_state and not self.status.get_text().endswith("…"):
                self.show(state)
        in_background(work, done)

    def show(self, state):
        self.shown_state = state
        powered, devices = state
        clear(self.list)
        if not powered:
            self.list.pack_start(label("Bluetooth is off.", "np-dim"), False, False, 6)
        elif not devices:
            self.list.pack_start(label("No paired devices yet.", "np-dim"), False, False, 6)
        for mac, name, connected in devices:
            self.list.pack_start(row(I["bt_on"] if connected else I["bt"], name,
                                     "connected" if connected else "", active=connected,
                                     on_click=lambda m=mac, n=name, c=connected: self.toggle(m, n, c)),
                                 False, False, 0)
        self.list.show_all()

    def toggle(self, mac, name, connected):
        self.say(("Disconnecting " if connected else "Connecting to ") + name + "…")

        def work():
            if connected:
                return run("bluetoothctl", "disconnect", mac, timeout=15)
            rc, text = run("bluetoothctl", "--timeout", "15", "connect", mac, timeout=20)
            return (0 if "Connection successful" in text else 1), text
        in_background(work, lambda r: (
            self.say("" if r[0] == 0 else f"Couldn't connect to {name}. Is it switched on and nearby?", r[0] != 0),
            self.load()))

    def settings(self):
        spawn("gnome-control-center", "bluetooth", env={"XDG_CURRENT_DESKTOP": "GNOME"})
        self.close()


class DisplayPanel(Panel):
    """Screens (the monitor icon in the bar), laid out like Omarchy 4's display panel:
    which screen, brightness (only when the screen has a backlight), text size,
    scale, resolution, refresh rate, and the layout when a second screen is plugged in.
    Changes apply at once and are remembered (bin/display)."""
    width = 360
    TEXT_STOPS = (9, 10, 11, 12, 14, 16, 20)
    SCALES = ("1", "1.25", "1.6", "2")

    @staticmethod
    def scale_valid(size, value):
        """Hyprland only accepts scales that divide the mode cleanly into integer
        logical pixels, so e.g. 1.25x works on 1920x1080 but not on 1366x768."""
        try:
            w, h = (int(x) for x in size.lower().split("x"))
            s = float(value)
        except (ValueError, AttributeError):
            return True
        if s <= 0:
            return False
        return abs(w / s - round(w / s)) < 1e-9 and abs(h / s - round(h / s)) < 1e-9

    def valid_scales(self, size):
        valid = [v for v in self.SCALES if self.scale_valid(size, v)]
        return valid or ["1"]

    def __init__(self, app, route=None):
        super().__init__(app)
        self.box.set_spacing(10)
        self.chosen = route
        self.body = vbox(10)
        self.box.pack_start(self.body, False, False, 0)
        self.load()

    def load(self):
        def work():
            rc, text = run(os.path.join(BIN, "display"), timeout=15)
            try:
                return json.loads(text) if rc == 0 else None
            except ValueError:
                return None
        in_background(work, self.show)

    def show(self, data):
        clear(self.body)
        if not data or not data["screens"]:
            self.body.pack_start(label("Couldn't read the screens.", "np-dim"), False, False, 6)
            self.body.show_all()
            return
        self.data = data
        live = [m for m in data["screens"] if not m["disabled"]] or data["screens"]
        cur = next((m for m in live if m["name"] == self.chosen), None) \
            or next((m for m in live if m["internal"]), live[0])
        self.cur = cur

        # Header: the screen and what it's running at; a picker when there are several
        head = vbox(2)
        head.pack_start(label(cur["title"], "np-title"), False, False, 0)
        head.pack_start(label("%s  ·  %s Hz  ·  %s×" % (cur["size"].replace("x", "×"), cur["hz"], cur["scale"]),
                              "np-dim"), False, False, 0)
        self.body.pack_start(head, False, False, 0)
        if len(live) > 1:
            self.body.pack_start(self.chips([(m["title"], m["name"]) for m in live], cur["name"],
                                            self.pick), False, False, 0)

        if data.get("brightness") is not None and cur["internal"]:
            self.body.pack_start(self.heading("Brightness", "%d%%" % data["brightness"]), False, False, 0)
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
            sc.set_draw_value(False)
            sc.set_value(data["brightness"])
            sc.connect("value-changed", lambda s: self.debounce(
                "bright", lambda v=int(s.get_value()): run("brightnessctl", "-q", "-c", "backlight", "set", "%d%%" % v, timeout=5)))
            sc.connect("value-changed", lambda s: self.value_label.set_text("%d%%" % int(s.get_value())))
            self.value_label = self.last_value
            self.body.pack_start(sc, False, False, 0)

        # Text size: Omarchy's stops, one notch per step
        stops = self.TEXT_STOPS
        now = min(range(len(stops)), key=lambda i: abs(stops[i] - data["text"]))
        self.body.pack_start(self.heading("Text size", "%d px" % stops[now]), False, False, 0)
        text_label = self.last_value
        ts = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, len(stops) - 1, 1)
        ts.set_draw_value(False)
        ts.set_round_digits(0)
        for i in range(len(stops)):
            ts.add_mark(i, Gtk.PositionType.BOTTOM, None)
        ts.set_value(now)
        def text_changed(s):
            px = stops[int(round(s.get_value()))]
            text_label.set_text("%d px" % px)
            self.debounce("text", lambda: run(os.path.join(BIN, "display"), "text", str(px), timeout=20))
        ts.connect("value-changed", text_changed)
        self.body.pack_start(ts, False, False, 0)

        self.body.pack_start(self.heading("Scale"), False, False, 0)
        scales = self.valid_scales(cur["size"])
        if cur["scale"] not in scales:
            try:
                scales = sorted(scales + [cur["scale"]], key=float)
            except ValueError:
                scales = scales + [cur["scale"]]
        self.body.pack_start(self.chips([(v + "×", v) for v in scales], cur["scale"],
                                        lambda v: self.set("scale", v)), False, False, 0)

        sizes = []
        for size, _hz in cur["modes"]:
            if size not in sizes:
                sizes.append(size)
        sizes.sort(key=lambda t: -int(t.split("x")[0]) * int(t.split("x")[1]))
        if len(sizes) > 1:
            shown = sizes[:6] if cur["size"] in sizes[:6] else sizes[:5] + [cur["size"]]
            self.body.pack_start(self.heading("Resolution"), False, False, 0)
            self.body.pack_start(self.chips([(t.replace("x", "×"), t) for t in shown], cur["size"],
                                            lambda t: self.set_mode(t, None), per_line=3), False, False, 0)
        rates = sorted({hz for size, hz in cur["modes"] if size == cur["size"]},
                       key=lambda h: -float(h))
        rates = [("%.0f Hz" % float(h), h) for h in rates]
        if len(rates) > 1:
            near = min(rates, key=lambda r: abs(float(r[1]) - float(cur["hz"])))[1]
            self.body.pack_start(self.heading("Refresh rate"), False, False, 0)
            self.body.pack_start(self.chips(rates[:5], near, lambda h: self.set_mode(cur["size"], h)),
                                 False, False, 0)

        if len(data["screens"]) > 1:
            self.body.pack_start(self.heading("Layout"), False, False, 0)
            self.layout_rows(data["screens"])
        self.body.show_all()

    # -- pieces
    def heading(self, text, value=""):
        line = hbox()
        line.pack_start(label(text, "np-dim"), True, True, 0)
        self.last_value = label(value, "np-dim", xalign=1.0)
        line.pack_end(self.last_value, False, False, 0)
        return line

    def chips(self, items, current, on_pick, per_line=4):
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_homogeneous(True)
        across = max(1, min(per_line, len(items)))
        flow.set_min_children_per_line(across)
        flow.set_max_children_per_line(across)
        flow.set_column_spacing(6)
        flow.set_row_spacing(6)
        for text, value in items:
            b = Gtk.Button(label=text)
            b.set_hexpand(True)
            b.get_style_context().add_class("np-chip")
            if value == current:
                b.get_style_context().add_class("np-current")
            b.connect("clicked", lambda _b, v=value: on_pick(v))
            flow.add(b)
        return flow

    def debounce(self, key, fn, ms=250):
        timers = self.__dict__.setdefault("_timers", {})
        if timers.get(key):
            GLib.source_remove(timers[key])
        def fire():
            timers[key] = None
            fn()
            return False
        timers[key] = GLib.timeout_add(ms, fire)

    def pick(self, name):
        self.chosen = name
        self.show(self.data)

    def set(self, key, value):
        def work():
            return run(os.path.join(BIN, "display"), "set", self.cur["name"], key, value, timeout=15)
        def done(result):
            rc, text = result
            if rc != 0:
                spawn("notify-send", "-a", "Display", "Couldn't change the screen", text)
            self.load()
        in_background(work, done)

    def set_mode(self, size, hz):
        rates = [h for s, h in self.cur["modes"] if s == size]
        if hz is None:          # a new resolution: its fastest refresh rate
            hz = max(rates, key=float) if rates else self.cur["hz"]
        self.set("mode", "%s@%s" % (size, hz))

    def layout_rows(self, screens):
        internal = [m["name"] for m in screens if m["internal"]]
        external = [m for m in screens if not m["internal"]]
        if not internal or not external:
            return
        lap, ext = internal[0], external[0]["name"]
        ext_desc = external[0]["title"]
        options = [
            ("Extend right", [self.on(lap, "auto"), self.on(ext, "auto-right")]),
            ("Extend left", [self.on(lap, "auto"), self.on(ext, "auto-left")]),
            ("Mirror", [self.on(lap, "auto"), self.on(ext, "auto", f', mirror = "{lap}"')]),
            ("%s only" % ext_desc.split()[0], [self.on(ext, "auto"), self.off(lap)]),
            ("Laptop only", [self.on(lap, "auto"), self.off(ext)]),
            ("Reset", None),
        ]
        rules = dict(options)
        self.body.pack_start(self.chips([(t, t) for t, _ in options], None,
                                        lambda t: self.reset() if rules[t] is None else self.apply(rules[t]),
                                        per_line=3), False, False, 0)

    @staticmethod
    def on(name, pos, extra=""):
        return f'hl.monitor({{ output = "{name}", mode = "preferred", position = "{pos}", scale = 1{extra} }})'

    @staticmethod
    def off(name):
        return f'hl.monitor({{ output = "{name}", disabled = true }})'

    def apply(self, rules):
        rc, text = run("hyprctl", "eval", "; ".join(rules), timeout=10)
        if rc != 0 or (text and not text.startswith("ok")):
            spawn("notify-send", "-a", "Display", "Couldn't change the screens", text)
        self.close()

    def reset(self):
        run("hyprctl", "reload", timeout=10)
        run(os.path.join(BIN, "display"), "restore", timeout=15)
        self.close()


class PowerPanel(Panel):
    """Battery level and power profiles (click the battery icon)."""
    width = 280
    NAMES = {"power-saver": ("leaf", "Power saver", "Longest battery life"),
             "balanced": ("balance", "Balanced", "The usual mix"),
             "performance": ("rocket", "Performance", "Fastest, uses more power")}

    def __init__(self, app):
        super().__init__(app)
        supply = os.environ.get("NAMEPLATE_POWER_SUPPLY", "/sys/class/power_supply")
        self.bat = next((os.path.join(supply, d) for d in sorted(os.listdir(supply))
                         if d.startswith("BAT")), None) if os.path.isdir(supply) else None
        self.battery = vbox(4)
        self.box.pack_start(self.battery, False, False, 0)
        self.profiles = vbox(0)
        self.box.pack_start(Gtk.Separator(), False, False, 4)
        self.box.pack_start(label("Power mode", "np-title"), False, False, 0)
        self.box.pack_start(self.profiles, False, False, 0)
        self.shown_bat = self.shown_profiles = None
        self.fill_battery()
        self.fill()
        self.live(4000, self.update)

    def update(self):
        self.fill_battery()
        in_background(lambda: run("powerprofilesctl", "list", timeout=5),
                      lambda r: self.fill(r) if r != self.shown_profiles else None)

    def fill_battery(self):
        if not self.bat:
            state = None
        else:
            # time left comes from upower, which only updates every so often anyway
            state = (read(os.path.join(self.bat, "capacity")) or "?",
                     read(os.path.join(self.bat, "status")) or "Unknown")
        if state == self.shown_bat and self.battery.get_children():
            return
        self.shown_bat = state
        clear(self.battery)
        if state is None:
            self.battery.pack_start(label("No battery found", "np-title"), False, False, 0)
        else:
            level, status = state
            try:
                n = int(level)
            except ValueError:
                n = 50
            icon = I["charging"] if status in ("Charging", "Full") else I["bat"][min(10, max(0, round(n / 10)))]
            top = hbox(12)
            top.pack_start(label(icon, "np-huge"), False, False, 0)
            top.pack_start(label(f"{level}%", "np-huge"), False, False, 0)
            self.battery.pack_start(top, False, False, 0)
            self.battery.pack_start(label(battery_text(status), "np-dim"), False, False, 0)
        self.battery.show_all()

    def fill(self, result=None):
        rc, text = result or run("powerprofilesctl", "list", timeout=5)
        self.shown_profiles = (rc, text)
        clear(self.profiles)
        if rc != 0:
            self.profiles.pack_start(label("Power modes aren't available here\n(power-profiles-daemon isn't running).",
                                           "np-dim"), False, False, 4)
            self.profiles.show_all()
            return
        found = []
        for line in text.splitlines():
            m = re.match(r"^\s*(\*)?\s*([a-z-]+):\s*$", line)
            if m:
                found.append((m.group(2), bool(m.group(1))))
        for name, active in sorted(found, key=lambda p: list(self.NAMES).index(p[0]) if p[0] in self.NAMES else 9):
            icon, title, hint = self.NAMES.get(name, ("cog", name.capitalize(), ""))
            b = row(I[icon], title, I["check"] if active else "", active=active,
                    on_click=lambda n=name: self.set(n))
            if hint:
                b.set_tooltip_text(hint)
            self.profiles.pack_start(b, False, False, 0)
        self.profiles.show_all()

    def set(self, name):
        rc, text = run("powerprofilesctl", "set", name, timeout=10)
        if rc != 0:
            spawn("notify-send", "-a", "Power", "Couldn't change the power mode", text)
        self.fill()


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def battery_text(status):
    """'Charging, full in 1 h 20 min' / '3 h 05 min left' from UPower, if it knows."""
    dev = next((l for l in out("upower", "-e", timeout=5).splitlines() if "BAT" in l), "")
    info = out("upower", "-i", dev, timeout=5) if dev else ""
    m = re.search(r"time to (empty|full):\s*([\d.,]+)\s*(\w+)", info)
    when = ""
    if m:
        value, unit = float(m.group(2).replace(",", ".")), m.group(3)
        minutes = value * 60 if unit.startswith("hour") else value
        when = f"{int(minutes // 60)} h {int(minutes % 60):02d} min" if minutes >= 60 else f"{int(minutes)} min"
    if status == "Charging":
        return f"Charging, full in {when}" if when else "Charging"
    if status == "Full":
        return "Fully charged"
    if status == "Discharging":
        return f"{when} left" if when else "On battery"
    return "Plugged in, not charging" if status == "Not charging" else status


class Carousel(Gtk.DrawingArea):
    """Omarchy 4's picker carousel, drawn with cairo: the chosen image big in the middle,
    the others as tall slanted slices behind it on both sides, dimmed and overlapping.
    Moving slides everything along smoothly. items: [(key, title, draw_source)], where
    draw_source is an image path, or a function(cr, w, h) that paints a preview."""
    W, H = 768, 475             # the chosen one
    SW, SH = 108, 432           # the slices
    SPACING, SKEW, RADIUS = -30, 28, 8

    def __init__(self, items, selected, on_select, on_apply, width):
        super().__init__()
        self.items, self.sel, self.pos = items, selected, float(selected)
        self.on_select, self.on_apply = on_select, on_apply
        self.width = width
        self.pix = {}                     # key -> GdkPixbuf at the big size
        self.gen = 0                      # thumbnail passes: only the latest one stores
        self.ticking = False
        self.colors = theme_colors()
        self.set_size_request(width, self.H + 8)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.SCROLL_MASK
                        | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.connect("draw", self.draw)
        self.connect("button-press-event", self.clicked)
        self.connect("scroll-event", self.scrolled)
        self.load_around()

    # -- images: the chosen one first, then its neighbours, decoded in a worker
    # thread. Decoding on the main loop used to freeze the picker on every
    # move, with 4K wallpapers taking hundreds of ms each. A source may be an
    # image path, a painter function(cr, w, h), or (image path, painter) for a
    # picture with something painted over it (the theme previews).
    @staticmethod
    def image_path(source):
        if isinstance(source, str):
            return source
        if isinstance(source, tuple):
            return source[0]
        return None

    def load_around(self):
        self.gen = getattr(self, "gen", 0) + 1
        gen = self.gen
        order = sorted(range(len(self.items)), key=lambda i: abs(i - self.sel))
        want = [i for i in order if abs(i - self.sel) <= self.RADIUS and self.items[i][0] not in self.pix
                and self.image_path(self.items[i][2])]
        if not want:
            return

        def work():
            for i in want:
                if gen != self.gen:
                    return            # moved on; a newer pass owns loading now
                try:
                    key, _title, source = self.items[i]
                except IndexError:
                    return
                if key in self.pix:
                    continue
                pix = thumbnail(self.image_path(source), self.W, self.H)
                if gen == self.gen:
                    GLib.idle_add(self.store, key, pix)

        threading.Thread(target=work, daemon=True).start()

    def store(self, key, pix):
        if key not in self.pix:
            self.pix[key] = pix     # None too: don't retry a broken file forever
            self.queue_draw()
        return False

    # -- moving
    def select(self, i, animate=True):
        i = max(0, min(len(self.items) - 1, i))
        if i == self.sel:
            return
        self.sel = i
        self.on_select(i)
        self.load_around()
        if not animate:
            self.pos = float(i)
        if not self.ticking:
            self.ticking = True
            GLib.timeout_add(33, self.tick)
        self.queue_draw()

    def tick(self):
        gap = self.sel - self.pos
        if abs(gap) < 0.01:
            self.pos = float(self.sel)
            self.ticking = False
            self.queue_draw()
            return False
        self.pos += gap * 0.22            # ease out: quick at first, settling gently
        self.queue_draw()
        return True

    # -- layout: where an item sits at a (fractional) distance r from the middle
    def slot(self, r):
        step = self.SW + self.SPACING
        px = (self.width - self.W) / 2
        def far(k):
            if k < 0:
                return (px + k * step, (self.H - self.SH) / 2, self.SW, self.SH)
            return (px + self.W + self.SPACING + (k - 1) * step, (self.H - self.SH) / 2, self.SW, self.SH)
        if abs(r) >= 1:
            return far(r)
        a, b, t = (px, 0, self.W, self.H), far(1 if r > 0 else -1), abs(r)
        return tuple(a[n] + (b[n] - a[n]) * t for n in range(4))

    @staticmethod
    def rgb(hexcolor, alpha=1.0):
        h = hexcolor.lstrip("#")
        try:
            return tuple(int(h[n:n + 2], 16) / 255 for n in (0, 2, 4)) + (alpha,)
        except ValueError:
            return (0.5, 0.5, 0.5, alpha)

    def outline(self, cr, x, y, w, h):
        k = self.SKEW
        cr.move_to(x + k, y)
        cr.line_to(x + w, y)
        cr.line_to(x + w - k, y + h)
        cr.line_to(x, y + h)
        cr.close_path()

    def draw(self, _w, cr):
        visible = [(i, i - self.pos) for i in range(len(self.items)) if abs(i - self.pos) <= self.RADIUS + 1]
        visible.sort(key=lambda v: -abs(v[1]))          # far ones first, the chosen one on top
        self.hits = []
        for i, r in visible:
            x, y, w, h = self.slot(r)
            y += 4
            if x + w < 0 or x > self.width:
                continue
            key, _title, source = self.items[i]
            near = max(0.0, 1 - abs(r))                   # 1 for the chosen one, 0 for a slice
            cr.save()
            self.outline(cr, x, y, w, h)
            cr.clip()
            cr.set_source_rgba(*self.rgb(self.colors["background"]))
            cr.paint()
            pix = self.pix.get(key)
            if pix is not None:
                pw, ph = pix.get_width(), pix.get_height()
                sc = max(w / pw, h / ph)
                cr.save()
                cr.translate(x + (w - pw * sc) / 2, y + (h - ph * sc) / 2)
                cr.scale(sc, sc)
                Gdk.cairo_set_source_pixbuf(cr, pix, 0, 0)
                cr.paint()
                cr.restore()
            painter = source if callable(source) else source[1] if isinstance(source, tuple) else None
            if painter is not None:
                cr.save()
                cr.translate(x, y)
                painter(cr, w, h, pix)
                cr.restore()
            cr.set_source_rgba(*self.rgb(self.colors["background"], 0.42 * (1 - near)))
            cr.paint()
            cr.restore()
            self.outline(cr, x, y, w, h)
            if near > 0.5:
                cr.set_source_rgba(*self.rgb(self.colors["accent"]))
                cr.set_line_width(3)
            else:
                cr.set_source_rgba(*self.rgb(self.colors["muted"]))
                cr.set_line_width(1)
            cr.stroke()
            self.hits.append((i, x, y, w, h))
        return False

    def clicked(self, _w, event):
        for i, x, y, w, h in reversed(self.hits):       # the topmost first
            if x <= event.x <= x + w and y <= event.y <= y + h:
                if i == self.sel:
                    self.on_apply(i)
                else:
                    self.select(i)
                return True
        return False

    def scrolled(self, _w, event):
        ok, dx, dy = event.get_scroll_deltas()
        step = None
        if event.direction in (Gdk.ScrollDirection.DOWN, Gdk.ScrollDirection.RIGHT):
            step = 1
        elif event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT):
            step = -1
        elif ok and (dx or dy):
            step = 1 if (dx or dy) > 0 else -1
        if step:
            self.select(self.sel + step)
        return True

    def key(self, event):
        k = event.keyval
        if k in (Gdk.KEY_Left, Gdk.KEY_h, Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab):
            self.select(self.sel - 1)
        elif k in (Gdk.KEY_Right, Gdk.KEY_l, Gdk.KEY_Down, Gdk.KEY_Tab):
            self.select(self.sel + 1)
        elif k == Gdk.KEY_Home:
            self.select(0)
        elif k == Gdk.KEY_End:
            self.select(len(self.items) - 1)
        elif k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            self.on_apply(self.sel)
        else:
            return False
        return True


def screen_width():
    """Width of the screen the panels open on (the one with the pointer)."""
    display = Gdk.Display.get_default()
    try:
        seat = display.get_default_seat()
        _screen, x, y = seat.get_pointer().get_position()
        mon = display.get_monitor_at_point(x, y)
    except Exception:
        mon = display.get_monitor(0)
    return mon.get_geometry().width if mon else 1366


class PickerPanel(Panel):
    """Base for the wallpaper and theme pickers: a carousel floating over the desktop,
    with the chosen one's name under it. Arrows or scrolling move, Enter or a click on
    the big one applies, Escape closes."""
    anchor = "middle"
    bare = True                   # no box around it: it floats over the desktop

    def build(self, items, selected, hint):
        width = min(screen_width() - 80, Carousel.W + 13 * (Carousel.SW + Carousel.SPACING) + 40)
        self.width = width
        self.items = items
        self.box.set_spacing(14)
        try:
            gi.require_foreign("cairo")       # the carousel draws with cairo
        except ImportError:
            items, hint = [], "The picker needs one more package:  sudo apt install python3-gi-cairo"
        if not items:
            self.box.pack_start(label(hint, "np-picker-name", xalign=0.5), False, False, 0)
            return
        self.carousel = Carousel(items, selected, self.selected, self.apply, width)
        self.box.pack_start(self.carousel, False, False, 0)
        self.name = label(items[selected][1], "np-picker-name", xalign=0.5)
        self.box.pack_start(self.name, False, False, 0)
        self.box.pack_start(label(hint, "np-picker-hint", xalign=0.5), False, False, 0)

    def selected(self, i):
        self.name.set_text(self.items[i][1])

    def on_key(self, event):
        return bool(getattr(self, "carousel", None)) and self.carousel.key(event)

    def apply(self, i):
        raise NotImplementedError


class WallpaperPanel(PickerPanel):
    """Wallpapers (double-click the desktop): Omarchy 4's slanted carousel."""

    def __init__(self, app):
        super().__init__(app)
        images = out(f"{BIN}/wallpaper", "list", timeout=10).splitlines()
        current = read(os.path.expanduser("~/.config/nameplate/wallpaper-current")) or \
            os.path.expanduser("~/.config/nameplate/wallpaper.png")
        if current not in images and os.path.exists(current):
            images.insert(0, current)
        items = [(p, self.title(p), p) for p in images]
        sel = images.index(current) if current in images else 0
        self.build(items, sel, "Enter or click to use it  ·  arrows or scroll to browse  ·  "
                   "add your own in ~/Pictures/Wallpapers" if len(images) > 1 else
                   "Put images in ~/Pictures/Wallpapers, or get Omarchy's: ~/.config/nameplate/bin/get-omarchy-wallpapers")

    @staticmethod
    def title(path):
        name = os.path.splitext(os.path.basename(path))[0]
        name = re.sub(r"^\d+[-_ ]*", "", name) or name           # Omarchy's "1-name" numbering
        return name.replace("-", " ").replace("_", " ").strip().capitalize()

    def apply(self, i):
        path = self.items[i][0]
        in_background(lambda: run(f"{BIN}/wallpaper", "set", path, timeout=10))
        self.close()


def thumbnail(path, w, h):
    """Cropped thumbnail, cached in ~/.cache/nameplate/thumbs."""
    import hashlib
    from gi.repository import GdkPixbuf
    try:
        key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}:{w}x{h}".encode()).hexdigest()
    except OSError:
        return None
    cache = os.path.expanduser(f"~/.cache/nameplate/thumbs/{key}.png")
    try:
        return GdkPixbuf.Pixbuf.new_from_file(cache)
    except GLib.Error:
        pass
    try:
        info = GdkPixbuf.Pixbuf.get_file_info(path)
        iw, ih = info[1], info[2]
        s = max(w / iw, h / ih)
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, max(w, math.ceil(iw * s)), max(h, math.ceil(ih * s)), False)
        pix = pix.new_subpixbuf((pix.get_width() - w) // 2, (pix.get_height() - h) // 2, w, h).copy()
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        pix.savev(cache, "png", [], [])
        return pix
    except (GLib.Error, TypeError, ZeroDivisionError):
        return None



class ClipboardPanel(Panel):
    """Recent copies (SUPER + CTRL + V). Click one to copy it again, then paste as usual."""
    width = 420
    anchor = "middle"
    LIMIT = 60

    def __init__(self, app):
        super().__init__(app)
        head = hbox()
        head.pack_start(label("Clipboard history", "np-title"), True, True, 0)
        self.box.pack_start(head, False, False, 0)
        self.search = Gtk.SearchEntry()
        self.search.get_style_context().add_class("np-search")
        self.search.set_placeholder_text("Search")
        self.search.connect("search-changed", lambda *_: self.fill())
        self.search.connect("activate", lambda *_: self.pick_first())
        self.box.pack_start(self.search, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(360)
        self.list = vbox(0)
        scroll.add(self.list)
        self.box.pack_start(scroll, True, True, 0)
        self.box.pack_start(Gtk.Separator(), False, False, 0)
        foot = hbox()
        foot.pack_start(label("Click to copy, then paste with Ctrl+V", "np-dim"), True, True, 0)
        foot.pack_end(row(I["trash"], "Clear", on_click=self.clear_all), False, False, 0)
        self.box.pack_start(foot, False, False, 0)
        self.entries = []
        self.load()

    def shown(self):
        self.search.grab_focus()

    def load(self):
        rc, text = run("cliphist", "list", timeout=10)
        self.entries = text.splitlines() if rc == 0 else []
        self.missing = rc == 127
        self.fill()

    def fill(self):
        clear(self.list)
        if self.missing:
            self.list.pack_start(label("cliphist isn't installed. Run the installer again.", "np-dim"), False, False, 6)
        query = self.search.get_text().lower()
        shown = 0
        for line in self.entries:
            _, _, preview = line.partition("\t")
            if query and query not in preview.lower():
                continue
            m = re.match(r"\[\[ binary data .*?(\w+) (\d+x\d+) \]\]", preview)
            text = f"Image  {m.group(2)}  ({m.group(1)})" if m else " ".join(preview.split())
            icon = I["image"] if m or preview.startswith("[[ binary") else I["clip"]
            self.list.pack_start(row(icon, text or "(empty)", on_click=lambda l=line: self.pick(l)), False, False, 0)
            shown += 1
            if shown >= self.LIMIT:
                break
        if not shown and not self.missing:
            self.list.pack_start(label("Nothing yet. Things you copy show up here." if not query else "No matches.",
                                       "np-dim"), False, False, 6)
        self.list.show_all()

    def pick_first(self):
        query = self.search.get_text().lower()
        for line in self.entries:
            if not query or query in line.partition("\t")[2].lower():
                return self.pick(line)

    def pick(self, line):
        try:
            data = subprocess.run(["cliphist", "decode"], input=(line + "\n").encode(),
                                  capture_output=True, timeout=10).stdout
            subprocess.run(["wl-copy"], input=data, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            return
        spawn("notify-send", "-a", "Clipboard", "-t", "1500", "Copied. Paste with Ctrl+V")
        self.close()

    def clear_all(self):
        run("cliphist", "wipe", timeout=10)
        self.load()


# Everyday words for emoji whose official Unicode names don't say what people search for
EMOJI_WORDS = {

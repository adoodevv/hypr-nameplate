#!/usr/bin/python3
"""hypr-nameplate panels not yet moved to Rust.

    panel KIND ...      same as `nameplate-shell panel KIND ...`, which opens every panel:
                        the ones ported to Rust itself, the rest through this program
    panel daemon        this program's background half, which nameplate-shell's panel
                        daemon starts and talks to over nameplate-panel-py.sock

Clicking anywhere outside a panel, or pressing Escape, closes it. Clicking the same
bar icon again closes it too; clicking a different icon switches panels.

Uses the system Python on purpose (/usr/bin/python3): it has the GTK bindings, while a
conda or virtualenv python3 earlier in PATH usually does not.
"""
import os
import socket
import subprocess
import sys
import tempfile

RUN = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
SOCK = os.path.join(RUN, "nameplate-panel-py.sock")     # this program's daemon
FRONT = os.path.join(RUN, "nameplate-panel.sock")       # nameplate-shell's, which opens every panel
RUST = os.path.expanduser("~/.config/nameplate/bin/nameplate-shell")


def send(message, path=SOCK):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            s.connect(path)
            s.sendall(message.encode())
        return True
    except OSError:
        return False


def client():
    """Everything but `panel daemon` is nameplate-shell's to handle."""
    if sys.argv[1:2] != ["daemon"]:
        os.execv(RUST, [RUST, "panel", *sys.argv[1:]])


if __name__ == "__main__":
    client()


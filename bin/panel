def theme_colors():
    """The current theme's colours (written by bin/theme), Tokyo Night if there are none."""
    colors = {"mode": "dark", "background": "#1a1b26", "selection": "#292e42", "muted": "#414868",
              "dark_foreground": "#565f89", "accent": "#7aa2f7", "foreground": "#a9b1d6",
              "bright_foreground": "#c0caf5", "red": "#f7768e"}
    try:
        with open(os.path.expanduser("~/.config/nameplate/colors.toml")) as f:
            for line in f:
                m = re.match(r'\s*(\w+)\s*=\s*"([^"]*)"', line)
                if m:
                    colors[m.group(1)] = m.group(2)
    except OSError:
        pass
    return colors


STYLE = None


def install_css():
    """Load (or reload, after a theme or font change) the panels' look."""
    global STYLE
    screen = Gdk.Screen.get_default()
    if STYLE:
        Gtk.StyleContext.remove_provider_for_screen(screen, STYLE)
    STYLE = Gtk.CssProvider()
    css, light = themed_css()
    STYLE.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(screen, STYLE, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", not light)


def themed_css():
    c = theme_colors()
    names = {"bg": "background", "selection": "selection", "muted": "muted", "fg_dim": "dark_foreground",
             "accent": "accent", "fg": "foreground", "fg_bright": "bright_foreground", "red": "red"}
    head = "".join("@define-color %s %s;\n" % (k, c[v]) for k, v in names.items())
    font = read(os.path.expanduser("~/.config/nameplate/font")) or "JetBrainsMono Nerd Font"
    css = CSS.replace('"JetBrainsMono Nerd Font"', '"%s"' % font.replace('"', ""))
    return (head + css).encode(), c["mode"] == "light"



# ----------------------------------------------------------------- helpers --

def run(*args, timeout=25, env=None):
    """Run a command, return (exit code, combined output)."""
    try:
        # errors="replace": output that isn't valid UTF-8 (cliphist previews cut
        # mid-character, odd file names) must not take a whole panel down.
        p = subprocess.run(args, capture_output=True, text=True, encoding="utf-8", errors="replace",
                           timeout=timeout, env={**os.environ, **(env or {})})
        return p.returncode, (p.stdout + p.stderr).strip()
    except FileNotFoundError:
        return 127, f"{args[0]} is not installed"
    except OSError as e:
        return 126, str(e)
    except subprocess.TimeoutExpired:
        return 124, "timed out"


def out(*args, **kw):
    rc, text = run(*args, **kw)
    return text if rc == 0 else ""


def spawn(*args, env=None):
    subprocess.Popen(args, start_new_session=True, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, env={**os.environ, **(env or {})})


CURRENT = None     # the App on screen
DAEMON = None      # set when running in the background (panel daemon)


def alive(app):
    return app is not None and app is CURRENT and not app.closed


def in_background(work, done=None):
    """Run work() in a thread, then done(result) on the GTK main thread, unless the
    panel that asked has been closed in the meantime."""
    app = CURRENT

    def target():
        try:
            result = work()
        except Exception:
            traceback.print_exc()
            return
        if done:
            GLib.idle_add(lambda: (alive(app) and done(result), False)[1])
    threading.Thread(target=target, daemon=True).start()


def timer(ms, fn):
    """GLib.timeout_add that stops by itself once its panel is closed."""
    app = CURRENT
    return GLib.timeout_add(ms, lambda: bool(alive(app) and fn()))


def open_panel(kind, route=None):
    """Switch to another panel (from the menu, or to redraw one)."""
    if DAEMON:
        GLib.idle_add(lambda: (DAEMON.open(kind, route), False)[1])
    else:
        spawn(RUST, "panel", kind, *([route] if route else []))


def label(text="", *classes, xalign=0.0, ellipsize=False, width=None):
    w = Gtk.Label(label=text, xalign=xalign)
    for c in classes:
        w.get_style_context().add_class(c)
    if ellipsize:
        from gi.repository import Pango
        w.set_ellipsize(Pango.EllipsizeMode.END)
    if width:
        w.set_max_width_chars(width)
        w.set_width_chars(min(width, 10))
    return w


def hbox(spacing=8):
    return Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)


def vbox(spacing=4):
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)


def row(icon, text, right="", on_click=None, active=False, dim=False):
    """A full-width clickable row: icon, text, optional right-hand text."""
    b = Gtk.Button()
    box = hbox(10)
    box.pack_start(label(icon, "np-icon"), False, False, 0)
    box.pack_start(label(text, ellipsize=True, width=26), True, True, 0)
    if right:
        box.pack_end(label(right, "np-dim"), False, False, 0)
    b.add(box)
    if active:
        b.get_style_context().add_class("np-active")
    if dim:
        b.get_style_context().add_class("np-dim")
    if on_click:
        b.connect("clicked", lambda *_: on_click())
    return b


def icon_button(icon, on_click, *classes, tooltip=None):
    b = Gtk.Button(label=icon)
    for c in ("np-round",) + classes:
        b.get_style_context().add_class(c)
    if tooltip:
        b.set_tooltip_text(tooltip)
    b.connect("clicked", lambda *_: on_click())
    return b


def clear(box):
    for child in box.get_children():
        box.remove(child)


# ------------------------------------------------------------------ panels --

class Panel:
    """Base: builds content into self.box; refresh() may be called periodically."""
    width = 300
    anchor = "right"          # "right" or "center"

    def __init__(self, app):
        self.app = app
        self.box = vbox(6)

    def close(self):
        self.app.quit()

    def shown(self):
        pass

    def live(self, ms, fn):
        """Call fn every ms while the panel is open (to keep it up to date)."""
        timer(ms, lambda: (fn(), True)[1])

    def cleanup(self):
        """Called when the panel closes."""


class DisplayPanel(Panel):
    """Screens (the monitor icon in the bar), laid out like Omarchy 4's display panel:
    which screen, brightness (only when the screen has a backlight), text size,
    scale, resolution, refresh rate, and the layout when a second screen is plugged in.
    Changes apply at once and are remembered (bin/display)."""
    width = 360
    TEXT_STOPS = (9, 10, 11, 12, 14, 16, 20)
    SCALES = ("1", "1.25", "1.6", "2")

    @staticmethod
    def scale_valid(size, value):
        """Hyprland only accepts scales that divide the mode cleanly into integer
        logical pixels, so e.g. 1.25x works on 1920x1080 but not on 1366x768."""
        try:
            w, h = (int(x) for x in size.lower().split("x"))
            s = float(value)
        except (ValueError, AttributeError):
            return True
        if s <= 0:
            return False
        return abs(w / s - round(w / s)) < 1e-9 and abs(h / s - round(h / s)) < 1e-9

    def valid_scales(self, size):
        valid = [v for v in self.SCALES if self.scale_valid(size, v)]
        return valid or ["1"]

    def __init__(self, app, route=None):
        super().__init__(app)
        self.box.set_spacing(10)
        self.chosen = route
        self.body = vbox(10)
        self.box.pack_start(self.body, False, False, 0)
        self.load()

    def load(self):
        def work():
            rc, text = run(os.path.join(BIN, "display"), timeout=15)
            try:
                return json.loads(text) if rc == 0 else None
            except ValueError:
                return None
        in_background(work, self.show)

    def show(self, data):
        clear(self.body)
        if not data or not data["screens"]:
            self.body.pack_start(label("Couldn't read the screens.", "np-dim"), False, False, 6)
            self.body.show_all()
            return
        self.data = data
        live = [m for m in data["screens"] if not m["disabled"]] or data["screens"]
        cur = next((m for m in live if m["name"] == self.chosen), None) \
            or next((m for m in live if m["internal"]), live[0])
        self.cur = cur

        # Header: the screen and what it's running at; a picker when there are several
        head = vbox(2)
        head.pack_start(label(cur["title"], "np-title"), False, False, 0)
        head.pack_start(label("%s  ·  %s Hz  ·  %s×" % (cur["size"].replace("x", "×"), cur["hz"], cur["scale"]),
                              "np-dim"), False, False, 0)
        self.body.pack_start(head, False, False, 0)
        if len(live) > 1:
            self.body.pack_start(self.chips([(m["title"], m["name"]) for m in live], cur["name"],
                                            self.pick), False, False, 0)

        if data.get("brightness") is not None and cur["internal"]:
            self.body.pack_start(self.heading("Brightness", "%d%%" % data["brightness"]), False, False, 0)
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
            sc.set_draw_value(False)
            sc.set_value(data["brightness"])
            sc.connect("value-changed", lambda s: self.debounce(
                "bright", lambda v=int(s.get_value()): run("brightnessctl", "-q", "-c", "backlight", "set", "%d%%" % v, timeout=5)))
            sc.connect("value-changed", lambda s: self.value_label.set_text("%d%%" % int(s.get_value())))
            self.value_label = self.last_value
            self.body.pack_start(sc, False, False, 0)

        # Text size: Omarchy's stops, one notch per step
        stops = self.TEXT_STOPS
        now = min(range(len(stops)), key=lambda i: abs(stops[i] - data["text"]))
        self.body.pack_start(self.heading("Text size", "%d px" % stops[now]), False, False, 0)
        text_label = self.last_value
        ts = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, len(stops) - 1, 1)
        ts.set_draw_value(False)
        ts.set_round_digits(0)
        for i in range(len(stops)):
            ts.add_mark(i, Gtk.PositionType.BOTTOM, None)
        ts.set_value(now)
        def text_changed(s):
            px = stops[int(round(s.get_value()))]
            text_label.set_text("%d px" % px)
            self.debounce("text", lambda: run(os.path.join(BIN, "display"), "text", str(px), timeout=20))
        ts.connect("value-changed", text_changed)
        self.body.pack_start(ts, False, False, 0)

        self.body.pack_start(self.heading("Scale"), False, False, 0)
        scales = self.valid_scales(cur["size"])
        if cur["scale"] not in scales:
            try:
                scales = sorted(scales + [cur["scale"]], key=float)
            except ValueError:
                scales = scales + [cur["scale"]]
        self.body.pack_start(self.chips([(v + "×", v) for v in scales], cur["scale"],
                                        lambda v: self.set("scale", v)), False, False, 0)

        sizes = []
        for size, _hz in cur["modes"]:
            if size not in sizes:
                sizes.append(size)
        sizes.sort(key=lambda t: -int(t.split("x")[0]) * int(t.split("x")[1]))
        if len(sizes) > 1:
            shown = sizes[:6] if cur["size"] in sizes[:6] else sizes[:5] + [cur["size"]]
            self.body.pack_start(self.heading("Resolution"), False, False, 0)
            self.body.pack_start(self.chips([(t.replace("x", "×"), t) for t in shown], cur["size"],
                                            lambda t: self.set_mode(t, None), per_line=3), False, False, 0)
        rates = sorted({hz for size, hz in cur["modes"] if size == cur["size"]},
                       key=lambda h: -float(h))
        rates = [("%.0f Hz" % float(h), h) for h in rates]
        if len(rates) > 1:
            near = min(rates, key=lambda r: abs(float(r[1]) - float(cur["hz"])))[1]
            self.body.pack_start(self.heading("Refresh rate"), False, False, 0)
            self.body.pack_start(self.chips(rates[:5], near, lambda h: self.set_mode(cur["size"], h)),
                                 False, False, 0)

        if len(data["screens"]) > 1:
            self.body.pack_start(self.heading("Layout"), False, False, 0)
            self.layout_rows(data["screens"])
        self.body.show_all()

    # -- pieces
    def heading(self, text, value=""):
        line = hbox()
        line.pack_start(label(text, "np-dim"), True, True, 0)
        self.last_value = label(value, "np-dim", xalign=1.0)
        line.pack_end(self.last_value, False, False, 0)
        return line

    def chips(self, items, current, on_pick, per_line=4):
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_homogeneous(True)
        across = max(1, min(per_line, len(items)))
        flow.set_min_children_per_line(across)
        flow.set_max_children_per_line(across)
        flow.set_column_spacing(6)
        flow.set_row_spacing(6)
        for text, value in items:
            b = Gtk.Button(label=text)
            b.set_hexpand(True)
            b.get_style_context().add_class("np-chip")
            if value == current:
                b.get_style_context().add_class("np-current")
            b.connect("clicked", lambda _b, v=value: on_pick(v))
            flow.add(b)
        return flow

    def debounce(self, key, fn, ms=250):
        timers = self.__dict__.setdefault("_timers", {})
        if timers.get(key):
            GLib.source_remove(timers[key])
        def fire():
            timers[key] = None
            fn()
            return False
        timers[key] = GLib.timeout_add(ms, fire)

    def pick(self, name):
        self.chosen = name
        self.show(self.data)

    def set(self, key, value):
        def work():
            return run(os.path.join(BIN, "display"), "set", self.cur["name"], key, value, timeout=15)
        def done(result):
            rc, text = result
            if rc != 0:
                spawn("notify-send", "-a", "Display", "Couldn't change the screen", text)
            self.load()
        in_background(work, done)

    def set_mode(self, size, hz):
        rates = [h for s, h in self.cur["modes"] if s == size]
        if hz is None:          # a new resolution: its fastest refresh rate
            hz = max(rates, key=float) if rates else self.cur["hz"]
        self.set("mode", "%s@%s" % (size, hz))

    def layout_rows(self, screens):
        internal = [m["name"] for m in screens if m["internal"]]
        external = [m for m in screens if not m["internal"]]
        if not internal or not external:
            return
        lap, ext = internal[0], external[0]["name"]
        ext_desc = external[0]["title"]
        options = [
            ("Extend right", [self.on(lap, "auto"), self.on(ext, "auto-right")]),
            ("Extend left", [self.on(lap, "auto"), self.on(ext, "auto-left")]),
            ("Mirror", [self.on(lap, "auto"), self.on(ext, "auto", f', mirror = "{lap}"')]),
            ("%s only" % ext_desc.split()[0], [self.on(ext, "auto"), self.off(lap)]),
            ("Laptop only", [self.on(lap, "auto"), self.off(ext)]),
            ("Reset", None),
        ]
        rules = dict(options)
        self.body.pack_start(self.chips([(t, t) for t, _ in options], None,
                                        lambda t: self.reset() if rules[t] is None else self.apply(rules[t]),
                                        per_line=3), False, False, 0)

    @staticmethod
    def on(name, pos, extra=""):
        return f'hl.monitor({{ output = "{name}", mode = "preferred", position = "{pos}", scale = 1{extra} }})'

    @staticmethod
    def off(name):
        return f'hl.monitor({{ output = "{name}", disabled = true }})'

    def apply(self, rules):
        rc, text = run("hyprctl", "eval", "; ".join(rules), timeout=10)
        if rc != 0 or (text and not text.startswith("ok")):
            spawn("notify-send", "-a", "Display", "Couldn't change the screens", text)
        self.close()

    def reset(self):
        run("hyprctl", "reload", timeout=10)
        run(os.path.join(BIN, "display"), "restore", timeout=15)
        self.close()


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


class Carousel(Gtk.DrawingArea):
    """Omarchy 4's picker carousel, drawn with cairo: the chosen image big in the middle,
    the others as tall slanted slices behind it on both sides, dimmed and overlapping.
    Moving slides everything along smoothly. items: [(key, title, draw_source)], where
    draw_source is an image path, or a function(cr, w, h) that paints a preview."""
    W, H = 768, 475             # the chosen one
    SW, SH = 108, 432           # the slices
    SPACING, SKEW, RADIUS = -30, 28, 8

    def __init__(self, items, selected, on_select, on_apply, width):
        super().__init__()
        self.items, self.sel, self.pos = items, selected, float(selected)
        self.on_select, self.on_apply = on_select, on_apply
        self.width = width
        self.pix = {}                     # key -> GdkPixbuf at the big size
        self.gen = 0                      # thumbnail passes: only the latest one stores
        self.ticking = False
        self.colors = theme_colors()
        self.set_size_request(width, self.H + 8)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.SCROLL_MASK
                        | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.connect("draw", self.draw)
        self.connect("button-press-event", self.clicked)
        self.connect("scroll-event", self.scrolled)
        self.load_around()

    # -- images: the chosen one first, then its neighbours, decoded in a worker
    # thread. Decoding on the main loop used to freeze the picker on every
    # move, with 4K wallpapers taking hundreds of ms each. A source may be an
    # image path, a painter function(cr, w, h), or (image path, painter) for a
    # picture with something painted over it (the theme previews).
    @staticmethod
    def image_path(source):
        if isinstance(source, str):
            return source
        if isinstance(source, tuple):
            return source[0]
        return None

    def load_around(self):
        self.gen = getattr(self, "gen", 0) + 1
        gen = self.gen
        order = sorted(range(len(self.items)), key=lambda i: abs(i - self.sel))
        want = [i for i in order if abs(i - self.sel) <= self.RADIUS and self.items[i][0] not in self.pix
                and self.image_path(self.items[i][2])]
        if not want:
            return

        def work():
            for i in want:
                if gen != self.gen:
                    return            # moved on; a newer pass owns loading now
                try:
                    key, _title, source = self.items[i]
                except IndexError:
                    return
                if key in self.pix:
                    continue
                pix = thumbnail(self.image_path(source), self.W, self.H)
                if gen == self.gen:
                    GLib.idle_add(self.store, key, pix)

        threading.Thread(target=work, daemon=True).start()

    def store(self, key, pix):
        if key not in self.pix:
            self.pix[key] = pix     # None too: don't retry a broken file forever
            self.queue_draw()
        return False

    # -- moving
    def select(self, i, animate=True):
        i = max(0, min(len(self.items) - 1, i))
        if i == self.sel:
            return
        self.sel = i
        self.on_select(i)
        self.load_around()
        if not animate:
            self.pos = float(i)
        if not self.ticking:
            self.ticking = True
            GLib.timeout_add(33, self.tick)
        self.queue_draw()

    def tick(self):
        gap = self.sel - self.pos
        if abs(gap) < 0.01:
            self.pos = float(self.sel)
            self.ticking = False
            self.queue_draw()
            return False
        self.pos += gap * 0.22            # ease out: quick at first, settling gently
        self.queue_draw()
        return True

    # -- layout: where an item sits at a (fractional) distance r from the middle
    def slot(self, r):
        step = self.SW + self.SPACING
        px = (self.width - self.W) / 2
        def far(k):
            if k < 0:
                return (px + k * step, (self.H - self.SH) / 2, self.SW, self.SH)
            return (px + self.W + self.SPACING + (k - 1) * step, (self.H - self.SH) / 2, self.SW, self.SH)
        if abs(r) >= 1:
            return far(r)
        a, b, t = (px, 0, self.W, self.H), far(1 if r > 0 else -1), abs(r)
        return tuple(a[n] + (b[n] - a[n]) * t for n in range(4))

    @staticmethod
    def rgb(hexcolor, alpha=1.0):
        h = hexcolor.lstrip("#")
        try:
            return tuple(int(h[n:n + 2], 16) / 255 for n in (0, 2, 4)) + (alpha,)
        except ValueError:
            return (0.5, 0.5, 0.5, alpha)

    def outline(self, cr, x, y, w, h):
        k = self.SKEW
        cr.move_to(x + k, y)
        cr.line_to(x + w, y)
        cr.line_to(x + w - k, y + h)
        cr.line_to(x, y + h)
        cr.close_path()

    def draw(self, _w, cr):
        visible = [(i, i - self.pos) for i in range(len(self.items)) if abs(i - self.pos) <= self.RADIUS + 1]
        visible.sort(key=lambda v: -abs(v[1]))          # far ones first, the chosen one on top
        self.hits = []
        for i, r in visible:
            x, y, w, h = self.slot(r)
            y += 4
            if x + w < 0 or x > self.width:
                continue
            key, _title, source = self.items[i]
            near = max(0.0, 1 - abs(r))                   # 1 for the chosen one, 0 for a slice
            cr.save()
            self.outline(cr, x, y, w, h)
            cr.clip()
            cr.set_source_rgba(*self.rgb(self.colors["background"]))
            cr.paint()
            pix = self.pix.get(key)
            if pix is not None:
                pw, ph = pix.get_width(), pix.get_height()
                sc = max(w / pw, h / ph)
                cr.save()
                cr.translate(x + (w - pw * sc) / 2, y + (h - ph * sc) / 2)
                cr.scale(sc, sc)
                Gdk.cairo_set_source_pixbuf(cr, pix, 0, 0)
                cr.paint()
                cr.restore()
            painter = source if callable(source) else source[1] if isinstance(source, tuple) else None
            if painter is not None:
                cr.save()
                cr.translate(x, y)
                painter(cr, w, h, pix)
                cr.restore()
            cr.set_source_rgba(*self.rgb(self.colors["background"], 0.42 * (1 - near)))
            cr.paint()
            cr.restore()
            self.outline(cr, x, y, w, h)
            if near > 0.5:
                cr.set_source_rgba(*self.rgb(self.colors["accent"]))
                cr.set_line_width(3)
            else:
                cr.set_source_rgba(*self.rgb(self.colors["muted"]))
                cr.set_line_width(1)
            cr.stroke()
            self.hits.append((i, x, y, w, h))
        return False

    def clicked(self, _w, event):
        for i, x, y, w, h in reversed(self.hits):       # the topmost first
            if x <= event.x <= x + w and y <= event.y <= y + h:
                if i == self.sel:
                    self.on_apply(i)
                else:
                    self.select(i)
                return True
        return False

    def scrolled(self, _w, event):
        ok, dx, dy = event.get_scroll_deltas()
        step = None
        if event.direction in (Gdk.ScrollDirection.DOWN, Gdk.ScrollDirection.RIGHT):
            step = 1
        elif event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT):
            step = -1
        elif ok and (dx or dy):
            step = 1 if (dx or dy) > 0 else -1
        if step:
            self.select(self.sel + step)
        return True

    def key(self, event):
        k = event.keyval
        if k in (Gdk.KEY_Left, Gdk.KEY_h, Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab):
            self.select(self.sel - 1)
        elif k in (Gdk.KEY_Right, Gdk.KEY_l, Gdk.KEY_Down, Gdk.KEY_Tab):
            self.select(self.sel + 1)
        elif k == Gdk.KEY_Home:
            self.select(0)
        elif k == Gdk.KEY_End:
            self.select(len(self.items) - 1)
        elif k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            self.on_apply(self.sel)
        else:
            return False
        return True


def screen_width():
    """Width of the screen the panels open on (the one with the pointer)."""
    display = Gdk.Display.get_default()
    try:
        seat = display.get_default_seat()
        _screen, x, y = seat.get_pointer().get_position()
        mon = display.get_monitor_at_point(x, y)
    except Exception:
        mon = display.get_monitor(0)
    return mon.get_geometry().width if mon else 1366


class PickerPanel(Panel):
    """Base for the wallpaper and theme pickers: a carousel floating over the desktop,
    with the chosen one's name under it. Arrows or scrolling move, Enter or a click on
    the big one applies, Escape closes."""
    anchor = "middle"
    bare = True                   # no box around it: it floats over the desktop

    def build(self, items, selected, hint):
        width = min(screen_width() - 80, Carousel.W + 13 * (Carousel.SW + Carousel.SPACING) + 40)
        self.width = width
        self.items = items
        self.box.set_spacing(14)
        try:
            gi.require_foreign("cairo")       # the carousel draws with cairo
        except ImportError:
            items, hint = [], "The picker needs one more package:  sudo apt install python3-gi-cairo"
        if not items:
            self.box.pack_start(label(hint, "np-picker-name", xalign=0.5), False, False, 0)
            return
        self.carousel = Carousel(items, selected, self.selected, self.apply, width)
        self.box.pack_start(self.carousel, False, False, 0)
        self.name = label(items[selected][1], "np-picker-name", xalign=0.5)
        self.box.pack_start(self.name, False, False, 0)
        self.box.pack_start(label(hint, "np-picker-hint", xalign=0.5), False, False, 0)

    def selected(self, i):
        self.name.set_text(self.items[i][1])

    def on_key(self, event):
        return bool(getattr(self, "carousel", None)) and self.carousel.key(event)

    def apply(self, i):
        raise NotImplementedError


class WallpaperPanel(PickerPanel):
    """Wallpapers (double-click the desktop): Omarchy 4's slanted carousel."""

    def __init__(self, app):
        super().__init__(app)
        images = out(f"{BIN}/nameplate-shell", "wallpaper", "list", timeout=10).splitlines()
        current = read(os.path.expanduser("~/.config/nameplate/wallpaper-current")) or \
            os.path.expanduser("~/.config/nameplate/wallpaper.png")
        if current not in images and os.path.exists(current):
            images.insert(0, current)
        items = [(p, self.title(p), p) for p in images]
        sel = images.index(current) if current in images else 0
        self.build(items, sel, "Enter or click to use it  ·  arrows or scroll to browse  ·  "
                   "add your own in ~/Pictures/Wallpapers" if len(images) > 1 else
                   "Put images in ~/Pictures/Wallpapers, or get Omarchy's: ~/.config/nameplate/bin/get-omarchy-wallpapers")

    @staticmethod
    def title(path):
        name = os.path.splitext(os.path.basename(path))[0]
        name = re.sub(r"^\d+[-_ ]*", "", name) or name           # Omarchy's "1-name" numbering
        return name.replace("-", " ").replace("_", " ").strip().capitalize()

    def apply(self, i):
        path = self.items[i][0]
        in_background(lambda: run(f"{BIN}/nameplate-shell", "wallpaper", "set", path, timeout=10))
        self.close()


def thumbnail(path, w, h):
    """Cropped thumbnail, cached in ~/.cache/nameplate/thumbs."""
    import hashlib
    from gi.repository import GdkPixbuf
    try:
        key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}:{w}x{h}".encode()).hexdigest()
    except OSError:
        return None
    cache = os.path.expanduser(f"~/.cache/nameplate/thumbs/{key}.png")
    try:
        return GdkPixbuf.Pixbuf.new_from_file(cache)
    except GLib.Error:
        pass
    try:
        info = GdkPixbuf.Pixbuf.get_file_info(path)
        iw, ih = info[1], info[2]
        s = max(w / iw, h / ih)
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, max(w, math.ceil(iw * s)), max(h, math.ceil(ih * s)), False)
        pix = pix.new_subpixbuf((pix.get_width() - w) // 2, (pix.get_height() - h) // 2, w, h).copy()
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        pix.savev(cache, "png", [], [])
        return pix
    except (GLib.Error, TypeError, ZeroDivisionError):
        return None



class ThemePanel(PickerPanel):
    """Colour themes (SUPER + CTRL + SHIFT + SPACE): Omarchy 4's slanted carousel.
    Each card is the theme's wallpaper (if you downloaded Omarchy's) with the
    top bar over it in the theme's colours, so you see how the bar will look,
    not just the picture. The side cards are bare wallpaper slices."""

    def __init__(self, app):
        super().__init__(app)
        listing = out(f"{BIN}/theme", "list", timeout=10).splitlines()
        names = [n.lstrip("* ").strip() for n in listing if n.strip()]   # "* " marks the current one
        now = next((n.lstrip("* ").strip() for n in listing if n.startswith("*")), None)
        themes = os.path.expanduser("~/.config/nameplate/themes")
        walls = os.path.expanduser("~/Pictures/Wallpapers")
        # No theme wallpaper: the desktop behind the mock windows is your own
        # current one, which is also what you'd get (theme set keeps it then).
        current = read(os.path.expanduser("~/.config/nameplate/wallpaper-current")) or \
            os.path.expanduser("~/.config/nameplate/wallpaper.png")
        items = []
        for name in names:
            path = os.path.join(themes, name + ".toml")
            if not os.path.exists(path):
                path = os.path.join(os.path.dirname(themes), "user-themes", name + ".toml")
            image = self.wallpaper(walls, name) or (current if os.path.exists(current) else None)
            items.append((name, self.pretty(name), (image, self.painter(self.palette(path)))))
        sel = names.index(now) if now in names else 0
        self.build(items, sel, "Enter or click to switch  ·  arrows or scroll to browse"
                   if items else "No themes found. Run the installer again.")

    @staticmethod
    def wallpaper(walls, name):
        for folder in (os.path.join(walls, "omarchy", name), os.path.join(walls, name)):
            try:
                images = sorted(f for f in os.listdir(folder) if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")))
            except OSError:
                continue
            if images:
                return os.path.join(folder, images[0])
        return None

    @staticmethod
    def palette(path):
        c = {}
        try:
            with open(path) as f:
                for line in f:
                    m = re.match(r'\s*(\w+)\s*=\s*"(#[0-9a-fA-F]{6})"', line)
                    if m:
                        c[m.group(1)] = m.group(2)
        except OSError:
            pass
        return c

    @staticmethod
    def pretty(name):
        special = {"rose-pine": "Rosé Pine", "retro-82": "Retro 82"}
        return special.get(name, name.replace("-", " ").title())

    def painter(self, c):
        """The theme's wallpaper with just the top bar over it, the way the bar
        really looks: the workspace numbers on the left (the one you're on
        underlined in the accent), the clock in the middle, and the right-hand
        icons as small dots. The cards to the sides get nothing drawn on them
        at all - just their wallpaper slice, like Omarchy's. Called by the
        carousel with the wallpaper pixbuf, which it has already drawn; with
        none, the theme background stands in."""
        rgb = Carousel.rgb
        col = lambda key, fallback="#808080": rgb(c.get(key, fallback))

        def paint(cr, w, h, pix):
            if pix is None:
                cr.set_source_rgba(*col("background", "#202020"))
                cr.paint()
            if w < 300:
                return               # a side card: nothing on it at all
            bar_h = max(9.0, h * 0.052)
            cr.set_source_rgba(*col("background", "#202020"))
            cr.rectangle(0, 0, w, bar_h)
            cr.fill()
            keys = ("red", "yellow", "green", "cyan", "magenta", "blue")
            for k, key in enumerate(keys):     # the bar's icons, as dots
                cr.set_source_rgba(*col(key))
                cr.arc(w - w * 0.012 - (len(keys) - k) * bar_h * 0.62, bar_h / 2,
                       bar_h * 0.13, 0, 6.2832)
                cr.fill()
            cr.select_font_face("monospace", 0, 0)   # cairo.FONT_SLANT_NORMAL, FONT_WEIGHT_NORMAL
            cr.set_font_size(bar_h * 0.44)
            base = bar_h * 0.68
            # Left, like the real bar: the workspace numbers
            x = w * 0.012
            for k in range(5):
                num = str(k + 1)
                cr.set_source_rgba(*col("foreground") if k == 0 else col("dark_foreground"))
                cr.move_to(x, base)
                cr.show_text(num)
                nw = cr.text_extents(num).width
                if k == 0:                     # the workspace you're on
                    cr.set_source_rgba(*col("accent"))
                    cr.set_line_width(max(1.0, bar_h * 0.07))
                    cr.move_to(x, bar_h * 0.86)
                    cr.line_to(x + nw, bar_h * 0.86)
                    cr.stroke()
                x += nw + bar_h * 0.5
            # Middle: the clock
            clock = "Tue 20:25"
            cr.set_source_rgba(*col("foreground"))
            cr.move_to((w - cr.text_extents(clock).width) / 2, base)
            cr.show_text(clock)
        return paint

    def apply(self, i):
        name = self.items[i][0]
        self.close()
        def done(_result):
            if DAEMON:
                install_css()           # the panels wear the new colours from now on
        in_background(lambda: run(f"{BIN}/theme", "set", name, timeout=30), done)


# ----------------------------------------------------------------- weather --

# -------------------------------------------------------------- main menu --

def info_rows():
    """About: a few facts about this machine, read on the spot."""
    def first(path, key=None):
        try:
            with open(path) as f:
                for line in f:
                    if key is None:
                        return line.strip()
                    if line.startswith(key):
                        return line.split("=" if "=" in line else ":", 1)[1].strip().strip('"')
        except OSError:
            pass
        return ""

    mem_kb = first("/proc/meminfo", "MemTotal").split()
    try:
        up = int(float(first("/proc/uptime").split()[0]))
    except (IndexError, ValueError):
        up = 0
    du = shutil.disk_usage("/")
    hypr = out("hyprctl", "version", timeout=3).splitlines()
    hypr = re.sub(r"^Hyprland\s*", "", hypr[0]).split(" built")[0] if hypr else ""
    facts = [
        ("System", first("/etc/os-release", "PRETTY_NAME")),
        ("Computer", first("/sys/class/dmi/id/product_name")),
        ("Processor", re.sub(r"\s+", " ", first("/proc/cpuinfo", "model name"))
            .replace("(R)", "").replace("(TM)", "").replace(" CPU", "")),
        ("Memory", "%.0f GB" % (int(mem_kb[0]) / 1048576) if mem_kb else ""),
        ("Disk", "%.0f of %.0f GB free" % (du.free / 1e9, du.total / 1e9)),
        ("Kernel", os.uname().release),
        ("Hyprland", hypr),
        ("Up for", "%dh %02dm" % (up // 3600, up % 3600 // 60)),
    ]
    return [{"icon": "", "label": k, "right": v, "info": True} for k, v in facts if v]


def edit(path):
    """Open a config file in the first editor found."""
    for editor in ("code", "gnome-text-editor", "gedit"):
        if shutil.which(editor):
            return [editor, path]
    return ["alacritty", "-e", os.environ.get("EDITOR", "nano"), path]


def in_terminal(title, command):
    """Run a command in a floating terminal and wait for a key before closing."""
    script = command + '; echo; read -n 1 -s -r -p "Done. Press any key to close."'
    return ["alacritty", "--class", "nameplate-float", "--title", title, "-e", "bash", "-c", script]


def notification_items():
    """Trigger -> Notifications (SUPER + SHIFT + ALT + comma): the recent ones mako
    keeps, newest first. Picking one copies its text."""
    try:
        data = json.loads(out("makoctl", "history", timeout=3) or "{}")
        history = data.get("data", [[]])[0]
    except (ValueError, AttributeError, IndexError):
        history = []
    items = []
    for n in history[:30]:
        field = lambda k: (n.get(k) or {}).get("data") or ""
        summary, body, app = field("summary"), field("body"), field("app-name")
        if app == "nameplate-osd":          # volume / brightness popups aren't news
            continue
        text = summary + ("\n" + body if body else "")
        items.append({"icon": g(0xF009A), "label": summary or body or "(empty)", "right": app,
                      "run": ["sh", "-c", 'printf %s "$1" | wl-copy', "sh", text]})
    return items or [{"icon": "", "label": "No notifications yet", "info": True}]


def reminder_items():
    """Trigger -> Reminders: the ones waiting, plus set / clear (bin/reminder)."""
    rem = BIN + "/reminder"
    items = [{"icon": g(0xF0415), "label": "New reminder", "run": [rem, "set"]}]
    for line in out(rem, "list", "--plain", timeout=5).splitlines():
        when, _, text = line.partition("\t")
        if text:
            items.append({"icon": g(0xF0E1E), "label": text, "right": when, "info": False,
                          "run": [rem, "list"]})
    if len(items) > 1:
        items.append({"icon": g(0xF0A7A), "label": "Clear all", "run": [rem, "clear"]})
    return items


def lock_blur():
    """Lock screen blur level (bin/toggle lock-blur): off, light or strong."""
    try:
        with open(os.path.expanduser("~/.config/nameplate/lock-blur.conf")) as f:
            n = re.search(r"^\$np_blur\s*=\s*(\d+)", f.read(), re.M)
    except OSError:
        n = None
    passes = int(n.group(1)) if n else 3
    return "off" if passes == 0 else "light" if passes == 1 else "strong"


def hardware_items():
    """Setup -> Hardware (SUPER + CTRL + H), like Omarchy's: only what this
    computer has (bin/hardware)."""
    hw = BIN + "/hardware"
    state = os.path.expanduser("~/.local/state/nameplate")
    off = lambda kind: os.path.exists(os.path.join(state, "no-" + kind))
    try:
        devices = json.loads(out("hyprctl", "-j", "devices", timeout=3) or "{}")
    except ValueError:
        devices = {}
    items = []
    if any("touchpad" in m.get("name", "").lower() for m in devices.get("mice", [])):
        items.append({"icon": g(0xF0CE0), "label": "Touchpad", "right": "off" if off("touchpad") else "on",
                      "run": [hw, "touchpad"]})
    if devices.get("touch"):
        items.append({"icon": g(0xF0741), "label": "Touchscreen", "right": "off" if off("touchscreen") else "on",
                      "run": [hw, "touchscreen"]})
    if any("kbd_backlight" in d for d in os.listdir("/sys/class/leds") if os.path.isdir("/sys/class/leds")):
        items.append({"icon": g(0xF030C), "label": "Keyboard light", "stay": True, "run": [hw, "kbd-light"]})
    items.append({"icon": g(0xF0379), "label": "Graphics", "run": [hw, "graphics"]})
    items.append({"icon": g(0xF140B), "label": "Power profile", "panel": "power"})
    return items


def font_items():
    """Appearance -> Font: installed Nerd Fonts, terminal size, and fonts to download."""
    font = BIN + "/font"
    now = out(font, timeout=10)
    family, _, size = now.partition(", terminal size ")
    items = [{"icon": g(0xF0B34), "label": name, "right": "current" if name == family else "",
              "run": [font, "set", name]} for name in out(font, "list", timeout=20).splitlines() if name]
    items.append({"icon": g(0xF0B34), "label": "Terminal size", "right": size, "sub": [
        {"icon": g(0xF0B34), "label": str(n) + ("  (Omarchy)" if n == 9 else ""),
         "right": "current" if size.strip() in (str(n), "%d.0" % n) else "", "run": [font, "size", str(n)]}
        for n in (8, 9, 10, 11, 12, 13)]})
    more = [line.split("\t") for line in out(font, "more", timeout=20).splitlines() if "\t" in line]
    if more:
        items.append({"icon": g(0xF01DA), "label": "Get more fonts", "sub": [
            {"icon": g(0xF01DA), "label": name, "run": in_terminal("Fonts", "%s install %s" % (font, archive))}
            for archive, name in more]})
    return items


class MenuPanel(Panel):
    """Everything in one place (SUPER + SPACE, or click the logo in the bar),
    laid out like Omarchy's Walker menu: a narrow centred box with a plain
    search line on top whose placeholder names the menu you're in ("Go…" at
    the top, "Appearance…", "System…" inside one), and big rows underneath. Type
    to search everything at once, Enter to pick, arrows to move, Escape or
    Backspace to go back a level (there is no back button, like Walker)."""
    width = 275          # 315px with the padding below: Walker's --width 295 box
    anchor = "middle"
    padding = 20         # Walker's .box-wrapper padding
    window_classes = ("np-menu",)
    dim_backdrop = False
    MAX_RESULTS = 12

    def __init__(self, app, route=None):
        super().__init__(app)
        self.box.set_spacing(10)
        self.stack = []            # [(title, items)]
        self.buttons = []          # [(button, item)] currently shown
        self.selected = 0
        self.search = Gtk.Entry()
        self.search.get_style_context().add_class("np-menu-search")
        self.search.connect("changed", lambda *_: self.fill())
        self.search.connect("activate", lambda *_: self.activate())
        # Walker's prompt ("Go…") stays on show while you type, but GTK hides a
        # focused entry's own placeholder, so the prompt is a label over the
        # entry, shown whenever the entry is empty (fill() sets its text).
        self.prompt = label("", "np-menu-prompt")
        self.prompt.set_margin_start(11)
        self.prompt.set_valign(Gtk.Align.CENTER)
        overlay = Gtk.Overlay()
        overlay.add(self.search)
        overlay.add_overlay(self.prompt)
        overlay.set_overlay_pass_through(self.prompt, True)
        self.box.pack_start(overlay, False, False, 0)
        self.list = vbox(0)
        self.box.pack_start(self.list, False, False, 0)

        self.root = self.tree()
        self.stack.append(("Go", self.root))
        # e.g. "panel menu system" opens System directly, "panel menu trigger/capture"
        # opens Capture inside Trigger
        items = self.root
        for part in (route or "").lower().split("/"):
            item = next((i for i in items if i["label"].lower() == part and "sub" in i), None)
            if item is None:
                break
            items = self.items_of(item)
            self.stack.append((item["label"], items))
        self.fill()

    def shown(self):
        self.search.grab_focus()

    # ---- what's in the menu ----

    def tree(self):
        B = BIN + "/"
        panel = lambda kind: {"panel": kind}
        run_ = lambda *cmd: {"run": list(cmd)}
        recording = subprocess.run(["pgrep", "-x", "wf-recorder"], capture_output=True).returncode == 0
        dnd = "do-not-disturb" in out("makoctl", "mode", timeout=3).split()
        running = lambda name: subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0
        awake = subprocess.run(["pgrep", "-f", "[s]ystemd-inhibit --what=idle --who=hypr-nameplate stay awake"],
                               capture_output=True).returncode == 0
        night = running("hyprsunset")
        cfg = os.path.expanduser("~/.config")
        configs = [("Hyprland (keys, windows, startup)", "hypr/hyprland.lua"),
                   ("Lock screen", "hypr/hyprlock.conf"), ("Idle and screen off", "hypr/hypridle.conf"),
                   ("Bar", "waybar/config.jsonc"), ("Bar style", "waybar/style.css"),
                   ("Notifications", "mako/config"), ("Launcher", "fuzzel/fuzzel.ini"),
                   ("Terminal", "alacritty/alacritty.toml"), ("Prompt", "starship.toml")]
        updates = [{"icon": g(0xF03D3), "label": "Ubuntu packages",
                    "run": in_terminal("Update", "sudo apt update && sudo apt full-upgrade")}]
        if shutil.which("snap"):
            updates.append({"icon": g(0xF01A7), "label": "Snaps",
                            "run": in_terminal("Update", "sudo snap refresh")})
        if shutil.which("flatpak"):
            updates.append({"icon": g(0xF01A7), "label": "Flatpaks",
                            "run": in_terminal("Update", "flatpak update")})
        if shutil.which("fwupdmgr"):
            updates.append({"icon": g(0xF061A), "label": "Firmware",
                            "run": in_terminal("Update", "fwupdmgr refresh; fwupdmgr update")})
        state = os.path.expanduser("~/.local/state/nameplate")
        flag = lambda name: "on" if os.path.exists(os.path.join(state, name)) else "off"
        record = ([{"icon": g(0xF04DB), "label": "Stop recording", **run_(B + "screenrecord")}] if recording else [
            {"icon": g(0xF019E), "label": "Region", **run_(B + "screenrecord")},
            {"icon": g(0xF0293), "label": "Full screen", **run_(B + "screenrecord", "full")},
            {"icon": g(0xF036C), "label": "Full screen + mic", **run_(B + "screenrecord", "full", "mic")}])
        if shutil.which("timeshift"):
            updates.insert(0, {"icon": g(0xF0C6F), "label": "Snapshot now",
                               "run": in_terminal("Snapshot", 'sudo timeshift --create '
                                                  '--comments "From the menu (hypr-nameplate)" --scripted')})
            updates.append({"icon": g(0xF02DA), "label": "Snapshots (Timeshift)",
                            **run_("timeshift-launcher")})
        sources = [("apt", "Ubuntu packages (apt)", g(0xF03D3))]
        if shutil.which("snap"):
            sources.append(("snap", "Snaps", g(0xF01A7)))
        if shutil.which("flatpak"):
            sources.append(("flatpak", "Flatpaks (Flathub)", g(0xF01A7)))
        package = lambda verb: [{"icon": icon, "label": text, **run_(B + "pkg", verb, src)}
                                for src, text, icon in sources]
        appearance = [
            {"icon": g(0xF0E0C), "label": "Theme", **panel("themes")},
            {"icon": g(0xE659), "label": "Font", "sub": font_items},
            {"icon": g(0xF03E), "label": "Background", **panel("wallpapers")},
            {"icon": I["next"], "label": "Next background", "stay": True, **run_(B + "nameplate-shell", "wallpaper", "next")},
            {"icon": g(0xF0E79), "label": "Gaps", "right": "off" if flag("no-gaps") == "on" else "on",
             **run_(B + "toggle", "gaps")},
            {"icon": g(0xF0A27), "label": "Square window", "right": flag("square"),
             **run_(B + "toggle", "square")},
            {"icon": g(0xF0A1F), "label": "Dock", "right": "off" if flag("no-dock") == "on" else "on",
             **run_(B + "toggle", "dock")},
            {"icon": g(0xF0D9D), "label": "Animations",
             "right": "off" if flag("no-animations") == "on" else "on", **run_(B + "toggle", "animations")},
            {"icon": I["lock"], "label": "Lock screen blur", "right": lock_blur(), "sub": [
                {"icon": I["lock"], "label": level.capitalize(), "right": "current" if lock_blur() == level else "",
                 **run_(B + "toggle", "lock-blur", level)} for level in ("off", "light", "strong")]},
            {"icon": g(0xF0209), "label": "Show/hide the bar", **run_("pkill", "-SIGUSR1", "waybar")},
            {"icon": I["refresh"], "label": "Restart the bar",
             **run_("sh", "-c", "pkill -x waybar; sleep 0.5; exec waybar")},
        ]
        # Omarchy 4.5's top level and order (omarchy-menu's "Go" menu)
        return [
            {"icon": g(0xF003B), "label": "Apps", **panel("apps")},
            {"icon": g(0xF09D1), "label": "Learn", "sub": [
                {"icon": g(0xF11C), "label": "Keybindings", **run_(B + "keys")},
                {"icon": g(0xF359), "label": "Hyprland wiki", **run_("xdg-open", "https://wiki.hypr.land")},
                {"icon": g(0xF02A4), "label": "hypr-nameplate on GitHub",
                 **run_("xdg-open", "https://github.com/adoodevv/hypr-nameplate")},
            ]},
            {"icon": g(0xEBCF), "label": "Appearance", "sub": appearance},
            {"icon": g(0xF14DE), "label": "Trigger", "sub": [
                # SUPER + CTRL + C
                {"icon": g(0xF0100), "label": "Capture", "sub": [
                    {"icon": g(0xF0100), "label": "Screenshot", "sub": [
                        {"icon": g(0xF019E), "label": "Region", **run_(B + "screenshot", "region")},
                        {"icon": g(0xF0293), "label": "Full screen", **run_(B + "screenshot", "full")}]},
                    {"icon": g(0xF044A), "label": "Stop recording" if recording else "Screen recording",
                     **({"run": record[0]["run"]} if recording else {"sub": record})},
                    {"icon": g(0xF0266), "label": "Colour picker", **run_(B + "colour-picker")},
                    {"icon": g(0xF09ED), "label": "Text from screen", **run_(B + "ocr")},
                ]},
                # SUPER + CTRL + O
                {"icon": g(0xF0A1F), "label": "Toggle", "sub": [
                    {"icon": g(0xF009B), "label": "Do not disturb", "right": "on" if dnd else "off",
                     **run_(B + "dnd")},
                    {"icon": g(0xF0176), "label": "Stay awake", "right": "on" if awake else "off",
                     **run_(B + "stay-awake")},
                    {"icon": g(0xF050E), "label": "Night light", "right": "on" if night else "off",
                     **run_(B + "nightlight")},
                    {"icon": g(0xF0209), "label": "Top bar", **run_("pkill", "-SIGUSR1", "waybar")},
                    {"icon": g(0xF0E79), "label": "Window gaps", "right": "off" if flag("no-gaps") == "on" else "on",
                     **run_(B + "toggle", "gaps")},
                    {"icon": g(0xF0A27), "label": "Square window", "right": flag("square"),
                     **run_(B + "toggle", "square")},
                    {"icon": g(0xF0322), "label": "Laptop screen", **run_(B + "display", "laptop")},
                    {"icon": g(0xF1483), "label": "Mirror screens", **run_(B + "display", "mirror")},
                ]},
                {"icon": I["clip"], "label": "Clipboard", **panel("clipboard")},
                {"icon": g(0xF009A), "label": "Notifications", "sub": notification_items},
                {"icon": g(0xF0E1E), "label": "Reminders", "sub": reminder_items},
                {"icon": g(0xF0F8C), "label": "Transcode", **run_(B + "transcode")},
                {"icon": g(0xF06A9), "label": "AI agents", **panel("agents")},
                {"icon": g(0xF01F5), "label": "Emoji", **panel("emoji")},
            ]},
            {"icon": g(0xE615), "label": "Setup", "sub": [
                {"icon": g(0xE638), "label": "Audio", **panel("sound")},
                {"icon": I["wifi"][-1], "label": "Wi-Fi", **panel("wifi")},
                {"icon": I["bt"], "label": "Bluetooth", **panel("bluetooth")},
                {"icon": I["monitor"], "label": "Monitors", **panel("display")},
                {"icon": g(0xF140B), "label": "Power profile", **panel("power")},
                # SUPER + CTRL + H
                {"icon": g(0xF061A), "label": "Hardware", "sub": hardware_items},
                {"icon": g(0xF11C), "label": "Keybindings", **run_(B + "keys")},
                {"icon": g(0xF0219), "label": "Config files", "sub": [
                    {"icon": g(0xF0219), "label": text, "run": edit(os.path.join(cfg, rel))}
                    for text, rel in configs if os.path.exists(os.path.join(cfg, rel))]},
                {"icon": g(0xF062E), "label": "GNOME Settings",
                 **run_("env", "XDG_CURRENT_DESKTOP=GNOME", "gnome-control-center")},
            ]},
            {"icon": g(0xF0AB9), "label": "Install", "sub": package("install")},
            {"icon": g(0xF0A7A), "label": "Remove", "sub": package("remove")},
            {"icon": g(0xF021), "label": "Update", "sub": updates},
            {"icon": g(0xEA74), "label": "About", "sub": info_rows},
            {"icon": g(0xF011), "label": "System", "sub": [
                {"icon": g(0xF1104), "label": "Screensaver", **run_(B + "launch-screensaver")},
                {"icon": I["lock"], "label": "Lock", **run_("loginctl", "lock-session")},
                {"icon": g(0xF04B2), "label": "Suspend", **run_("systemctl", "suspend")},
                {"icon": g(0xF0343), "label": "Logout", **run_("hyprctl", "dispatch", "hl.dsp.exit()")},
                {"icon": g(0xF0709), "label": "Restart", **run_("systemctl", "reboot")},
                {"icon": g(0xF011), "label": "Shutdown", **run_("systemctl", "poweroff")},
            ]},
        ]

    @staticmethod
    def items_of(item):
        sub = item["sub"]
        return sub() if callable(sub) else sub

    def everything(self, items=None, path=""):
        """Every item reachable from the top, with where it lives, for searching."""
        for item in self.root if items is None else items:
            if "sub" in item and not callable(item["sub"]):
                yield from self.everything(item["sub"], item["label"] if not path else path + " › " + item["label"])
            if not item.get("info"):
                yield item, path

    # ---- drawing ----

    def fill(self):
        clear(self.list)
        self.buttons = []
        query = self.search.get_text().strip().lower()
        title, items = self.stack[-1]
        self.prompt.set_text(title + "…")               # Walker's prompt: "Go…", "Appearance…"
        self.prompt.set_visible(not query)
        if query:
            def words(item, path):   # "wifi" finds Wi-Fi, "shutdown" finds Shut down
                text = (path + " " + item["label"]).lower().replace("-", "")
                return text.split() + [item["label"].lower().replace(" ", "").replace("-", "")]
            wanted = query.replace("-", "").split()
            shown = [(item, path) for item, path in self.everything()
                     if all(any(w.startswith(q) for w in words(item, path)) for q in wanted)]
            shown = shown[:self.MAX_RESULTS]
        else:
            shown = [(item, item.get("right", "")) for item in items]
        for item, right in shown:
            if item.get("info"):           # About: a plain line, not a button
                line = hbox(10)
                line.get_style_context().add_class("np-menu-info")
                line.set_margin_start(14)
                line.set_margin_end(14)
                line.set_margin_top(8)
                line.set_margin_bottom(8)
                line.pack_start(label(item["label"], "np-dim"), False, False, 5)
                line.pack_end(label(right, ellipsize=True, width=30, xalign=1.0), True, True, 5)
                self.list.pack_start(line, False, False, 0)
                continue
            if query:
                right = right.split(" › ")[-1]          # just where it lives, e.g. "Config files"
            b = row(item["icon"], item["label"], right=right,
                    on_click=lambda it=item: self.choose(it))
            b.get_style_context().add_class("np-menu-item")
            self.buttons.append((b, item))
            b.connect("enter-notify-event", lambda w, *_: self.select_button(w))
            self.list.pack_start(b, False, False, 0)
        if not shown:
            self.list.pack_start(label("No matches." if query else "Nothing here.", "np-dim"), False, False, 6)
        self.list.show_all()
        self.select(0)

    def select_button(self, button):
        for i, (b, _) in enumerate(self.buttons):
            if b is button:
                self.select(i)
        return False

    def select(self, i):
        if not self.buttons:
            return
        self.selected = max(0, min(i, len(self.buttons) - 1))
        for n, (b, _) in enumerate(self.buttons):
            ctx = b.get_style_context()
            (ctx.add_class if n == self.selected else ctx.remove_class)("np-selected")

    # ---- doing ----

    def activate(self):
        if self.buttons:
            self.choose(self.buttons[self.selected][1])

    def choose(self, item):
        if "sub" in item:
            self.stack.append((item["label"], self.items_of(item)))
            self.search.set_text("")
            self.fill()
            self.search.grab_focus()
        elif "panel" in item:
            self.close()                         # frees the panel slot first
            open_panel(item["panel"])
        elif "run" in item:
            if item.get("stay"):
                spawn(*item["run"])
                return
            self.close()
            # a moment for the menu to disappear, so screenshots and the lock don't catch it
            spawn("sh", "-c", 'sleep 0.25; exec "$@"', "sh", *item["run"])

    def go_back(self):
        if len(self.stack) > 1:
            self.stack.pop()
            self.search.set_text("")
            self.fill()
            self.search.grab_focus()
            return True
        return False

    def on_key(self, event):
        key = event.keyval
        if key == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text("")
                return True
            return self.go_back()            # at the top, Escape closes as usual
        if key == Gdk.KEY_BackSpace and not self.search.get_text():
            self.go_back()
            return True
        if key in (Gdk.KEY_Down, Gdk.KEY_Tab, Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab) and self.buttons:
            step = 1 if key in (Gdk.KEY_Down, Gdk.KEY_Tab) else -1
            self.select((self.selected + step) % len(self.buttons))   # wraps around
            return True
        if key == Gdk.KEY_Right and self.buttons and "sub" in self.buttons[self.selected][1] \
                and not self.search.get_text():
            self.activate()
            return True
        if key == Gdk.KEY_Left and not self.search.get_text():
            return self.go_back()
        return False


KINDS = {"display": DisplayPanel,
         "wallpapers": WallpaperPanel,
         "menu": MenuPanel,
         "themes": ThemePanel}


# --------------------------------------------------------------------- app --

class App:
    """One open panel: its window, plus the invisible click-catcher around it."""

    def __init__(self, kind, route=None, mark_x=None):
        global CURRENT
        CURRENT = self
        self.closed = False
        self.windows = []
        self.panel = None
        if STYLE is None:
            install_css()
        layered = GtkLayerShell is not None and GtkLayerShell.is_supported()
        monitor = self.monitor_at(mark_x)      # open on the screen whose bar was clicked

        panel = KINDS[kind](self, route) if route else KINDS[kind](self)
        self.panel = panel

        if layered:
            self.windows.append(self.backdrop(monitor, getattr(panel, "dim_backdrop", False)))

        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.get_style_context().add_class("np-popup")
        for cls in getattr(panel, "window_classes", ()):
            win.get_style_context().add_class(cls)
        win.set_title(f"nameplate {kind}")
        frame = Gtk.Box()
        frame.set_border_width(0 if getattr(panel, "bare", False)
                               else getattr(panel, "padding", 12))
        if getattr(panel, "bare", False):
            win.get_style_context().add_class("np-bare")
            visual = win.get_screen().get_rgba_visual()
            if visual:
                win.set_visual(visual)
        panel.box.set_size_request(panel.width, -1)
        frame.add(panel.box)
        win.add(frame)
        win.connect("key-press-event", self.on_key)
        win.connect("destroy", lambda *_: self.quit())
        if layered:
            GtkLayerShell.init_for_window(win)
            GtkLayerShell.set_namespace(win, "nameplate-panel")
            GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
            if monitor is not None:
                GtkLayerShell.set_monitor(win, monitor)
            if panel.anchor != "middle":     # "middle": centred on the screen
                GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.TOP, True)
                GtkLayerShell.set_margin(win, GtkLayerShell.Edge.TOP, 6)
            if panel.anchor == "right":
                GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
                GtkLayerShell.set_margin(win, GtkLayerShell.Edge.RIGHT, 10)
            GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        else:
            # Not on a layer-shell desktop (e.g. GNOME): a plain window that closes when it loses focus
            win.set_decorated(False)
            win.set_position(Gtk.WindowPosition.MOUSE)
            win.connect("focus-out-event", lambda *_: self.quit())
        self.windows.append(win)
        for w in self.windows:
            w.show_all()
        win.set_focus(None)    # no control starts focused (avoids the theme's focus ring)
        panel.shown()      # lets a panel hide parts that show_all() just made visible

    @staticmethod
    def monitor_at(x):
        """The screen the bar click was on (x is the pointer's position across all screens)."""
        if x is None:
            return None
        display = Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            m = display.get_monitor(i)
            g = m.get_geometry()
            if g.x <= x < g.x + g.width:
                return m
        return None

    def backdrop(self, monitor, dim=False):
        """Layer over everything except the bar: any click on it closes the panel.
        Menus and the app grid also dim the desktop behind them (np-dimmed)."""
        w = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        w.get_style_context().add_class("np-backdrop")
        if dim:
            w.get_style_context().add_class("np-dimmed")
        visual = w.get_screen().get_rgba_visual()
        if visual:
            w.set_visual(visual)
        GtkLayerShell.init_for_window(w)
        GtkLayerShell.set_namespace(w, "nameplate-backdrop")
        GtkLayerShell.set_layer(w, GtkLayerShell.Layer.TOP)
        if monitor is not None:
            GtkLayerShell.set_monitor(w, monitor)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(w, edge, True)
        GtkLayerShell.set_exclusive_zone(w, 0)   # stays clear of the bar, so bar icons remain clickable
        GtkLayerShell.set_keyboard_mode(w, GtkLayerShell.KeyboardMode.NONE)
        w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.TOUCH_MASK)
        w.connect("button-press-event", lambda *_: self.quit())
        w.connect("touch-event", lambda *_: self.quit())
        return w

    def on_key(self, _w, event):
        hook = getattr(self.panel, "on_key", None)
        if hook and hook(event):
            return True
        if event.keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        return False

    def quit(self):
        if self.closed:
            return
        self.closed = True
        try:
            if self.panel:
                self.panel.cleanup()
        except Exception:
            traceback.print_exc()
        for w in self.windows:
            w.destroy()
        self.windows = []
        if DAEMON:
            DAEMON.closed(self)


class Daemon:
    """panel daemon: shows this program's panels when nameplate-shell's panel daemon
    passes a request on (over SOCK), so a bar click doesn't wait for Python and GTK."""

    def __init__(self):
        self.app = None
        self.kind = None
        if send("ping"):                       # one is already running
            sys.exit(0)
        try:
            os.unlink(SOCK)
        except OSError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(SOCK)
        os.chmod(SOCK, 0o600)
        self.sock.listen(8)
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self.accept)
        install_css()
        self.tell_bar(None, None)         # nothing open (clears a line left by a crash)

    def accept(self, *_):
        try:
            conn, _ = self.sock.accept()
            with conn:
                conn.settimeout(1)
                message = conn.recv(4096).decode(errors="replace")
        except OSError:
            return True
        parts = message.split("\t")
        try:
            if parts[0] == "open" and len(parts) >= 2 and parts[1] in KINDS:
                x = int(float(parts[3])) if len(parts) > 3 and parts[3].strip() else None
                if self.app and not self.app.closed and self.kind == parts[1]:
                    self.app.quit()             # the same bar item again: close it
                else:
                    self.open(parts[1], parts[2] if len(parts) > 2 and parts[2] else None, x)
            elif parts[0] == "reload":
                install_css()
            elif parts[0] == "close" and self.app:
                self.app.quit()
        except Exception:
            traceback.print_exc()
        return True

    def open(self, kind, route=None, mark_x=None):
        if self.app and not self.app.closed:
            self.app.quit()
        if kind not in KINDS:                  # ported to Rust (opened from a menu here)
            send(f"open\t{kind}\t{route or ''}\t", FRONT)
            return
        try:
            self.app = App(kind, route, mark_x)
            self.kind = kind
            self.tell_bar(kind, route)
        except Exception:
            traceback.print_exc()
            if CURRENT and not CURRENT.closed:
                CURRENT.quit()

    def closed(self, app):
        if app is self.app:
            self.app, self.kind = None, None
            GLib.idle_add(self.bar_if_idle)     # unless another panel opens straight away

    def bar_if_idle(self):
        if self.app is None:
            try:
                with open(OPEN_FILE) as f:
                    open_kind = (f.read().split() or [""])[0]
            except OSError:
                open_kind = ""
            if not open_kind or open_kind in KINDS:   # not a Rust panel that has opened since
                self.tell_bar(None, None)
        return False

    @staticmethod
    def tell_bar(kind, route):
        """Which panel is open, so its bar item draws the accent line (nameplate bar)."""
        try:
            with open(OPEN_FILE, "w") as f:
                f.write(f"{kind} {route or ''}".strip() + "\n" if kind else "")
        except OSError:
            return
        for sig in (12, 9, 16):         # the panel items, the sound item, the weather
            subprocess.Popen(["pkill", f"-RTMIN+{sig}", "-x", "waybar"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def stop(self):
        try:
            os.unlink(SOCK)
        except OSError:
            pass
        Gtk.main_quit()


def main():
    global DAEMON
    if sys.argv[1:2] != ["daemon"]:
        sys.exit("usage: panel daemon (panels open with nameplate-shell panel KIND)")
    DAEMON = Daemon()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, DAEMON.stop)
    Gtk.main()


if __name__ == "__main__":
    main()

#!/bin/bash
# Bar items that open a panel (Waybar custom modules, JSON output):
#   bar-status logo | network | bluetooth | battery | monitor | clock | ...
# Icons and sizes follow Omarchy 4's bar.
# Each adds the "open" class while its panel is showing, which draws the accent
# line under it (style.css). bin/panel writes which panel is open and sends the bar
# signal 12, so the line appears at once. The clock runs continuously instead.

open_file="${XDG_RUNTIME_DIR:-/tmp}/nameplate-panel-open"

is_open() {           # is_open PANEL [ROUTE]
  local kind="" route=""
  [[ -r $open_file ]] && read -r kind route <"$open_file"
  [[ $kind == "$1" && $route == "${2:-}" ]]
}

emit() {              # emit TEXT TOOLTIP CLASS... (classes may be empty)
  local text=$1 tip=$2 classes="" c
  shift 2
  for c in "$@"; do [[ -n $c ]] && classes+="\"$c\","; done
  printf '{"text": "%s", "tooltip": "%s", "class": [%s]}\n' "$text" "$tip" "${classes%,}"
}

mark() { is_open "$@" && echo open; }

case $1 in
  logo)
    # Omarchy puts its logo here; this is Ubuntu, so the Ubuntu logo
    emit $'\uf31b' ""                 # no line under it: the menu opens mid-screen, as in Omarchy
    ;;

  power)
    emit "󰐥" "" "$(mark menu system)"
    ;;

  network)
    icons=(󰤯 󰤟 󰤢 󰤥 󰤨)
    if nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q '^ethernet:connected'; then
      emit "󰈀" "" ethernet "$(mark wifi)"
    elif [[ $(nmcli radio wifi 2>/dev/null) != enabled ]]; then
      emit "󰤮" "" disabled "$(mark wifi)"
    else
      signal=$(nmcli -t -f IN-USE,SIGNAL dev wifi list --rescan no 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }')
      if [[ -n $signal ]]; then
        level=$(( signal >= 80 ? 4 : signal >= 60 ? 3 : signal >= 40 ? 2 : signal >= 20 ? 1 : 0 ))
        emit "${icons[$level]}" "" wifi "$(mark wifi)"
      elif nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q '^wifi:connecting'; then
        emit "󰤫" "" linked "$(mark wifi)"
      else
        emit "󰤮" "" disconnected "$(mark wifi)"
      fi
    fi
    ;;

  bluetooth)
    show=$(timeout 3 bluetoothctl show 2>/dev/null)
    [[ -z $show ]] && { echo; exit 0; }             # no Bluetooth adapter: hide the item
    if ! grep -q "Powered: yes" <<<"$show"; then
      emit "󰂲" "" off "$(mark bluetooth)"
    elif [[ -n $(timeout 3 bluetoothctl devices Connected 2>/dev/null) ]]; then
      emit "󰂱" "" connected "$(mark bluetooth)"
    else
      emit "󰂯" "" on "$(mark bluetooth)"
    fi
    ;;

  battery)            # Omarchy's power item: the battery, or the power profile on a desktop
    bat=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)
    if [[ -z $bat ]]; then
      case $(powerprofilesctl get 2>/dev/null) in
        power-saver) emit "󰌪" "" "$(mark power)" ;;
        performance) emit "󰓅" "" "$(mark power)" ;;
        *) emit "󰊚" "" "$(mark power)" ;;
      esac
      exit 0
    fi
    level=$(<"$bat/capacity") status=$(<"$bat/status")
    icons=(󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹)
    charging=(󰢜 󰂆 󰂇 󰂈 󰢝 󰂉 󰢞 󰂊 󰂋 󰂅)
    step=$(( (level - 1) / 10 )); (( step < 0 )) && step=0; (( step > 9 )) && step=9
    state=""
    (( level <= 20 )) && state=warning
    (( level <= 10 )) && state=critical
    case $status in
      Charging) emit "${charging[step]}" "" charging "$(mark power)" ;;
      Full|"Not charging") emit "󰂅" "" plugged "$(mark power)" ;;
      *) emit "${icons[step]}" "" "$state" "$(mark power)" ;;
    esac
    ;;

  monitor)            # Omarchy's display item: opens the display panel
    n=$(hyprctl monitors -j 2>/dev/null | grep -c '"name"')
    if (( n > 1 )); then emit "󰍺" "" "$(mark display)"; else emit "󰍹" "" "$(mark display)"; fi
    ;;

  clock)
    # Runs for as long as the bar does: prints when the minute or the calendar's
    # open state changes. Cheap: bash built-ins plus a short sleep.
    last=""
    while :; do
      printf -v now '%(%A %H:%M)T' -1          # Omarchy: "Tuesday 12:02"
      kind="" route=""
      [[ -r $open_file ]] && read -r kind route <"$open_file"
      cls=""
      [[ $kind == calendar ]] && cls=open
      line="$now|$cls"
      if [[ $line != "$last" ]]; then
        emit "$now" "" "$cls" || exit 0              # the bar went away
        last=$line
      fi
      sleep 0.4
    done
    ;;

  awake)              # coffee cup: lit while "stay awake" is on (bin/stay-awake)
    if pgrep -f "[s]ystemd-inhibit --what=idle --who=hypr-nameplate stay awake" >/dev/null; then
      emit $'\uef59' "Staying awake: no screensaver or lock. Click to turn off" on
    else
      emit $'\uef59' "Stay awake: click to keep the screensaver and lock away" off
    fi
    ;;

  nightlight)         # half-light circle (Omarchy's): lit while night light is on
    if pgrep -x hyprsunset >/dev/null; then
      emit "󰔎" "Night light is on. Click to turn it off" on
    else
      emit "󰔎" "Night light: click for warmer screen colours" off
    fi
    ;;

  dnd)                # bell: crossed out and lit while do-not-disturb is on
    if makoctl mode 2>/dev/null | grep -qx do-not-disturb; then
      emit "󰂛" "Do not disturb is on. Click to turn it off" on
    else
      emit "󰂛" "Do not disturb: click to silence notifications" off
    fi
    ;;

  mic)
    raw=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
    if [[ -z $raw ]]; then
      echo                                          # no microphone
    elif [[ $raw == *MUTED* ]]; then
      emit "󰍭" "Microphone muted. Click to unmute" on
    else
      emit "󰍭" "Mute the microphone" off
    fi
    ;;

  updates)            # only when Ubuntu has updates waiting (apt refreshes its list daily)
    # Count what an upgrade would really install now. "apt list --upgradable" also
    # lists Ubuntu's phased updates, which roll out gradually and get held back,
    # so that count wouldn't drop after updating.
    n=$(apt-get -s -o Debug::NoLocking=true full-upgrade 2>/dev/null | grep -c '^Inst ')
    if (( n > 0 )); then
      emit $'\uf021' "$n update$( ((n > 1)) && echo s) waiting. Click to install" waiting
    else
      echo
    fi
    ;;

  keyboard)           # Omarchy's keyboard-layout item (bin/keyboard-layout)
    exec "$(dirname "$0")/keyboard-layout"
    ;;

  *)
    echo "usage: bar-status logo|power|network|bluetooth|battery|monitor|clock|awake|nightlight|dnd|mic|keyboard|updates" >&2
    exit 1
    ;;
esac

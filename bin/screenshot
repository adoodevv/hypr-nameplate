#!/bin/bash
# screenshot region | full  -> saves to ~/Pictures/Screenshots and copies to clipboard
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"
if [[ ${1:-region} == full ]]; then
  grim "$file" || exit 1
else
  area=$(slurp) || exit 0
  grim -g "$area" "$file" || exit 1
fi
wl-copy < "$file"
notify-send "Screenshot saved" "$file"

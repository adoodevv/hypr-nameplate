#!/bin/bash
# Screensaver: loops random text effects over the ASCII art
# until a key is pressed. Runs inside a fullscreen Alacritty window.
export PATH="$HOME/.local/bin:$PATH"
ART="${NAMEPLATE_ART:-$HOME/.config/nameplate/screensaver.txt}"

cleanup() {
  [[ -n $pid ]] && kill "$pid" 2>/dev/null
  printf '\033[?25h'
  exit 0
}
trap cleanup INT TERM HUP

if ! command -v tte >/dev/null; then
  echo "tte not found. Run: pipx install terminaltexteffects"
  read -rsn1 -t 10
  exit 1
fi

# On Hyprland, lock once the screensaver has been showing this long (seconds).
# Together with the 2.5 minute idle delay this locks at 5 minutes.
LOCK_AFTER="${NAMEPLATE_LOCK_AFTER:-150}"
locked=0
lock_seen=0

printf '\033[?25l'
clear
while true; do
  tte -i "$ART" \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 \
    --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --exclude-effects dev_worm \
    --no-eol --no-restore-cursor &
  pid=$!
  started=$SECONDS
  while kill -0 "$pid" 2>/dev/null; do
    if read -rsn1 -t 0.5; then cleanup; fi
    # Backup: bin/lock closes the screensaver ~1 s after locking (with animations
    # off, so nothing replays on unlock). If that didn't happen, close after ~3 s.
    if pidof -q hyprlock; then
      (( lock_seen++ >= 6 )) && cleanup
    else
      lock_seen=0
    fi
    if (( !locked && SECONDS >= LOCK_AFTER )) && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
      locked=1
      loginctl lock-session   # hypridle's lock_cmd closes this window and opens the lock screen
    fi
  done
  wait "$pid"
  # If tte died straight away something is wrong; don't spin the CPU.
  if (( SECONDS - started < 1 )); then sleep 3; fi
done

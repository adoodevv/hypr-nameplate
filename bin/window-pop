#!/usr/bin/python3
"""Pop the active window out: float it, pin it above the rest (SUPER + O).

Pressing it again puts the window back. Popped windows carry the "pop" tag,
which hyprland.lua rounds (8px) while everything else stays square.
"""
import json
import subprocess


def hypr_json(*args):
    try:
        out = subprocess.run(["hyprctl", "-j", *args], capture_output=True,
                             text=True, timeout=5).stdout
        return json.loads(out or "null")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def dispatch(lua):
    subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, timeout=5)


def main():
    window = hypr_json("activewindow") or {}
    address = window.get("address")
    if not address:
        return
    target = f'window = "address:{address}"'
    if window.get("pinned"):
        dispatch(f'hl.dsp.window.pin({{ {target} }})')
        if window.get("floating"):
            dispatch(f'hl.dsp.window.float({{ action = "off", {target} }})')
        dispatch(f'hl.dsp.window.tag({{ tag = "-pop", {target} }})')
        return
    if not window.get("floating"):
        dispatch(f'hl.dsp.window.float({{ action = "on", {target} }})')
    dispatch(f'hl.dsp.window.resize({{ x = 1300, y = 900, relative = false, {target} }})')
    dispatch(f'hl.dsp.window.center({{ {target} }})')
    dispatch(f'hl.dsp.window.pin({{ {target} }})')
    dispatch(f'hl.dsp.window.alter_zorder({{ mode = "top", {target} }})')
    dispatch(f'hl.dsp.window.tag({{ tag = "+pop", {target} }})')


if __name__ == "__main__":
    main()

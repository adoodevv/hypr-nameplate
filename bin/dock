#!/usr/bin/python3
"""The dock along the bottom, like Omarchy 4's: the app grid button, your pinned apps and
whatever else is open, as large icons floating over the desktop.

Like Omarchy's, it lives on floating workspaces (SUPER + L): a maximized window
tucks it to the bottom edge until the pointer touches there, a fullscreen one
hides it, and right-clicking the grid button can make it always tuck away.
Click an app to open it, or to jump to its window when it's already open (click
again for its next window). Drag icons to reorder them. Right-click an app for
pin, new window and quit; a minimized app (SUPER + M) waits here too.

    dock                 run it (started at login)
    dock pin ID          pin an app (ID: its .desktop name, e.g. firefox_firefox.desktop)
    dock unpin ID
    dock pinned          list the pinned apps
    dock autohide [on|off]

Pinned apps live in ~/.config/nameplate/dock.json.
"""
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config", "nameplate", "dock.json")
BIN = os.path.join(HOME, ".config", "nameplate", "bin")
PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "nameplate-dock.pid")
# Pinned to start with: the first of each group that's installed
DEFAULT_PINS = (
    ("firefox_firefox.desktop", "firefox.desktop", "google-chrome.desktop", "chromium_chromium.desktop", "brave-browser.desktop"),
    ("Alacritty.desktop", "alacritty.desktop", "org.gnome.Terminal.desktop"),
    ("org.gnome.Nautilus.desktop", "nautilus.desktop"),
    ("code.desktop", "code_code.desktop"),
    ("spotify_spotify.desktop", "spotify.desktop"),
    ("notion-snap-reborn_notion-snap-reborn.desktop", "notion-app.desktop"),
)


def load_dock_config():
    try:
        with open(CONFIG) as f:
            data = json.load(f)
            if isinstance(data, dict):
                return data
    except (OSError, ValueError):
        pass
    return {}


def load_pins():
    pins = load_dock_config().get("pinned")
    if isinstance(pins, list):
        return [p for p in pins if isinstance(p, str)]
    return None


def save_pins(pins):
    data = load_dock_config()
    data["pinned"] = pins
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG + ".tmp", "w") as f:
        json.dump(data, f, indent=1)
    os.replace(CONFIG + ".tmp", CONFIG)


def save_autohide(on):
    data = load_dock_config()
    data["autohide"] = bool(on)
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG + ".tmp", "w") as f:
        json.dump(data, f, indent=1)
    os.replace(CONFIG + ".tmp", CONFIG)


def poke():
    """Tell a running dock to read its pins again."""
    try:
        with open(PIDFILE) as f:
            os.kill(int(f.read().strip()), signal.SIGUSR1)
    except (OSError, ValueError):
        pass


def poke_layout():
    """Tell a running dock its workspace layout or autohide setting changed."""
    try:
        with open(PIDFILE) as f:
            os.kill(int(f.read().strip()), signal.SIGUSR2)
    except (OSError, ValueError):
        pass


def cli(args):
    pins = load_pins()
    if pins is None:
        pins = default_pins()
    if args[0] == "pinned":
        print("\n".join(pins))
    elif args[0] == "autohide":
        if len(args) == 1:
            print("on" if load_dock_config().get("autohide") is True else "off")
        elif len(args) == 2 and args[1] in ("on", "off"):
            save_autohide(args[1] == "on")
            poke_layout()
        else:
            print(__doc__.strip(), file=sys.stderr)
            sys.exit(1)
    elif args[0] in ("pin", "unpin") and len(args) == 2:
        app = args[1] if args[1].endswith(".desktop") else args[1] + ".desktop"
        pins = [p for p in pins if p != app] + ([app] if args[0] == "pin" else [])
        save_pins(pins)
        poke()
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(1)


def default_pins():
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
        have = {a.get_id() for a in Gio.AppInfo.get_all()}
    except Exception:
        return []
    return [next(c for c in group if c in have) for group in DEFAULT_PINS if any(c in have for c in group)]


if len(sys.argv) > 1:
    cli(sys.argv[1:])
    sys.exit(0)

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell  # noqa: E402

ICON, INSET, GAP = 36, 6, 3
SLOT = ICON + INSET * 2
HOVER = 1.15
# Visible strip left on screen while the dock is tucked away. The window itself
# stays full height; a short surface is what Hyprland stops hitting with the
# pointer after the monitor is reconfigured at login.
HOTSPOT = 12


def hyprctl(*args):
    try:
        p = subprocess.run(("hyprctl",) + args, capture_output=True, text=True, timeout=5)
        return p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def hypr_json(what):
    try:
        return json.loads(hyprctl("-j", what) or "null")
    except ValueError:
        return None


def theme_colors():
    colors = {"background": "#1a1b26", "foreground": "#a9b1d6", "accent": "#7aa2f7", "muted": "#414868",
              "selection": "#292e42"}
    try:
        import re
        with open(os.path.join(HOME, ".config", "nameplate", "colors.toml")) as f:
            for line in f:
                m = re.match(r'\s*(\w+)\s*=\s*"([^"]*)"', line)
                if m:
                    colors[m.group(1)] = m.group(2)
    except OSError:
        pass
    return colors


class Apps:
    """Installed apps, and which one a window belongs to."""

    def __init__(self):
        self.reload()

    def reload(self):
        self.all = {a.get_id(): a for a in Gio.AppInfo.get_all() if a.get_id()}
        self.by_class = {}
        for app_id, a in self.all.items():
            keys = {app_id[:-8].lower(), app_id[:-8].split("_")[-1].lower(), app_id[:-8].split(".")[-1].lower()}
            wm = a.get_startup_wm_class() if hasattr(a, "get_startup_wm_class") else None
            if wm:
                keys.add(wm.lower())
            exe = a.get_executable()
            if exe:
                keys.add(os.path.basename(exe).lower())
            for k in keys:
                if k and (k not in self.by_class or a.should_show()):
                    self.by_class[k] = app_id

    def for_window(self, client):
        for name in (client.get("class"), client.get("initialClass")):
            if not name:
                continue
            for key in (name.lower(), name.lower().split(".")[-1], name.lower().replace(" ", "-")):
                if key in self.by_class:
                    return self.by_class[key]
        return None


class Dock:
    def __init__(self):
        self.apps = Apps()
        self.pins = load_pins()
        if self.pins is None:
            self.pins = default_pins()
            save_pins(self.pins)
        self.windows = {}          # app id -> [clients] on a normal workspace
        self.minimized = {}        # app id -> [clients] waiting in the dock
        self.all_windows = {}      # both, for the icons
        self.unknown = []          # windows with no app found: [(class, clients)]
        self.active = None         # address of the focused window
        self.seq = 0               # refresh answers: only the latest one counts
        self.revealed = False
        self.floating = False      # the active workspace's layout is floating
        self.mode = "dwindle"
        self.workspace_id = None
        self.fs_mode = 0           # 0 none, 1 maximized, 2+ fullscreen
        self.fullscreen = False
        self.autohide = load_dock_config().get("autohide") is True
        self.menu_open = False
        self.order = []            # session order from dragging icons
        self.shown_keys = []
        self.hide_timer = None
        self.cycle = {}
        self.margin = None
        self.seen_h = None
        self.height = SLOT + GAP + HOTSPOT
        self.monitor_sig = None
        self.rebuilt_at = 0
        self.colors = theme_colors()
        self.css()
        # display restore runs in the same login burst and reconfigures the
        # monitor. Mapping during that leaves a surface that never sees the
        # pointer again, so the dock stays hidden until it is restarted.
        self.wait_until_settled()
        self.build()
        self.refresh_now()
        self.win.show_all()
        self.rebuilt_at = time.time()
        threading.Thread(target=self.events, daemon=True).start()
        GLib.timeout_add(3000, self.watch)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.reload)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, self.reload_layout)

    def css(self):
        c = self.colors
        css = Gtk.CssProvider()
        css.load_from_data(("""
window.np-dock { background-color: transparent; }
.np-dock .np-hot { background-color: rgba(0,0,0,0.01); }
.np-dock button { background-image: none; background-color: transparent; border: none; box-shadow: none;
  padding: 0; margin: 0; min-width: 0; min-height: 0; outline: none; }
.np-dock image { -gtk-icon-shadow: 0 2px 6px rgba(0,0,0,0.55); }
.np-dock .np-dot { background-color: %s; min-width: 4px; min-height: 4px; border-radius: 2px; }
.np-dock .np-dot.np-focused { background-color: %s; min-width: 12px; }
.np-dock menu, .np-dock .menu { background-color: %s; border: 2px solid %s; padding: 4px; }
.np-dock menuitem { color: %s; padding: 6px 12px; font-family: "JetBrainsMono Nerd Font", monospace; }
.np-dock menuitem:hover { background-color: %s; }
""" % (c["foreground"], c["accent"], c["background"], c["accent"], c["foreground"], c["selection"])).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER)

    def build(self):
        w = self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        w.get_style_context().add_class("np-dock")
        # Never zero-size: a collapsed window is mapped as a few pixels and
        # the compositor then ignores it until the process is restarted.
        w.set_size_request(240, self.height)
        visual = w.get_screen().get_rgba_visual()
        if visual:
            w.set_visual(visual)
        GtkLayerShell.init_for_window(w)
        GtkLayerShell.set_namespace(w, "nameplate-dock")
        GtkLayerShell.set_layer(w, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_anchor(w, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_exclusive_zone(w, 0)          # windows keep the whole screen
        GtkLayerShell.set_keyboard_mode(w, GtkLayerShell.KeyboardMode.NONE)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        # Sliding the whole window down (negative bottom margin) hides the
        # icons below the screen and leaves this strip on the edge. It has to
        # be the top of the window: that is the part that stays on screen.
        self.edge = Gtk.EventBox()
        self.edge.set_size_request(-1, HOTSPOT)
        self.edge.get_style_context().add_class("np-hot")
        self.edge.connect("enter-notify-event", lambda *_: self.reveal(True))
        outer.pack_start(self.edge, False, False, 0)
        self.row = Gtk.Box(spacing=0)
        self.row.set_margin_bottom(GAP)
        outer.pack_start(self.row, False, False, 0)
        hover = Gtk.EventBox()
        hover.add(outer)
        hover.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        hover.connect("enter-notify-event", lambda *_: self.reveal(True))
        hover.connect("leave-notify-event", self.left)
        w.add(hover)
        w.connect("size-allocate", self.on_size)
        self.seen_h = None
        self.margin = None

    # -- the slots
    def slot(self, child, on_click, on_menu=None, tip=None, mark=None):
        b = Gtk.Button()
        b.set_size_request(SLOT, SLOT)
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        holder.set_size_request(SLOT, SLOT)
        icon_box = Gtk.Box()
        icon_box.set_size_request(SLOT, SLOT - 4 if mark else SLOT)
        icon_box.set_center_widget(child)
        holder.pack_start(icon_box, False, False, 0)
        if mark:   # running apps get a dot, the focused one a wider accent bar
            marks = Gtk.Box()
            marks.set_halign(Gtk.Align.CENTER)
            marks.set_size_request(-1, 4)
            dot = Gtk.Box()
            dot.get_style_context().add_class("np-dot")
            if mark == "focused":
                dot.get_style_context().add_class("np-focused")
            marks.pack_start(dot, False, False, 0)
            holder.pack_start(marks, False, False, 0)
        b.add(holder)
        if tip:
            b.set_tooltip_text(tip)

        def clicked(*_):
            if getattr(b, "_dragging", False):
                return      # a drag ended here; it was not a click
            on_click()

        b.connect("clicked", clicked)
        if on_menu:
            def press(_b, event):
                if event.button == 3:
                    on_menu(event)
                    return True
                return False
            b.connect("button-press-event", press)
        return b

    def make_draggable(self, button, app_id):
        """Drag an icon along the dock to reorder it. A plain click still
        activates the app: GTK only starts the drag after the pointer has
        moved past its threshold, and a drag that ends on a slot is not
        reported as a click on the source (see the _dragging guard)."""
        targets = [Gtk.TargetEntry.new("application/x-nameplate-dock", Gtk.TargetFlags.SAME_APP, 0)]
        button.drag_source_set(Gdk.ModifierType.BUTTON1_MASK, targets, Gdk.DragAction.MOVE)
        button.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.MOVE)
        button.connect("drag-begin", lambda *_: setattr(button, "_dragging", True))

        def end(*_):
            # Clear after any release that follows the drag, so that release
            # is not mistaken for a click; a later real click works as usual.
            GLib.timeout_add(300, lambda: setattr(button, "_dragging", False) or False)

        button.connect("drag-end", end)

        def get(_b, _ctx, selection, _info, _time):
            selection.set(selection.get_target(), 8, app_id.encode())

        def received(_b, _ctx, _x, _y, selection, _info, _time):
            key = selection.get_data().decode(errors="ignore")
            if key:
                # After the drop: rebuilding the row now would destroy the
                # drag's own buttons underneath it.
                GLib.idle_add(lambda: self.place(key, app_id) or False)

        button.connect("drag-data-get", get)
        button.connect("drag-data-received", received)

    def place(self, key, target):
        """Put key where target is. Session order, except pins, which save."""
        keys = list(self.shown_keys)
        if key not in keys or target not in keys or key == target:
            return
        keys.remove(key)
        keys.insert(keys.index(target), key)
        self.order = keys
        pins = [k for k in keys if k in self.pins]
        if set(pins) == set(self.pins) and pins != self.pins:
            self.pins = pins
            save_pins(pins)
        self.fill()

    def icon(self, app):
        theme = Gtk.IconTheme.get_default()
        gicon = app.get_icon() if app else None
        sizes = {}
        for size in (ICON, round(ICON * HOVER)):
            pix = None
            try:
                found = theme.lookup_by_gicon(gicon, size, Gtk.IconLookupFlags.FORCE_SIZE) if gicon else None
                pix = found.load_icon() if found else None
            except GLib.Error:
                pix = None
            if pix is None:
                for fallback in ("application-x-executable", "application-default-icon", "image-missing"):
                    try:
                        pix = theme.load_icon(fallback, size, Gtk.IconLookupFlags.FORCE_SIZE)
                    except GLib.Error:
                        pix = None
                    if pix is not None:
                        break
            sizes[size] = pix
        if sizes[ICON] is not None:
            img = Gtk.Image.new_from_pixbuf(sizes[ICON])
        else:   # no artwork at all (a bare-bones icon theme): an empty image, never a NULL pixbuf
            img = Gtk.Image()
        img.set_size_request(round(ICON * HOVER), round(ICON * HOVER))   # growing on hover doesn't shift anything
        img.set_valign(Gtk.Align.CENTER)
        img.set_halign(Gtk.Align.CENTER)
        img.sizes = sizes
        return img

    def grow(self, button, img, big):
        pix = img.sizes.get(round(ICON * HOVER) if big else ICON)
        if pix is not None:
            img.set_from_pixbuf(pix)

    def grid_icon(self):
        """Omarchy's app grid mark: nine small squares."""
        area = Gtk.DrawingArea()
        area.set_size_request(ICON, ICON)
        area.set_valign(Gtk.Align.CENTER)       # same spot as the app icons, not the top of the slot
        area.set_halign(Gtk.Align.CENTER)
        c = self.colors["foreground"].lstrip("#")
        rgb = tuple(int(c[i:i + 2], 16) / 255 for i in (0, 2, 4))

        def draw(_a, cr):
            # Omarchy's mark: nine rounded squares filling most of the icon.
            sq = round(ICON * 0.22)
            gap = round(ICON * 0.1)
            span = 3 * sq + 2 * gap
            off = (ICON - span) / 2
            radius = max(1, round(sq * 0.2))
            cr.set_source_rgb(*rgb)
            for row in range(3):
                for col in range(3):
                    x = off + col * (sq + gap)
                    y = off + row * (sq + gap)
                    cr.new_sub_path()
                    cr.arc(x + sq - radius, y + radius, radius, -1.5708, 0)
                    cr.arc(x + sq - radius, y + sq - radius, radius, 0, 1.5708)
                    cr.arc(x + radius, y + sq - radius, radius, 1.5708, 3.1416)
                    cr.arc(x + radius, y + radius, radius, 3.1416, 4.7124)
                    cr.close_path()
                    cr.fill()
            return False
        area.connect("draw", draw)
        return area

    def fill(self):
        for child in self.row.get_children():
            self.row.remove(child)
        grid = self.slot(self.grid_icon(), lambda: subprocess.Popen([os.path.join(BIN, "panel"), "apps"]),
                         on_menu=lambda e: self.dock_menu(e), tip="All apps")
        self.row.pack_start(grid, False, False, 0)
        shown = [p for p in self.pins if p in self.apps.all]
        shown += [a for a in self.all_windows if a not in shown]
        if self.order:
            rank = {app_id: i for i, app_id in enumerate(self.order)}
            shown.sort(key=lambda a: rank.get(a, len(rank)))
        self.shown_keys = list(shown)
        for app_id in shown:
            try:
                app = self.apps.all.get(app_id)
                clients = self.all_windows.get(app_id, [])
                img = self.icon(app)
                focused = any(c.get("address") == self.active and not c.get("_minimized")
                              for c in clients)
                b = self.slot(img, lambda a=app_id: self.activate(a),
                              on_menu=lambda e, a=app_id: self.menu(a, e),
                              tip=app.get_display_name() if app else app_id,
                              mark=("focused" if focused else "open") if clients else None)
                self.make_draggable(b, app_id)
                b.connect("enter-notify-event", lambda btn, _e, i=img: self.grow(btn, i, True))
                b.connect("leave-notify-event", lambda btn, _e, i=img: self.grow(btn, i, False))
                self.row.pack_start(b, False, False, 0)
            except Exception:
                continue    # one broken app must not blank the whole dock
        self.row.show_all()

    # -- state from Hyprland
    @staticmethod
    def workspace_mode(ws):
        """The active workspace's layout, from bin/workspace-layout's files,
        falling back to the tiled layout Hyprland reports."""
        wid = ws.get("id")
        state = os.path.join(os.environ.get("XDG_STATE_HOME") or
                             os.path.join(HOME, ".local", "state"),
                             "nameplate", "workspace-layouts", str(wid))
        try:
            with open(state) as f:
                mode = f.read().strip()
            if mode in ("dwindle", "scrolling", "floating"):
                return mode
        except OSError:
            pass
        return ws.get("tiledLayout") or "dwindle"

    def refresh(self):
        """Re-read Hyprland in a worker thread, then update the UI on the main
        loop. hyprctl can stall for seconds (its own timeouts), so running it
        here used to freeze the whole dock, hover handling included, and make
        it look dead until the next event. Stale answers are dropped."""
        self.seq = getattr(self, "seq", 0) + 1
        seq = self.seq

        def work():
            try:
                clients = hypr_json("clients")
                ws = hypr_json("activeworkspace")
                active = hypr_json("activewindow")
            except Exception:
                return
            GLib.idle_add(lambda: self.apply_state(seq, clients, ws, active))

        threading.Thread(target=work, daemon=True).start()
        return False

    def refresh_now(self):
        """One synchronous read, used before the window is mapped so the first
        frame is already shown or tucked away. A failed read leaves the dock
        showing: an empty desktop at login must not come up hidden."""
        self.seq += 1
        try:
            clients = hypr_json("clients")
            ws = hypr_json("activeworkspace")
            active = hypr_json("activewindow")
        except Exception:
            clients = ws = active = None
        self.apply_state(self.seq, clients, ws, active)

    def apply_state(self, seq, clients, ws, active):
        if seq != self.seq:
            return False
        # Hyprland didn't answer (common in the first moments of login).
        # Keep the last decision instead of treating that as "no windows",
        # which would pop the dock up over a full screen, or as "windows",
        # which would hide it on an empty desktop.
        if not isinstance(ws, dict) or "id" not in ws:
            if self.row.get_children() == []:
                self.fill()
                self.update()
            return False
        if not isinstance(active, dict):
            active = {}
        if not isinstance(clients, list):
            clients = []
        self.active = active.get("address")
        windows, minimized = {}, {}
        wid = ws.get("id")
        self.workspace_id = wid if isinstance(wid, int) else None
        self.mode = self.workspace_mode(ws)
        self.floating = self.mode == "floating"
        fs_mode = 0
        for c in clients:
            if not isinstance(c, dict):
                continue
            if not c.get("mapped", True) or c.get("hidden"):
                continue
            w = c.get("workspace") or {}
            if not isinstance(w, dict):
                continue
            app_id = self.apps.for_window(c)
            if not app_id:
                continue
            if w.get("name") == "special:minimized":
                held = dict(c)
                held["_minimized"] = True
                minimized.setdefault(app_id, []).append(held)
                continue
            if w.get("id", 1) < 0:
                continue
            if wid is None or w.get("id") == wid:
                try:
                    fs_mode = max(fs_mode, int(c.get("fullscreen") or 0))
                except (TypeError, ValueError):
                    pass
            windows.setdefault(app_id, []).append(c)
        self.windows = windows
        self.minimized = minimized
        self.all_windows = {a: list(cs) for a, cs in windows.items()}
        for app_id, cs in minimized.items():
            self.all_windows.setdefault(app_id, []).extend(cs)
        self.fs_mode = fs_mode
        self.fullscreen = fs_mode >= 2
        # Title ticks (a spinning terminal title) emit activewindow over and
        # over. Rebuilding every icon each time pegs a core and the dock
        # stops noticing the pointer until the titles go quiet.
        sig = (
            self.active, self.mode, self.floating, self.fs_mode,
            tuple(sorted(
                (app_id, tuple(sorted((c.get("address") or "") for c in clients)))
                for app_id, clients in self.all_windows.items()
            )),
            tuple(sorted(
                (c.get("address") or "", next((t for t in c.get("tags") or []
                                                if t.startswith("nameplate-minimized-from-")), ""))
                for cs in minimized.values() for c in cs
            )),
        )
        if sig == getattr(self, "state_sig", None):
            return False
        self.state_sig = sig
        self.fill()
        self.update()
        return False

    def update(self):
        """Omarchy's show model: the dock lives on floating workspaces. It
        stays put there unless autohide is on or a window is maximized, when
        it tucks to the edge and the hotspot brings it back; a fullscreen
        window hides it outright. The surface stays full height either way,
        so the compositor keeps delivering pointer events to it."""
        if self.win is None:
            return False
        visible = self.floating and self.fs_mode < 2
        tucked = visible and (self.autohide or self.fs_mode == 1) \
            and not (self.revealed or self.menu_open)
        height = self.win.get_allocated_height()
        if height < HOTSPOT + 20:
            height = self.height
        if not visible:
            margin = -(height + 80)
        elif tucked:
            margin = -(height - HOTSPOT)
        else:
            margin = 0
        if margin != self.margin:
            self.margin = margin
            GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.BOTTOM, margin)
        return False

    def on_size(self, *_):
        h = self.win.get_allocated_height()
        w = self.win.get_allocated_width()
        if h < HOTSPOT + 10 or h == self.seen_h:
            return
        self.seen_h = h
        self.height = h
        gdk = self.win.get_window()
        if gdk is not None and w > 1:
            # A fully transparent strip can be given an empty input region.
            # Claim the whole window so the hotspot keeps receiving the pointer.
            try:
                gdk.input_shape_combine_region(cairo.Region(cairo.RectangleInt(0, 0, w, h)), 0, 0)
            except Exception:
                pass
        # The first margin was guessed from the size request. Now that the
        # real height is known, slide to the right place.
        self.margin = None
        GLib.idle_add(self.update)

    def wait_until_settled(self):
        deadline = time.time() + 3
        last = None
        stable = 0
        while time.time() < deadline and stable < 2:
            sig = self.monitor_fingerprint()
            ws = hypr_json("activeworkspace")
            ready = isinstance(ws, dict) and ws.get("id") is not None
            if sig and sig == last and ready:
                stable += 1
            else:
                stable = 0
                last = sig
            if stable < 2:
                time.sleep(0.35)
        self.monitor_sig = last

    def monitor_fingerprint(self):
        mons = hypr_json("monitors")
        if not isinstance(mons, list):
            return None
        return tuple(sorted(
            (m.get("name"), m.get("width"), m.get("height"), str(m.get("scale")), m.get("x"), m.get("y"))
            for m in mons if isinstance(m, dict) and not m.get("disabled")
        ))

    def our_layer(self):
        """This dock's layer surface, None if it is gone, or 'unknown' when
        hyprctl itself failed (that must not look like a missing dock)."""
        data = hypr_json("layers")
        if data is None:
            return "unknown"
        found = {}

        def walk(obj):
            if isinstance(obj, dict):
                if obj.get("namespace") == "nameplate-dock" and obj.get("pid") == os.getpid():
                    found.update(obj)
                    return
                for value in obj.values():
                    walk(value)
            elif isinstance(obj, list):
                for item in obj:
                    walk(item)

        walk(data)
        return found or None

    def rebuild(self):
        """New layer surface. The old one is what stays deaf to the pointer
        after the monitor is reconfigured at login."""
        self.seq += 1
        self.rebuilt_at = time.time()
        if self.win is not None:
            self.win.destroy()
            self.win = None
        self.margin = None
        self.seen_h = None
        self.build()
        self.fill()
        self.update()
        self.win.show_all()

    def watch(self):
        def work():
            sig = self.monitor_fingerprint()
            layer = self.our_layer()
            GLib.idle_add(self.apply_watch, sig, layer)

        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_watch(self, sig, layer):
        if sig is None or layer == "unknown":
            return False
        if time.time() - self.rebuilt_at < 2:
            if self.monitor_sig is None:
                self.monitor_sig = sig
            return False
        gtk_h = self.win.get_allocated_height() if self.win is not None else 0
        layer_h = layer.get("h", 0) if isinstance(layer, dict) else 0
        changed = self.monitor_sig is not None and sig != self.monitor_sig
        missing = layer is None
        # Compositor still has the tiny surface from before a slide, so the
        # hotspot can never be hit. Build a new one.
        short = gtk_h >= 40 and 0 < layer_h < gtk_h - 15
        if changed or missing or short:
            self.monitor_sig = sig
            self.rebuild()
        return False

    def reveal(self, on):
        if self.hide_timer:
            GLib.source_remove(self.hide_timer)
            self.hide_timer = None
        self.revealed = on
        self.update()
        return False

    def left(self, _w, event):
        if event.detail == Gdk.NotifyType.INFERIOR:     # still over the dock, just onto an icon
            return False
        if self.hide_timer:
            GLib.source_remove(self.hide_timer)
        self.hide_timer = GLib.timeout_add(350, lambda: self.reveal(False))
        return False

    def events(self):
        """Hyprland's event socket: refresh when windows open, close or move."""
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr", sig, ".socket2.sock")
        wanted = ("openwindow", "closewindow", "movewindow", "workspace", "focusedmon",
                  "activewindow", "fullscreen", "changefloatingmode",
                  "monitoradded", "monitorremoved", "configreloaded")
        while True:
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(path)
                # Events from before this connect are gone. Re-read now, or a
                # window that closed during login stays counted and the dock
                # hides on an empty desktop for the rest of the session.
                GLib.idle_add(self.refresh)
                buf = b""
                pending = [False]
                while True:
                    data = s.recv(4096)
                    if not data:
                        break
                    buf += data
                    *lines, buf = buf.split(b"\n")
                    for line in lines:
                        name = line.split(b">>")[0].decode(errors="ignore")
                        if name.startswith(("monitoradded", "monitorremoved", "configreloaded")):
                            # watch() returns True so a timeout keeps it. An idle
                            # source must not, or it would run flat out.
                            GLib.idle_add(lambda: self.watch() and False)
                        if not pending[0] and any(name.startswith(w) for w in wanted):
                            pending[0] = True

                            def go():
                                pending[0] = False
                                return self.refresh()
                            GLib.timeout_add(150, go)  # one refresh for a burst of events
                            break
            except OSError:
                pass
            time.sleep(2)

    # -- actions
    def restore(self, client):
        """Bring a minimized window back to the workspace it came from."""
        back = self.workspace_id
        for tag in client.get("tags") or []:
            if tag.startswith("nameplate-minimized-from-"):
                try:
                    back = int(tag.rsplit("-", 1)[1])
                except (ValueError, IndexError):
                    pass
        address = client.get("address")
        if not address or not isinstance(back, int) or back < 1:
            return
        target = 'window = "address:%s"' % address
        hyprctl("dispatch", 'hl.dsp.window.move({ workspace = "%d", follow = false, %s })' % (back, target))
        hyprctl("dispatch", 'hl.dsp.focus({ window = "address:%s" })' % address)

    def activate(self, app_id):
        clients = self.all_windows.get(app_id)
        if not clients:
            app = self.apps.all.get(app_id)
            if app:
                subprocess.Popen(["gtk-launch", app_id], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        held = [c for c in clients if c.get("_minimized")]
        clients = [c for c in clients if not c.get("_minimized")]
        if not clients:
            if held:
                self.restore(held[0])
            return
        clients = sorted(clients, key=lambda c: c.get("focusHistoryID", 0))
        if any(c.get("address") == self.active for c in clients) and len(clients) > 1:
            i = (self.cycle.get(app_id, 0) + 1) % len(clients)   # already there: the next window
        else:
            i = 0
        self.cycle[app_id] = i
        hyprctl("dispatch", 'hl.dsp.focus({ window = "address:%s" })' % clients[i]["address"])

    def dock_menu(self, event):
        """Right-click the apps button: the dock's own settings."""
        m = Gtk.Menu()
        m.get_style_context().add_class("np-dock")
        item = Gtk.CheckMenuItem(label="Auto-hide dock")
        item.set_active(self.autohide)
        item.connect("activate", lambda *_: self.toggle_autohide(item.get_active()))
        m.append(item)
        m.show_all()
        m.attach_to_widget(self.row, None)
        self.menu_open = True
        self.reveal(True)
        m.connect("deactivate", lambda *_: self.menu_closed())
        m.popup_at_pointer(event)

    def toggle_autohide(self, on):
        self.autohide = bool(on)
        save_autohide(on)
        self.update()

    def menu(self, app_id, event):
        m = Gtk.Menu()
        m.get_style_context().add_class("np-dock")
        app = self.apps.all.get(app_id)
        pinned = app_id in self.pins

        def item(text, fn):
            it = Gtk.MenuItem(label=text)
            it.connect("activate", lambda *_: fn())
            m.append(it)
        if app:
            item("New window", lambda: subprocess.Popen(["gtk-launch", app_id], start_new_session=True,
                                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        item("Unpin from dock" if pinned else "Pin to dock", lambda: self.toggle_pin(app_id))
        if self.all_windows.get(app_id):
            n = len(self.all_windows[app_id])
            item("Quit" if n == 1 else "Quit all %d windows" % n, lambda: self.quit_app(app_id))
        m.show_all()
        m.attach_to_widget(self.row, None)
        self.menu_open = True
        self.reveal(True)
        m.connect("deactivate", lambda *_: self.menu_closed())
        m.popup_at_pointer(event)

    def pointer_inside(self):
        """Is the pointer still over the dock (e.g. its menu just closed)?"""
        try:
            seat = Gdk.Display.get_default().get_default_seat()
            _screen, x, y = seat.get_pointer().get_position()
            ox, oy = self.win.get_position()
            w, h = self.win.get_size()
            return ox <= x < ox + w and oy <= y < oy + h
        except Exception:
            return True

    def menu_closed(self):
        self.menu_open = False
        if self.pointer_inside():
            self.reveal(True)    # still hovering: stay up, and drop any pending hide
        else:
            self.left(None, type("E", (), {"detail": None})())

    def toggle_pin(self, app_id):
        self.pins = [p for p in self.pins if p != app_id] + ([] if app_id in self.pins else [app_id])
        save_pins(self.pins)
        self.fill()

    def quit_app(self, app_id):
        for c in self.all_windows.get(app_id, []):
            hyprctl("dispatch", 'hl.dsp.window.close({ window = "address:%s" })' % c["address"])

    def reload(self):
        self.pins = load_pins() or []
        self.apps.reload()
        self.refresh()
        return True

    def reload_layout(self):
        self.autohide = load_dock_config().get("autohide") is True
        self.refresh()
        return True


def main():
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"),
                         "nameplate", "no-dock")
    if os.path.exists(state):             # turned off in Menu -> Appearance (bin/toggle dock)
        sys.exit(0)
    if not GtkLayerShell.is_supported():
        sys.exit("dock: needs a layer-shell desktop (Hyprland)")
    try:                                   # one dock at a time
        with open(PIDFILE) as f:
            other = int(f.read().strip())
        with open("/proc/%d/cmdline" % other, "rb") as f:
            running = b"bin/dock" in f.read()
        if other != os.getpid() and running:
            sys.exit(0)
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    Dock()
    # New apps installed: pick them up
    monitor = Gio.AppInfoMonitor.get()
    monitor.connect("changed", lambda *_: poke())
    Gtk.main()


if __name__ == "__main__":
    main()

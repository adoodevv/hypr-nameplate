#!/usr/bin/python3
"""Cycle or report a workspace's layout: dwindle, scrolling, or floating.

    workspace-layout           cycle the active workspace (SUPER + L)
    workspace-layout back      cycle the other way (SUPER + ALT + L)
    workspace-layout current [WORKSPACE]
    workspace-layout set MODE  set the active workspace's layout

Floating is a mode of the workspace, not a Hyprland layout: the Lua in
hyprland.lua floats the windows and tags the ones it floated, so cycling away
tiles exactly those again. The choice is kept in
~/.local/state/nameplate/workspace-layouts/, one file per workspace.
"""
import json
import os
import signal
import subprocess
import sys

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"),
                     "nameplate", "workspace-layouts")
DOCK_PID = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "nameplate-dock.pid")
MODES = ("dwindle", "scrolling", "floating")
NAMES = {"dwindle": "Tiling", "scrolling": "Scrolling", "floating": "Floating"}


def hypr_json(*args):
    try:
        out = subprocess.run(["hyprctl", "-j", *args], capture_output=True,
                             text=True, timeout=5).stdout
        return json.loads(out or "null")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def saved_mode(workspace):
    try:
        with open(os.path.join(STATE, str(workspace))) as f:
            mode = f.read().strip()
        return mode if mode in MODES else None
    except OSError:
        return None


def current(workspace=None):
    if workspace is None:
        active = hypr_json("activeworkspace") or {}
        workspace = active.get("id")
        tiled = active.get("tiledLayout")
    else:
        tiled = None
        for ws in hypr_json("workspaces") or []:
            if isinstance(ws, dict) and str(ws.get("id")) == str(workspace):
                tiled = ws.get("tiledLayout")
                break
    try:
        workspace = int(workspace)
    except (TypeError, ValueError):
        return "dwindle"
    if workspace < 1:
        return "dwindle"
    return saved_mode(workspace) or tiled or "dwindle"


def poke_dock():
    try:
        with open(DOCK_PID) as f:
            os.kill(int(f.read().strip()), signal.SIGUSR2)
    except (OSError, ValueError):
        pass


def notify(mode):
    text = f"Workspace layout: {NAMES[mode]}"
    state = os.path.join(STATE, "notification")
    last = ""
    try:
        with open(state) as f:
            last = f.read().strip()
    except OSError:
        pass
    try:
        out = subprocess.run(
            ["notify-send", "-a", "Workspace", "-t", "1500", "-p",
             *(["-r", last] if last.isdigit() else []), text],
            capture_output=True, text=True, timeout=5).stdout.strip()
        if out.isdigit():
            os.makedirs(STATE, exist_ok=True)
            with open(state, "w") as f:
                f.write(out + "\n")
    except (OSError, subprocess.TimeoutExpired):
        pass


def apply_mode(workspace, mode):
    expr = f'np_workspace_mode({workspace}, "{mode}")'
    try:
        result = subprocess.run(["hyprctl", "eval", expr], capture_output=True,
                                text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0 or "error" in (result.stdout + result.stderr).lower():
        return False
    os.makedirs(STATE, exist_ok=True)
    path = os.path.join(STATE, str(workspace))
    if mode == "dwindle":
        try:
            os.unlink(path)
        except OSError:
            pass
    else:
        with open(path, "w") as f:
            f.write(mode + "\n")
    poke_dock()
    return True


def cycle(back=False):
    active = hypr_json("activeworkspace") or {}
    workspace = active.get("id")
    if not isinstance(workspace, int) or workspace < 1:
        return
    now = current(workspace)
    step = -1 if back else 1
    mode = MODES[(MODES.index(now) + step) % len(MODES)] if now in MODES else "dwindle"
    if apply_mode(workspace, mode):
        notify(mode)
    else:
        try:
            subprocess.run(["notify-send", "-a", "Workspace", "-t", "2500",
                            "Workspace layout needs a Hyprland reload"],
                           capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass


def main():
    args = sys.argv[1:]
    if not args:
        cycle()
    elif args == ["back"]:
        cycle(back=True)
    elif args[0] == "current" and len(args) <= 2:
        print(current(args[1] if len(args) == 2 else None))
    elif args[0] == "set" and len(args) == 3 and args[2] in MODES:
        active = hypr_json("activeworkspace") or {}
        workspace = active.get("id")
        if isinstance(workspace, int) and workspace >= 1:
            apply_mode(workspace, args[2])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()

#!/bin/bash
# Bluetooth dropdown (click the Bluetooth icon in the bar). Uses bluetoothctl.
pkill -x fuzzel && exit 0   # clicking the icon again closes the menu
bin="$HOME/.config/nameplate/bin"

I_BT='󰂯'; I_OFF='󰂲'; I_CON='󰂱'; I_PLUS='󰐕'; I_COG='󰒓'

notify() { notify-send -a "Bluetooth" "$@"; }
settings() { XDG_CURRENT_DESKTOP=GNOME setsid -f gnome-control-center bluetooth >/dev/null 2>&1; }

if ! bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
  choice=$(printf '%s\n' "$I_BT  Turn Bluetooth on" "$I_COG  Bluetooth settings" | "$bin/dropdown" "bluetooth")
  case "$choice" in
    *"Turn Bluetooth on")
      rfkill unblock bluetooth 2>/dev/null
      sleep 0.5
      bluetoothctl power on >/dev/null && notify "Bluetooth on" || notify "Couldn't turn Bluetooth on" ;;
    *"Bluetooth settings") settings ;;
  esac
  exit 0
fi

menu=()
declare -A mac_of
while read -r _ mac name; do
  [[ -z $mac ]] && continue
  if bluetoothctl info "$mac" 2>/dev/null | grep -q 'Connected: yes'; then
    line="$I_CON  $name  (connected)"
  else
    line="$I_BT  $name"
  fi
  menu+=("$line")
  mac_of["$line"]="$mac"
done < <(bluetoothctl devices Paired 2>/dev/null | grep '^Device ')

extras=("$I_PLUS  Pair a new device" "$I_OFF  Turn Bluetooth off" "$I_COG  Bluetooth settings")

choice=$(printf '%s\n' "${menu[@]}" "${extras[@]}" | "$bin/dropdown" "bluetooth")
[[ -z $choice ]] && exit 0

case "$choice" in
  *"Pair a new device"|*"Bluetooth settings") settings; exit 0 ;;
  *"Turn Bluetooth off") bluetoothctl power off >/dev/null && notify "Bluetooth off"; exit 0 ;;
esac

mac="${mac_of[$choice]:-}"
[[ -z $mac ]] && exit 0
name="${choice#*  }"; name="${name%  (connected)}"
if [[ $choice == *"(connected)" ]]; then
  bluetoothctl disconnect "$mac" >/dev/null && notify "Disconnected $name" || notify "Couldn't disconnect $name"
else
  notify "Connecting to $name…"
  if bluetoothctl --timeout 15 connect "$mac" 2>/dev/null | grep -q 'Connection successful'; then
    notify "Connected to $name"
  else
    notify "Couldn't connect to $name" "Is it switched on and nearby?"
  fi
fi
